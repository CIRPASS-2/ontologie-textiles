# Synthetic, non-normative link illustration, not a complete EPCIS payload.
# Assumes a qualifying product-facing inspection; OBSERVE / inspecting alone
# does not establish ProductEvent semantics. The three resources are distinct.
# Carrier mapping axioms belong to the unchanged full EVENT 1.0.0 source;
# they are not included in the bounded EVENT MIREOT imported by ASSESSMENT.
@prefix ex: <https://example.org/eu-dpp-textile/issue20-point2/> .
@prefix txtass: <https://w3id.org/eudpp/textile-assessment#> .
@prefix dpp: <https://w3id.org/eudpp#> .
@prefix epcis: <https://ref.gs1.org/epcis/> .

ex:inspection a txtass:AssessmentExecution ;
    txtass:isRepresentedByProductEvent ex:productEvent .

ex:productEvent a dpp:ProductEvent ;
    dpp:isRepresentedByCarrier ex:observation .

ex:observation a epcis:ObjectEvent ;
    epcis:action "OBSERVE" ;
    epcis:bizStep <https://ref.gs1.org/cbv/BizStep-inspecting> .
