# --- Origin Properties ---
eudpp:appliesToCountryOfOrigin a owl:ObjectProperty ;
  rdfs:label "applies to country of origin"@en ;
  rdfs:comment "Links a standard, a product passport, or something else to the country of origin of the product."@en ;
  rdfs:range eudpp:Country ;
  rdfs:isDefinedBy eudpp: .

