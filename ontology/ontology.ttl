# --- Product ---
eudpp:Product a owl:Class ;
  rdfs:label "Product"@en ;
  rdfs:comment "A type of product or commodity defined within the EUDPP thesaurus."@en ;
  rdfs:subClassOf skos:Concept , <http://schema.org/Product> ;
  rdfs:isDefinedBy eudpp: .

# --- Product Properties ---
eudpp:product a owl:ObjectProperty ;
  rdfs:label "product"@en ;
  rdfs:comment "Links the passport or standard to a specific product concept from the EUDPP thesaurus."@en ;
  rdfs:range eudpp:Product ;
  rdfs:isDefinedBy eudpp: .

