base <https://w3id.org/eudpp/>
prefix eudpp: <https://w3id.org/eudpp/>
prefix dct: <http://purl.org/dc/terms/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
construct {
  ?standard_sustainability_id_URL a eudpp:SustainabilityStandard;
    dct:title ?standard ;
    eudpp:appliesToCountryOfOriginStr ?origin_SPLIT_SEMI ;
    eudpp:appliesToCountryOfOriginCode ?origin_country_code_SPLIT_SEMI ;
    eudpp:appliesToCountryOfOrigin ?country_origin_country_code_SPLIT_SEMI_URL .
}
where {
    bind(iri(concat("standard/sustainability/",?id)) as ?standard_sustainability_id_URL)
    ?origin_SPLIT_SEMI apf:strSplit (?origin "; ?").
    ?origin_country_code_SPLIT_SEMI apf:strSplit (?origin_country_code "; ?").
    bind(iri(concat("country/",?origin_country_code_SPLIT_SEMI)) as ?country_origin_country_code_SPLIT_SEMI_URL)
}
