base <https://w3id.org/eudpp/>
prefix eudpp: <https://w3id.org/eudpp/>
prefix dct: <http://purl.org/dc/terms/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
construct {
  ?standard_sustainability_id_URL a eudpp:SustainabilityStandard;
      eudpp:product ?thesauri_product_products_det_products_urlfied_SPLIT_SEMI_URL ;
      eudpp:product ?thesauri_product_products_products_urlfied_SPLIT_SEMI_URL .}
where {
    bind(iri(concat("standard/sustainability/",?id)) as ?standard_sustainability_id_URL)
    ?det_products_urlfied_SPLIT_SEMI apf:strSplit (?det_products_urlfied "; ?").
    bind(iri(concat("thesauri/product/products/",?det_products_urlfied_SPLIT_SEMI)) as ?thesauri_product_products_det_products_urlfied_SPLIT_SEMI_URL)
    ?products_urlfied_SPLIT_SEMI apf:strSplit (?products_urlfied "; ?").
    bind(iri(concat("thesauri/product/products/",?products_urlfied_SPLIT_SEMI)) as ?thesauri_product_products_products_urlfied_SPLIT_SEMI_URL)
}
