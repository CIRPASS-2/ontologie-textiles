nonConversion = map_chr(nonConversion, ~ paste(.x, collapse = ";")),
supplyChain = map_chr(supplyChain, ~ paste(.x, collapse = ";")),
recogAndCerts = map_chr(recogAndCerts, ~ paste(.x, collapse = ";")),
sdgs = map_chr(sdgs, ~ paste(.x, collapse = ";")),
pillars = map_chr(pillars, ~ {
# Handle cases where there might be no pillar data (NULL or empty)
if (is.null(.x) || nrow(.x) == 0) {
return(NA_character_)
}
# 1. Get the 'parent' column: .x$parent
# 2. Find the unique values: unique()
# 3. Collapse them with "; ": paste()
paste(unique(.x$parent), collapse = "; ")
})
)
