<standard/sustainability/(id)> a eudpp:SustainabilityStandard;  
  eudpp:appliesToCountryOfDestinationStr "SPLIT_SEMI(destination)";
  eudpp:appliesToCountryOfDestinationCode "SPLIT_SEMI(destination_country_code)";
  eudpp:appliesToCountryOfDestination <country/SPLIT_SEMI(destination_country_code)>.