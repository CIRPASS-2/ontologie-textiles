  eudpp:valueChain <https://w3id.org/eudpp/thesauri/Value_Chain/Distribution>, <https://w3id.org/eudpp/thesauri/Value_Chain/Manufacturing>, <https://w3id.org/eudpp/thesauri/Value_Chain/Production> .

<https://w3id.org/eudpp/standard/sustainability/279> a eudpp:SustainabilityStandard ;
  dct:description "The International Association for Research and Testing in the Field of Textile and Leather Ecology (OEKO-TEX®) is a union of 17 independent textile research and test institutes in Europe and Japan and their worldwide representative offices.   OEKO-TEX® STeP stands for Sustainable Textile & Leather Production and is a modular certification system for production facilities in the textile and leather industry. The goal of STeP is to implement environmentally friendly production processes in the long term, to improve health and safety and to promote socially responsible working conditions at production sites. The target groups for STeP certification are textile and leather manufacturers as well as brands and retailers." ;
  dct:issued "1992"^^xsd:gYear ;
  dct:relation <https://www.oeko-tex.com/importedmedia/downloadfiles/OEKO-TEX_STeP_Standard_EN_DE.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/279> ;
