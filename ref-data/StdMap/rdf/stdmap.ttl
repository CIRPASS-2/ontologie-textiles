<https://w3id.org/eudpp/standard/sustainability/496> a eudpp:SustainabilityStandard ;
  dct:description "A.I.S.E. is the International Association for Soaps, Detergents and Maintenance Products. Based in Brussels, A.I.S.E. has been the voice of the industry to EU regulators for over 65 years. Membership consists of 29 national associations across Europe, 18 corporate members and 13 value chain partners. Through this extensive network, A.I.S.E. represents over 900 companies supplying household and professional cleaning products and services across Europe.      https://www.aise.eu/about-aise/who-we-are.aspx" ;
  dct:issued "2005"^^xsd:gYear ;
  dct:references <https://www.aise.eu/about-aise/who-we-are.aspx> ;
  dct:relation <https://www.sustainable-cleaning2020.com/company-area/charter-2020-documentation> ;
  dct:source <https://www.standardsmap.org/en/factsheet/496> ;
  dct:title "A.I.S.E" ;
