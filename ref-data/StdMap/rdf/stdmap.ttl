  eudpp:appliesToCountryOfDestinationCode "CH", "DE", "DK", "GB", "IE", "SE", "TW" ;
  eudpp:appliesToCountryOfDestinationStr "Chinese Taipei", "Denmark", "Germany", "Ireland", "Sweden", "Switzerland", "United Kingdom of Great Britain and Northern Ireland" ;
  eudpp:appliesToCountryOfOrigin <https://w3id.org/eudpp/country/BR>, <https://w3id.org/eudpp/country/CN>, <https://w3id.org/eudpp/country/IN>, <https://w3id.org/eudpp/country/TR>, <https://w3id.org/eudpp/country/VN> ;
  eudpp:appliesToCountryOfOriginCode "BR", "CN", "IN", "TR", "VN" ;
  eudpp:appliesToCountryOfOriginStr "Brazil", "China", "India", "Türkiye", "Viet Nam" ;
