<https://w3id.org/eudpp/standard/sustainability/301> a eudpp:SustainabilityStandard ;
  dct:description "El Triple Sello es un distintivo colocado en el envase, empaque o envoltorio de los productos, que indica que éste ha sido producido en toda su cadena productiva sin Trabajo Infantil, Discriminación y Trabajo Forzoso, permitiendo ganar espacios en el comercio mundial con productos considerados como socialmente responsables." ;
  dct:issued "2006"^^xsd:gYear ;
  dct:relation eudpp:NA ;
  dct:source <https://www.standardsmap.org/en/factsheet/301> ;
  dct:title "Triple Sello" ;
