<https://w3id.org/eudpp/standard/sustainability/100001> a eudpp:SustainabilityStandard ;
  dct:description "VietFarm is an independent standard system developed to be accessible to and used by small-to-medium sized agricultural enterprises (farms, growers' groups, cooperatives, processors, etc.) and especially those led by women, ethnic minorities, and operating in Vietnam's rural and lower-income areas. Our aim is to ensure a level of environmental stewardship, market access, and overall sustainability equal to or better than various state-sponsored and alternative standards.  The standard is connected to farmer education and extension efforts to promote and support producer's participation as well as a labeling and traceability program to assure downstream agrifoods buyers (wholesalers, retailers, consumers) of the provenance and the quality of the farm products that end up on their tables." ;
  dct:issued "2005"^^xsd:gYear ;
  dct:relation <https://vietfarm.org.vn/he-thong-tieu-chuan/bo-tieu-chuan-vietfarm/>, <https://vietfarm.org.vn/wp-content/uploads/2019/05/2.VietFarm-Standards-190213.pdf>, <https://vietfarm.org.vn/wp-content/uploads/2019/07/VIETFARM_STANDARDS_Ev1._2018.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/100001> ;
  dct:title "VietFarm" ;
