<https://w3id.org/eudpp/standard/sustainability/735> a eudpp:SustainabilityStandard ;
  dct:description "The BioTrade Principles and Criteria sets out the criteria that BioTrade organizations, wanting to use practices that are economically, socially and environmentally sustainable, should aspire. The Principles and Criteria can be applied in different contexts, driving BioTrade processes to promote the conservation of biodiversity through sustainable commercial use.  This P&C specifically refers to terrestrial biodiversity in food sectors.   Requirements that cover specific species are not reflected in the mapping of the BioTrade Principles and Criteria in Standards Map." ;
  dct:created "2023-08-04"^^xsd:date ;
  dct:issued "1996"^^xsd:gYear ;
  dct:source <https://www.standardsmap.org/en/factsheet/735> ;
  dct:title "UNCTAD BioTrade Principles & Criteria - General" ;
