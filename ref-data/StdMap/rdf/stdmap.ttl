<https://w3id.org/eudpp/standard/sustainability/19> a eudpp:SustainabilityStandard ;
  dct:description "Fair Wear Foundation (Fair Wear) is an independent, non-profit organization that works to improve conditions for workers in garment factories.   As a true multistakeholder initiative, we connect and convene brands, factories, workers, trade unions, NGOs and other industry influencers.  Our approach is to closely collaborate to build a critical mass for change, providing active and practical support to ensure that workers are in the driving seat of improving and monitoring their own working conditions. We envision and actively work towards a situation where garment workers are well informed, well represented and have the means to raise concerns when their rights are violated. We guide and assess brands and promote the full and mandatory implementation of the OECD guidelines for human rights due diligence across the industry.  https://www.fairwear.org/about-us/get-to-know-fair-wear/" ;
  dct:issued "1999"^^xsd:gYear ;
  dct:references <https://www.fairwear.org/about-us/get-to-know-fair-wear/> ;
  dct:relation <https://api.fairwear.org/wp-content/uploads/2019/11/Fair-Wear-Living-Wage-Policy-V2-July-2020-updated-Oct2020.pdf>, <https://api.fairwear.org/wp-content/uploads/2020/01/FW-list-potential-harms-and-harms-2023.pdf>, <https://api.fairwear.org/wp-content/uploads/2020/09/Child-labour-FWF-policy-and-practice.pdf>, <https://api.fairwear.org/wp-content/uploads/2020/09/Fair-Wear-Complaints-procedure-V2.0.pdf>, <https://api.fairwear.org/wp-content/uploads/2021/04/Freedom-of-Association-and-Collective-Bargaining-2021.pdf>, <https://api.fairwear.org/wp-content/uploads/2021/08/Gender-Equality-Policy-2021.pdf>, <https://www.fairwear.org/about-us/labour-standards>, <https://www.fairwear.org/resources-and-tools/resource-documents>, <https://www.fairwear.org/stories/fair-wears-updated-hrdd-policy> ;
  dct:source <https://www.standardsmap.org/en/factsheet/19> ;
  dct:title "Fair Wear Foundation" ;
