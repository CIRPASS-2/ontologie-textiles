<https://w3id.org/eudpp/standard/sustainability/868686> a eudpp:SustainabilityStandard ;
  dct:description "El Estándar de Sustentabilidad del Sector Porcino es un instrumento voluntario destinado a mejorar las operaciones de los productores de cerdos a nivel nacional, promoviendo el compromiso y cumplimiento de las empresas en los distintos aspectos relacionados con la sustentabilidad del sector. Este estándar fue desarrollado en el marco del Programa Chile Origen Consciente, iniciativa liderada por la Oficina de Estudios y Políticas Agrarias (ODEPA) del Ministerio de Agricultura y que busca posicionar al país como un proveedor de alimentos seguros, saludables y sustentables." ;
  dct:created "2022-01-19"^^xsd:date ;
  dct:issued "1985"^^xsd:gYear ;
  dct:relation <https://chileorigenconsciente.cl/sector-porcino/#undefined/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/868686> ;
  dct:title "PROTOCOLO DE SUSTENTABILIDAD EN PRODUCCIÓN DE CERDOS (CHILE)" ;
  eudpp:appliesToCountryOfOrigin <https://w3id.org/eudpp/country/CL> ;
  eudpp:appliesToCountryOfOriginCode "CL" ;
  eudpp:appliesToCountryOfOriginStr "Chile" ;
