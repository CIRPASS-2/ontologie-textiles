<https://w3id.org/eudpp/standard/sustainability/54> a eudpp:SustainabilityStandard ;
  dct:description "The Round Table on Responsible Soy is a civil organization that promotes responsible production, processing and trading of soy on a global level. According to the Round Table philosophy, players from different areas and with diverse interests obtain equal rights and get together with a common purpose, thus assuring dialogue and decision-making by consensus. The RTRS Standard for Responsible Soy Production is applicable on a worldwide level that assures soy production is socially equitable, economically feasible and environmentally sound." ;
  dct:issued "2006"^^xsd:gYear ;
  dct:relation <https://responsiblesoy.org/wp-content/uploads/2021/12/RTRS-Standard-for-Responsible-Soy-Production-V4.0.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/54> ;
  dct:title "Round Table on Responsible Soy Association - RTRS" ;
