<https://w3id.org/eudpp/standard/sustainability/3491> a eudpp:SustainabilityStandard ;
  dct:description "The Elephant Friendly™ Tea program is a partnership between WFEN and the University of Montana’s Broader Impacts Group. The standards are based on state-of-the-field research by University of Montana and other Asian Elephant and tea sector experts in the Indian context. Certified Elephant Friendly™ Tea is sourced from tea plantations that take important steps toward protecting elephants, people and the natural environment from many hazards common on these landscapes." ;
  dct:issued "2007"^^xsd:gYear ;
  dct:relation <https://wildlifefriendly.org/elephant-friendly-tea-standards/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/3491> ;
  dct:title "Certified Elephant Friendly™ Tea" ;
