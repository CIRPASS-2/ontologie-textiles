<https://w3id.org/eudpp/standard/sustainability/3490> a eudpp:SustainabilityStandard ;
  dct:description "By partnering with local communities, the travel and hospitality industry, and on-the-ground conservation partners, Sea Turtle Friendly™ Tourism acts to reduce impacts of development and recreational activities and provides new and sustainable livelihood opportunities to protect these species. Businesses eligible for certification include resorts, lodges, tour operators, tour guides, and others.  Sea Turtle Friendly™ encourages the tourism sector to take pride in their role as sea turtle stewards and in securing a long-term future for a turtle-based tourism economy. Certification also empowers tourists to select hotel and excursion options with the confidence that they are truly supporting conservation efforts.  The Sea Turtle Friendly™ standards include criteria on:  - Nesting beach management - Conservation of foraging habitat - Beachfront lighting - Guidelines for visitor behavior near sea turtles - Monitoring - Community involvement - Education and outreach" ;
  dct:issued "2007"^^xsd:gYear ;
  dct:relation <http://wildlifefriendly.org/sea-turtle-friendly/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/3490> ;
  dct:title "Certified Sea Turtle Friendly™ Tourism" ;
  eudpp:appliesToCountryOfOrigin <https://w3id.org/eudpp/country/PH> ;
  eudpp:appliesToCountryOfOriginCode "PH" ;
  eudpp:appliesToCountryOfOriginStr "Philippines" ;
  eudpp:benchmarkedAfter2022 true ;
  eudpp:benchmarkedBefore2022 true ;
  eudpp:hasThirdPartyVerification true ;
  eudpp:isConsumableLabel true ;
  eudpp:isInternational true ;
  eudpp:isPrivate false ;
  eudpp:isPublic false ;
  eudpp:pillarScoreEthics 4 ;
  eudpp:pillarScoreQuality 0 ;
  eudpp:pillarScoreSocial 10 ;
