<https://w3id.org/eudpp/standard/sustainability/127> a eudpp:SustainabilityStandard ;
  dct:description "The Global Seafood Alliance is an international, nonprofit trade association dedicated to advancing responsible seafood practices through education, advocacy and third-party assurances. Through the development of its Best Aquaculture Practices and Best Seafood Practices certification programs, GSA has become the leading provider of assurances for seafood globally." ;
  dct:issued "1997"^^xsd:gYear ;
  dct:relation <https://bapcertification.org/Standards> ;
  dct:source <https://www.standardsmap.org/en/factsheet/127> ;
  dct:title "Global Seafood Alliance - Best Aquaculture Practices" ;
