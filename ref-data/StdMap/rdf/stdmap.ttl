<https://w3id.org/eudpp/standard/sustainability/432> a eudpp:SustainabilityStandard ;
  dct:description "Friend of the Earth is an international certification scheme for sustainable agriculture and breeding that has been developed within the guidelines of the Sustainability Assessment of Food and Agriculture Systems (SAFA) of the Food and Agriculture organization of the United Nations (FAO) and whose principles are based on the safeguarding and protection of the entire ecosystem.  Friend of the Earth aims to raise awareness among companies and guide them towards sustainable agriculture and farming from environmental, economic, and social points of view. The Friend of the Earth ensures:  -Environmental sustainability -Conservation of biodiversity -Rational management and conservation of resources -Reduction of greenhouse gas emissions -Integrated agriculture -Responsible waste management -Energy sustainability -Animal welfare -Social responsibility" ;
  dct:issued "2014"^^xsd:gYear ;
  dct:relation <https://friendoftheearth.org/standards-and-certifications/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/432> ;
  dct:title "Friend of the Earth" ;
