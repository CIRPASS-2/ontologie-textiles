  dct:relation <http://www.efisc-gtp.eu/data/EFISC.GTP%20Code%20V4.0%2025.01.2019.pdf>, <http://www.efisc-gtp.eu/web/efisc_gtp%20documents%20_new_/1011306087/list1187970138/f1.html> ;
