<https://w3id.org/eudpp/standard/sustainability/1006> a eudpp:SustainabilityStandard ;
  dct:description "The REDcert Scheme principles for the production of biomass, biofuels and bioliquids is intended for biofuels and bioliquids that were produced from different kinds of biomass. This relates to biomass that was produced from agricultural raw materials as well as waste and residues as long as the specific requirements stipulated in Directive 2009/28/EC Article 17 nos. (1) and (2) are satisfied.  https://www.redcert.org/images/SP_EU_Basic_Vers.05.pdf" ;
  dct:issued "2010"^^xsd:gYear ;
  dct:references <https://www.redcert.org/images/SP_EU_Basic_Vers.05.pdf> ;
