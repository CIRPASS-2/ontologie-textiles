<https://w3id.org/eudpp/standard/sustainability/65> a eudpp:SustainabilityStandard ;
  dct:description "UEBT is a non-profit association that promotes sourcing with respect: the good practices for how companies and their suppliers should harvest, collect or grow natural ingredients in a way that is respectful of the local environment and the people who call it home. Companies, communities, civil society and other stakeholders are involved in developing these practices, collectively known as the UEBT standard.  https://www.ethicalbiotrade.org/about-uebt" ;
  dct:issued "2007"^^xsd:gYear ;
  dct:references <https://www.ethicalbiotrade.org/about-uebt> ;
  dct:relation <https://www.ethicalbiotrade.org/resources/> ;
