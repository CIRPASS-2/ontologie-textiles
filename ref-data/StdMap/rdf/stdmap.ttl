<https://w3id.org/eudpp/standard/sustainability/270686> a eudpp:SustainabilityStandard ;
  dct:description "Travelife is a global accommodation sustainability certification body. Respected for being impartial and robust, our comprehensive set of requirements cover emissions, biodiversity, human rights, fair labour, child safeguarding and animal welfare." ;
  dct:created "2025-06-09"^^xsd:date ;
  dct:issued "2007"^^xsd:gYear ;
  dct:relation <https://travelifestaybetter.com/accommodation-certification-agreement/>, <https://travelifestaybetter.com/wp-content/uploads/2024/01/Travelife-Certification-Requirements-V1.0-EN.pdf> ;
