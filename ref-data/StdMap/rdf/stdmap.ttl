<https://w3id.org/eudpp/standard/sustainability/146357> a eudpp:SustainabilityStandard ;
  dct:description "GLOBALG.A.P. is a brand of smart farm assurance solutions for the certification of agriculture, aquaculture, and floriculture – advancing safer and more sustainable farming practices in over 130 countries worldwide. “GLOBALG.A.P. is a brand of smart farm assurance solutions for the certification of agriculture, aquaculture, and floriculture – advancing safer and more sustainable farming practices in over 130 countries worldwide. The GLOBALG.A.P. Integrated Farm Assurance (IFA) Standard covers the certification of the whole agricultural production process of the product from before the plant is in the ground (origin and propagation material control points) and the certification of the full aquaculture production supply, reproduction, grow-out, aquafeed, harvest, post-harvest up to the point of sale." ;
  dct:created "2024-10-16"^^xsd:date ;
  dct:issued "1997"^^xsd:gYear ;
  dct:relation <https://www.globalgap.org/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/146357> ;
  dct:title "GLOBALG.A.P. Aquaculture + GRASP" ;
