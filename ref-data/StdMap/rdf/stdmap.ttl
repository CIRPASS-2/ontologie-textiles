  eudpp:valueChain <https://w3id.org/eudpp/thesauri/Value_Chain/Distribution>, <https://w3id.org/eudpp/thesauri/Value_Chain/Manufacturing>, <https://w3id.org/eudpp/thesauri/Value_Chain/Production> .

<https://w3id.org/eudpp/standard/sustainability/267> a eudpp:SustainabilityStandard ;
  dct:description "GLOBALG.A.P. is a brand of smart farm assurance solutions for the certification of agriculture, aquaculture, and floriculture – advancing safer and more sustainable farming practices in over 130 countries worldwide.  The GLOBALG.A.P. Integrated Farm Assurance (IFA) Standard covers the certification of the whole agricultural production process of the product from before the plant is in the ground (origin and propagation material control points) or from when the animal enters the production process to non-processed product (no processing, manufacturing or slaughtering is covered, except for the first level in Aquaculture)." ;
  dct:issued "1997"^^xsd:gYear ;
  dct:relation <https://www.globalgap.org/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/267> ;
  dct:title "GLOBALG.A.P. Floriculture" ;
