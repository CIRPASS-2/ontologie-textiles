<https://w3id.org/eudpp/standard/sustainability/21100100> a eudpp:SustainabilityStandard ;
  dct:description "The Initiative for Responsible Mining Assurance (IRMA)  set environmental, social and human rights best practices for responsible mining through a cross-sector dialogue,  including mining companies, jewelry retailers, civil society representatives, technical experts and trade associations." ;
  dct:issued "2006"^^xsd:gYear ;
