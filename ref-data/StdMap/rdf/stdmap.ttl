<https://w3id.org/eudpp/standard/sustainability/4317> a eudpp:SustainabilityStandard ;
  dct:description "The ISO 34101 series specifies requirements for the sustainable production of cocoa beans, for traceability of sustainably produced cocoa and for the scheme for certifying sustainable and traceable cocoa. The stepwise approach of the ISO 34101 series comprises three requirement levels: entry, medium and high.  An organization that is sustainably producing cocoa beans can apply for initial certification to any level and will then be on a path towards a higher level until the high level is reached. The path from entry level to medium level can take up to 60 months. The path from medium level to high level can take up to 60 months. An organization shall not remain more than 60 months in either entry or medium levels. For sampling and quality requirements of cocoa beans references are made to ISO 2451 and ISO 2292.  Access ISO Webstore here: https://www.iso.org/store.html" ;
  dct:created "2022-04-22"^^xsd:date ;
  dct:issued "1947"^^xsd:gYear ;
  dct:references <https://www.iso.org/store.html> ;
  dct:relation <https://www.iso.org/committee/5100987/x/catalogue/p/1/u/0/w/0/d/0> ;
  dct:source <https://www.standardsmap.org/en/factsheet/4317> ;
  dct:title "ISO 34101 Series 'Sustainable and traceable cocoa': Medium level" ;
