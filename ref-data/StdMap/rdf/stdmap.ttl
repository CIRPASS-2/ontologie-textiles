<https://w3id.org/eudpp/standard/sustainability/15658> a eudpp:SustainabilityStandard ;
  dct:description "The brand Naturaline Textil stands for ecologically ond sociably sustainable textiles produced from organic cotton. It aims to cover the demand for fair and sustainable textile production and to provide a transparent chain of custody from raw material to the finished product." ;
  dct:issued "1995"^^xsd:gYear ;
  dct:relation <http://www.naturaline-international.ch/>, <https://www.biore.ch/wp-content/uploads/X_bioRe_Sustainable_Cotton_Standard_2017_version_3.0.pdf>, <https://www.taten-statt-worte.ch/de.html> ;
  dct:source <https://www.standardsmap.org/en/factsheet/15658> ;
  dct:title "Coop Naturaline" ;
  eudpp:appliesToCountryOfDestination <https://w3id.org/eudpp/country/CH>, <https://w3id.org/eudpp/country/DE> ;
  eudpp:appliesToCountryOfDestinationCode "CH", "DE" ;
  eudpp:appliesToCountryOfDestinationStr "Germany", "Switzerland" ;
