<https://w3id.org/eudpp/standard/sustainability/285> a eudpp:SustainabilityStandard ;
  dct:description "The Blue Angel is a state-owned environmental label. The award criteria are developed by the German Federal Environmental Agency involving all relevant interest groups. The decision-making body “Jury Umweltzeichen” decides on the award criteria. The German Federal Ministry for the Environment, Nature Conservation, Building and Nuclear Safety (BMUB) owns the label. Products with the Blue Angel label fulfill high environmental, health and functional requirements. Textiles carrying the Blue Angel label must meet high requirements to ensure an environmentally friendly production process for both, natural and synthetic fibers. The label thereby focuses on the use of chemicals. Furthermore, it demands compliance with labor standards. All requirements of the Blue Angel have to be met immediately. " ;
  dct:issued "1978"^^xsd:gYear ;
  dct:relation <https://produktinfo.blauer-engel.de/uploads/criteriafile/en/DE-UZ%20154-202301-en-criteria-V2.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/285> ;
  dct:title "Blue Angel - Textiles" ;
  eudpp:appliesToCountryOfDestination <https://w3id.org/eudpp/country/DE> ;
  eudpp:appliesToCountryOfDestinationCode "DE" ;
  eudpp:appliesToCountryOfDestinationStr "Germany" ;
  eudpp:appliesToCountryOfOrigin <https://w3id.org/eudpp/country/DE> ;
  eudpp:appliesToCountryOfOriginCode "DE" ;
  eudpp:appliesToCountryOfOriginStr "", "Germany" ;
