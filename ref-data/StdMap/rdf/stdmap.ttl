<https://w3id.org/eudpp/standard/sustainability/434> a eudpp:SustainabilityStandard ;
  dct:description "The Fair Trade Certified Apparel and Home Goods program is the first of its kind to offer a consumer-facing label– a mechanism to recognize brands on their journey towards ethical production, and a signal to consumers looking for high-quality styles that also support better wages and safe working conditions. In a Globescan study, when U.S. consumers were asked what new product they would most like to see Fair Trade Certified, the top response was apparel and textiles." ;
  dct:issued "2010"^^xsd:gYear ;
  dct:relation <http://fairtradeusa.org/certification/standards/download-center>, <http://fairtradeusa.org/sites/all/files/wysiwyg/filemanager/FTUSA_AHGFactory_CC_1.2v1_EN_03062014.pdf>, <http://fairtradeusa.org/sites/all/files/wysiwyg/filemanager/FTUSA_FactoryStandardAHG_1.2_EN_03062014.pdf>, <http://fairtradeusa.org/sites/all/files/wysiwyg/filemanager/FTUSA_TradeStandardAHG_1.1_EN_102513.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/434> ;
  dct:title "Fair Trade USA - Factory Standard for Apparel and Home Goods" ;
