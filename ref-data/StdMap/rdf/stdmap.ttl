<https://w3id.org/eudpp/standard/sustainability/78651> a eudpp:SustainabilityStandard ;
  dct:description "IP-Suisse is one of the most important agricultural producer organizations in Switzerland today. It certifies foodstuffs sustainably produced in Switzerland. IP-Suisse aims to be both consumer- and environment friendly and ensures adherence to strict quality requirements throughout the production chain. Every labelled product can be traced back to its source. The price setting of products takes into consideration the extra work farmers undertake to protect the environment and promote biodiversity." ;
  dct:issued "1989"^^xsd:gYear ;
  dct:relation <http://web87.login-162.hoststar.ch/wp-content/uploads/Leitfaden-Biodiversitaet-Januar-2015-D.pdf>, <http://web87.login-162.hoststar.ch/wp-content/uploads/Reglement-fuer-die-Aufbereitung-und-Vermarktung-von-IP-SUISSE-Produkten_-April.pdf>, <http://web87.login-162.hoststar.ch/wp-content/uploads/Richtlinien_Kaninchen.pdf>, <https://www.admin.ch/opc/de/classified-compilation/20021480/201908090000/0.814.03.pdf>, <https://www.admin.ch/opc/de/classified-compilation/20130216/201901010000/910.13.pdf>, <https://www.ipsuisse.ch/leitfaden-wiesenmilch/>, <https://www.ipsuisse.ch/pflanzenbau_gemuese_2/>, <https://www.ipsuisse.ch/richtlinien-mostobst-2/>, <https://www.ipsuisse.ch/richtlinien-tiertransporte-gross-und-kleinvieh/>, <https://www.ipsuisse.ch/sanktionsreglement-verarbeitung-und-vermarktung-ips-produkte/>, <https://www.ipsuisse.ch/sanktionsreglement/>, <https://www.ipsuisse.ch/wp-content/uploads/Handversion_6-18.pdf>, <https://www.ipsuisse.ch/wp-content/uploads/MB-54-Zert.Regelement-Produkt-d-V-08.pdf>, <https://www.ipsuisse.ch/wp-content/uploads/Richtlinien_Getreide_D.pdf>, <https://www.ipsuisse.ch/wp-content/uploads/Richtlinien_Grundanforderungen_D-1.pdf>, <https://www.ipsuisse.ch/wp-content/uploads/Richtlinien_Tafelkernobst_d-2.pdf>, <https://www.ipsuisse.ch/wp-content/uploads/Richtlinien_Tierhaltung_D-3.pdf>, <https://www.ipsuisse.ch/wp-content/uploads/Richtlinien_Wiesenmilch_d-1.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/78651> ;
  dct:title "IP-Suisse Guidelines for milk" ;
