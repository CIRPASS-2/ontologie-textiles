<https://w3id.org/eudpp/standard/sustainability/200> a eudpp:SustainabilityStandard ;
  dct:description "The Guide on Social Responsibility for Chinese International Contractors is a public voluntary standard  made and promulgated by China International Contractors Association (CHINCA) to establish a benchmark of social responsibility for the industry and to encourage enterprises to uphold their global responsibility and operate overseas contracting projects in a more responsible way. CHINCA now has more than 1,300 members , among which over 1,000 are engaged in international project engineering , contracting and investment , representing about 90% of the whole industry business value , distributing in more than 190 countries and regions." ;
  dct:issued "2012"^^xsd:gYear ;
  dct:relation <http://www.chinca.org/CICA/info/17111313353911> ;
  dct:source <https://www.standardsmap.org/en/factsheet/200> ;
  dct:title "Guide on Social Responsibility for Chinese Int Contractors" ;
