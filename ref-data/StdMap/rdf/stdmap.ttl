<https://w3id.org/eudpp/standard/sustainability/107> a eudpp:SustainabilityStandard ;
  dct:description "The International Association for Research and Testing in the Field of Textile and Leather Ecology (OEKO-TEX®) is a union of 17 independent textile research and test institutes in Europe and Japan and their worldwide representative offices.   ECO PASSPORT by OEKO-TEX® is for various chemical products used in the textile, leather and clothing industry to ensure that the chemicals used throughout the production process are not harmful or dangerous to human health. The scope of the human ecological requirements is based on the intended use of the chemical and its application on textile and/or leather products." ;
  dct:issued "1992"^^xsd:gYear ;
  dct:relation <https://www.oeko-tex.com/en/apply-here/eco-passport-by-oeko-tex>, <https://www.oeko-tex.com/en/terms-of-use>, <https://www.oeko-tex.com/fileadmin/user_upload/Aktuelles/Pressemitteilungen/Jahresberichte/EN/OT_Jahresbericht_2017_2018_EN_final.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/Aktuelles/Pressemitteilungen/Jahresberichte/EN/OT_Jahresbericht_2018_19_A4_quer_EN_280220.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/Aktuelles/Pressemitteilungen/Jahresberichte/EN/OT_annual_report_2019_2020.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/Aktuelles/Pressemitteilungen/Jahresberichte/EN/OT_annual_report_2020_2021.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/Aktuelles/Pressemitteilungen/Jahresberichte/OT_annual_report_2021_2022.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/Annual_Report/OT_annual_report_2022_2023.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/ELO-Downloads/OEKO-TEX_R__Terms_of_Use_01.2019.pdf>, <https://www.oeko-tex.com/fileadmin/user_upload/Marketing_Materialien/ECO_PASSPORT/Fact>, <https://www.oeko-tex.com/fileadmin/user_upload/Marketing_Materialien/ECO_PASSPORT/RSL/ECO_PASSPORT_RSL.pdf>, <https://www.oeko-tex.com/importedmedia/downloadfiles/OEKO-TEX_ECO_PASSPORT_Application_EN_DE.pdf>, <https://www.oeko-tex.com/importedmedia/downloadfiles/OEKO-TEX_ECO_PASSPORT_Standard_EN_DE.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/107> ;
  dct:title "OEKO-TEX® ECO PASSPORT" ;
