<https://w3id.org/eudpp/standard/sustainability/142400> a eudpp:SustainabilityStandard ;
  dct:description "The Malaysian Sustainable Palm Oil (MSPO) Standard, a series initiated by the Government of Malaysia, aims to ensure the sustainability of the country's palm oil production by providing a comprehensive framework for all stakeholders in the palm oil value chain. This standard emphasizes a balance between environmental, societal, and economic considerations, aligning with the UN Sustainable Development Goals. It focuses on key areas such as preventing pollution, optimizing natural resource usage, and respecting human rights and labor principles. Additionally, it aims to support indigenous and local communities, assist organizations in legal compliance and government policy fulfillment, and foster continual improvement and global recognition for Malaysian palm oil. The MSPO Standard serves as a guide for achieving sustainability, operational benefits, stakeholder communication, and overall industry excellence." ;
  dct:created "2023-06-23"^^xsd:date ;
  dct:issued "2013"^^xsd:gYear ;
  dct:relation <https://mspo.org.my/>, <https://mysol.jsm.gov.my/>, <https://www.kpk.gov.my/kpk/en/contact-us/agency-and-council> ;
  dct:source <https://www.standardsmap.org/en/factsheet/142400> ;
  dct:title "Malaysian Sustainable Palm Oil (MSPO) MS2530:2022" ;
  eudpp:appliesToCountryOfDestination <https://w3id.org/eudpp/country/MY> ;
  eudpp:appliesToCountryOfDestinationCode "MY" ;
  eudpp:appliesToCountryOfDestinationStr "Malaysia" ;
  eudpp:appliesToCountryOfOrigin <https://w3id.org/eudpp/country/MY> ;
  eudpp:appliesToCountryOfOriginCode "MY" ;
  eudpp:appliesToCountryOfOriginStr "Malaysia" ;
  eudpp:benchmarkedAfter2022 true ;
  eudpp:benchmarkedBefore2022 true ;
  eudpp:hasThirdPartyVerification true ;
  eudpp:isConsumableLabel false ;
  eudpp:isInternational true ;
  eudpp:isPrivate false ;
  eudpp:isPublic false ;
