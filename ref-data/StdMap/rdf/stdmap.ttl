<https://w3id.org/eudpp/standard/sustainability/142369> a eudpp:SustainabilityStandard ;
  dct:description "This standard is compiled on the basis of harmonization with ASEAN GAP and with reference to some other GAP standards in the world such as: GlobalG.A.P, JGAP, with the aim of guiding organizations and individuals to produce, outline processing crop products to ensure food safety; product quality; occupational health and safety for producers; environmental protection and product traceability." ;
  dct:created "2022-06-17"^^xsd:date ;
  dct:issued "2017"^^xsd:gYear ;
  dct:relation <http://vietgap.com/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/142369> ;
  dct:title "VIETGAP Standard" ;
