<https://w3id.org/eudpp/standard/sustainability/347> a eudpp:SustainabilityStandard ;
  dct:description "The Wildlife Friendly Enterprise Network (WFEN) is a global community dedicated to the development and marketing of products that conserve threatened wildlife while contributing to the economic vitality of rural communities. WFEN includes conservationists, businesses, artisans, producers and harvesters. The Certified Wildlife Friendly™ label rigorously protects key species that are a conservation priority. Certified Wildlife Friendly™ enterprises protect a wide range of wildlife across multiple sectors around the world. The program includes separate criteria for Certified Wildlife Friendly™ Products as well as Certified Wildlife Friendly™ Tourism." ;
  dct:issued "2007"^^xsd:gYear ;
  dct:relation <https://wildlifefriendly.org/application-process/>, <https://wildlifefriendly.org/application/>, <https://wildlifefriendly.org/criteria/>, <https://wildlifefriendly.org/standards/>, <https://wildlifefriendly.org/wildlife-friendly-tourism/>, <https://wildlifefriendly.org/wp-content/uploads/2015/09/certified-wildlife-friendly-standards-final-2013-v1-0.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/347> ;
  dct:title "Certified Wildlife Friendly™" ;
