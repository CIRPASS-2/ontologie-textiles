<https://w3id.org/eudpp/standard/sustainability/566> a eudpp:SustainabilityStandard ;
  dct:description "The aim of the TÜV Rheinland Green Product Mark label is to contribute to the reduction of negative environmental impacts that can arise during the manufacture and use of laptops. To this end, the standard sets requirements for the handling of chemical ingredients, the reusability and reuse of recycled materials, the carbon footprint, and energy consumption/energy efficiency." ;
  dct:issued "2009"^^xsd:gYear ;
  dct:relation <https://www.amfori.org/content/amfori-bsci-system-manual-annexes>, <https://www.amfori.org/content/amfori-bsci-system-manual-templates>, <https://www.amfori.org/sites/default/files/Part%20III%20auditor%20guidelines.pdf>, <https://www.amfori.org/sites/default/files/amfori%20BSCI%20COC%20UK_0.pdf>, <https://www.amfori.org/sites/default/files/amfori-2020-11-03-amfori-BSCI-Reference-UK.pdf>, <https://www.tuv.com/content-media-files/germany/corporate_communication/englisch-2020/tuv-rheinland-corporatereport-2020-en-ds_stand_2021-07-06.pdf>, <https://www.tuv.com/content-media-files/korea/pdfs/about-us/testing-and-certification-regulations-%28pzo%29-of-t%C3%BCv-rheinland-lga-products-gmbh.pdf>, <https://www.tuv.com/content-media-files/master-content/services/products/0227-tuv-rheinland-certipedia/tuv-rheinland-advertising-guidelines-infosheet-en-2.pdf>, <https://www.tuv.com/content-media-files/master-content/services/products/1293-tuv-rheinland-green-product-mark/tuv-rheinland-green-product-mark-fee-schedule-en.pdf>, <https://www.tuv.com/content-media-files/master-content/services/products/1293-tuv-rheinland-green-product-mark/tuv-rheinland-green-product-mark-scheme-summary-en.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/566> ;
  dct:title "TÜV Rheinland Green Product Mark (laptops)" ;
