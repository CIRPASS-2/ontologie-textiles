<https://w3id.org/eudpp/standard/sustainability/37> a eudpp:SustainabilityStandard ;
  dct:description "Green Seal® is a global nonprofit organization that pioneered the ecolabeling movement with a mission to transform the economy for a healthier, greener world. For 30 years, Green Seal’s rigorous standards for health, sustainability and product performance have driven permanent shifts in the marketplace, empowering better purchasing decisions and rewarding industry innovators. With thousands of certified products, services and spaces from the world’s leading companies, the Green Seal certification mark is a universal symbol that a product or service meets the highest benchmark of health and environmental leadership." ;
  dct:issued "1989"^^xsd:gYear ;
  dct:relation <https://www.greenseal.org/green-seal-standards/standards-list> ;
  dct:source <https://www.standardsmap.org/en/factsheet/37> ;
  dct:title "Green Seal " ;
