<https://w3id.org/eudpp/standard/sustainability/402> a eudpp:SustainabilityStandard ;
  dct:description "The U.S. Soy Sustainability Assurance Protocol   (SSAP) is an aggregate approach audited by   third parties that verifies sustainable soybean   production at a national scale. The U.S. approach is quantifiable and results driven with mass balance international verification available." ;
  dct:issued "2012"^^xsd:gYear ;
  dct:relation <https://www.usses.org/ssap-current/> ;
