<https://w3id.org/eudpp/standard/sustainability/120> a eudpp:SustainabilityStandard ;
  dct:description "AWS is a global membership collaboration comprising businesses, NGOs and the public sector. Our members contribute to the sustainability of local water-resources through their adoption and promotion of a universal framework for the sustainable use of water – the International Water Stewardship Standard, or AWS Standard – that drives, recognizes and rewards good water stewardship performance." ;
  dct:issued "2008"^^xsd:gYear ;
  dct:relation <https://a4ws.org/the-aws-standard-2-0/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/120> ;
  dct:title "Alliance for Water Stewardship" ;
