<https://w3id.org/eudpp/standard/sustainability/891> a eudpp:SustainabilityStandard ;
  dct:description "The For Life Certification standard for Corporate Social Responsibility offers operators of socially responsible projects a solution for brand neutral third party inspection and certification in initial production, manufacturing and trading. It combines strict social and environmental standards with adaptability to local conditions. The system is designed for both food and non-food commodities (like cosmetics, textiles or tourist services)." ;
  dct:issued "2006"^^xsd:gYear ;
  dct:relation <https://www.fairforlife.org/pmws/indexDOM.php?client_id=fairforlife&page_id=root_3_4&lang_iso639=en> ;
  dct:source <https://www.standardsmap.org/en/factsheet/891> ;
  dct:title "For Life" ;
