<https://w3id.org/eudpp/standard/sustainability/100000> a eudpp:SustainabilityStandard ;
  dct:description "SRP is a multi-stakeholder alliance comprising over 100 institutional members spanning the stakeholder spectrum. Its scope is global though focused primarily on S and SE Asia as key producing countries. Nevertheless, there is increasing interest in Africa, USA and S America, and SRP has outreach programmes in a total 21 countries, reaching 500,000 farmers." ;
  dct:issued "2020"^^xsd:gYear ;
  dct:relation <http://www.sustainablerice.org/assets/docs/SRP%20Assurance%20Info%20Note%20No%201%20-%20Auditing%20Guidelines%20FINAL.pdf>, <http://www.sustainablerice.org/assets/docs/SRP%20Assurance%20Scheme%20(Final).pdf>, <http://www.sustainablerice.org/assets/docs/SRP%20Chain%20of%20Custody%20Policy%20and%20Standard%20v%201.0%20FINAL.pdf>, <http://www.sustainablerice.org/assets/docs/SRP%20IMS%20Policy%20and%20Standard%20v1.0%20(approved).pdf>, <http://www.sustainablerice.org/assets/docs/SRP%20Performance%20Indicators%20for%20Sustainable%20Rice%20Cultivation%20(Version%202.1).pdf>, <http://www.sustainablerice.org/assets/docs/SRP%20Standard%20for%20Sustainable%20Rice%20Cultivation%20(Version%202.1).pdf> ;
