<https://w3id.org/eudpp/standard/sustainability/8009> a eudpp:SustainabilityStandard ;
  dct:description "Certified Animal Welfare Approved by AGW (AWA) is the only label that guarantees animals are raised outdoors on pasture or range for their entire lives on an independent farm using truly sustainable, high-welfare farming practices. It is the only label in the U.S. to require audited, high-welfare production, transport and slaughter practices, and has the single highest impact on consumer purchasing of any food label, according to The Hartman Group.  The Certified Animal Welfare Approved by AGW standards were developed in collaboration with scientists, veterinarians, researchers and farmers across the globe to maximize practicable, high-welfare farm management, and are publicly available online. We’re proud of AWA’s reputation for being a practical, common-sense program that’s grounded in the realities of everyday farm and ranch life." ;
  dct:created "2025-03-17"^^xsd:date ;
  dct:issued "2014"^^xsd:gYear ;
  dct:relation <https://agreenerworld.org/certifications/animal-welfare-approved/standards/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/8009> ;
  dct:title "Animal Welfare" ;
