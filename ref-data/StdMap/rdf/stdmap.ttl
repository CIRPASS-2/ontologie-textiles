  eudpp:appliesToCountryOfDestinationCode "BW", "LS", "MG", "MZ", "SZ", "TZ", "ZA" ;
  eudpp:appliesToCountryOfDestinationStr "Botswana", "Lesotho", "Madagascar", "Mozambique", "Namibia", "South Africa", "Swaziland", "United Republic of Tanzania" ;
