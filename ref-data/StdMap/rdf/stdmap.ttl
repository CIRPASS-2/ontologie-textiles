<https://w3id.org/eudpp/standard/sustainability/26> a eudpp:SustainabilityStandard ;
  dct:description "FSSC 22000 contains a complete certification scheme for Food Safety Management Systems (FSMS) and is fully based on the international, independent standards: ISO 22000, with sector specific ISO technical specifications for PRP’s and additional scheme requirements. FSSC 22000 is the only ISO based FSMS Certification Scheme that is recognized by the Global Food Safety Initiative (GFSI)." ;
  dct:issued "2009"^^xsd:gYear ;
  dct:relation <https://www.fssc22000.com/scheme/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/26> ;
  dct:title "Food Safety System Certification 22000" ;
