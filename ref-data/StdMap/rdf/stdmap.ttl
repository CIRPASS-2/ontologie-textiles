<https://w3id.org/eudpp/standard/sustainability/44> a eudpp:SustainabilityStandard ;
  dct:description "KRAV is a Swedish-based sustainability labelling system for food. It is based on organic principles and places higher demands on aspects such as good animal welfare, biodiversity, social responsibility and climate. KRAV standards are adapted to the IFOAM Standards and included in IFOAM Family of Standards. KRAV standards also fulfill the EU regulation for organic production (EU) 2018/848. KRAV standards are stricter than the EU standards. KRAV standards encompass a wider variety of enterprises, such as certification of restaurants and fisheries." ;
  dct:issued "1985"^^xsd:gYear ;
  dct:relation <https://www.krav.se/en/standards/download-krav-standards/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/44> ;
  dct:title "KRAV" ;
