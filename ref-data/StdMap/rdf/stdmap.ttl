<https://w3id.org/eudpp/standard/sustainability/160> a eudpp:SustainabilityStandard ;
  dct:description "The International Association for Research and Testing in the Field of Textile and Leather Ecology (OEKO-TEX®) is a union of 17 independent textile research and test institutes in Europe and Japan and their worldwide representative offices.   OEKO-TEX® STANDARD 100 is one of the world's best-known labels for textiles tested for harmful substances. It stands for customer confidence and high product safety." ;
  dct:issued "1992"^^xsd:gYear ;
  dct:relation <https://www.oeko-tex.com/importedmedia/downloadfiles/OEKO-TEX_STANDARD_100_Standard_EN_DE.pdf> ;
