<https://w3id.org/eudpp/standard/sustainability/148> a eudpp:SustainabilityStandard ;
  dct:description "The HKGLS is an independent, non-profit-making and voluntary scheme for the certification of environmentally preferable products launched in December 2000 by Green Council (GC). The scheme sets environmental standards and awards \"Green Label\" to products that are qualified regarding their environment performance.  The aim is to encourage manufacturers to supply products with good environmental performance and provide a convenient means for consumers to recognize products that are more environmentally responsible, thus promoting a more sustainable pattern of consumption. " ;
  dct:issued "2000"^^xsd:gYear ;
  dct:relation <https://www.greencouncil.org/hkgls2> ;
  dct:source <https://www.standardsmap.org/en/factsheet/148> ;
  dct:title "Hong Kong Green Label Scheme - HKGLS" ;
