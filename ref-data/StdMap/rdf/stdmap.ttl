<https://w3id.org/eudpp/standard/sustainability/56972> a eudpp:SustainabilityStandard ;
  dct:description "Vitality Leaf defines the environmental safety requirements of  products and servicies at all stages of the life cycle and methods for assessing compliance with these requirements.  Vitality Leaf is: •\tthe only Russian ecolabel recognized by the international expert community; •\tfor the consumer it is a guarantee of the environmental safety of the product for humans and the environment; •\tfor the company it is a sign of leadership in the field of sustainable production and consumption, recognizable by consumers, business partners and industry experts" ;
  dct:issued "1991"^^xsd:gYear ;
  dct:relation <https://ecounion.ru/en/certification/standards/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/56972> ;
  dct:title "Vitality Leaf" ;
