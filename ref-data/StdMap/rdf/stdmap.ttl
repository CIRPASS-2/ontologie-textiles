<https://w3id.org/eudpp/standard/sustainability/5> a eudpp:SustainabilityStandard ;
  dct:description "The amfori BSCI Code of Conduct is a commitment document for amfori members and their business partners to exercise human rights due diligence and environmental protection in their global supply chains in line with internationally recognized principles.  Please note that amfori BSCI only offers a general overview of \"Protection of Environment” within its Performance Area 12. For a more comprehensive deep dive into environmental due diligence please refer to amfori BEPI, a unique cross sectorial tool helping amfori members identify and mitigate environmental risks within 8 Environmental Performance Areas in their supply chains https://www.amfori.org/sites/default/files/amfori%20BSCI%20Code%20of%20Conduct%20%20-%20English%20-%20December%202021_v2.pdf" ;
  dct:issued "2003"^^xsd:gYear ;
  dct:references <https://www.amfori.org/sites/default/files/amfori%20BSCI%20Code%20of%20Conduct%20%20-%20English%20-%20December%202021_v2.pdf> ;
  dct:relation <https://www.amfori.org/document_solution/amfori-bsci/?section=members> ;
  dct:source <https://www.standardsmap.org/en/factsheet/5> ;
