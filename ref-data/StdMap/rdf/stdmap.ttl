<https://w3id.org/eudpp/standard/sustainability/144> a eudpp:SustainabilityStandard ;
  dct:description "The EAS 456:2007, East African organic product standard is the second regional organic standard (EAOPS) in the world after the European Union's and the first ever to have been developed in cooperation between the organic movements and the national standards bodies. The standard has been developed by the Regional Standard Technical Working Group a unique regional public-private sector partnership, whose members comprise representatives of the national standards bodies, national organic movements and organic certifying bodies of Kenya, United Republic of Tanzania, Uganda, Burundi and Rwanda, and the East African Business Council. Development of the East African Standards has been necessitated by the need for harmonizing requirements governing quality of products and services in East Africa." ;
  dct:issued "2007"^^xsd:gYear ;
  dct:relation <https://kilimohai.org/fileadmin/02_documents/Standards/East_African_Organic_products_standard.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/144> ;
  dct:title "East African organic products standard (EAOPS)" ;
  eudpp:appliesToCountryOfDestination <https://w3id.org/eudpp/country/BI>, <https://w3id.org/eudpp/country/KE>, <https://w3id.org/eudpp/country/RW>, <https://w3id.org/eudpp/country/TZ>, <https://w3id.org/eudpp/country/UG> ;
  eudpp:appliesToCountryOfDestinationCode "BI", "KE", "RW", "TZ", "UG" ;
  eudpp:appliesToCountryOfDestinationStr "Burundi", "Kenya", "Rwanda", "Uganda", "United Republic of Tanzania" ;
  eudpp:appliesToCountryOfOrigin <https://w3id.org/eudpp/country/BI>, <https://w3id.org/eudpp/country/KE>, <https://w3id.org/eudpp/country/RW>, <https://w3id.org/eudpp/country/TZ>, <https://w3id.org/eudpp/country/UG> ;
  eudpp:appliesToCountryOfOriginCode "BI", "KE", "RW", "TZ", "UG" ;
  eudpp:appliesToCountryOfOriginStr "Burundi", "Kenya", "Rwanda", "Uganda", "United Republic of Tanzania" ;
  eudpp:benchmarkedAfter2022 true ;
  eudpp:benchmarkedBefore2022 true ;
  eudpp:hasThirdPartyVerification false ;
  eudpp:isConsumableLabel false ;
  eudpp:isInternational true ;
  eudpp:isPrivate false ;
  eudpp:isPublic false ;
