<https://w3id.org/eudpp/standard/sustainability/475987> a eudpp:SustainabilityStandard ;
  dct:description "The PROFARM Production Standard has been developed in response to market demand for a certification and verification solution for environmental sustainability and social responsibility in agriculture, that is flexible and nimble enough to encompass scale of production in terms of large crop areas and multiple crops. The aim of the PROFARM Production Standard is to encourage the wider adoption of good agricultural practices. This includes the protection of high conservation value areas, the environment and biodiversity in general, and rural workers as well as communities.    PROFARM Production Standard is applicable to the agricultural production level of any kind of crop." ;
  dct:created "2022-01-19"^^xsd:date ;
  dct:issued "1996"^^xsd:gYear ;
  dct:relation <https://www.foodchainid.com/br/profarm/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/475987> ;
  dct:title "PROFARM Production Standard" ;
