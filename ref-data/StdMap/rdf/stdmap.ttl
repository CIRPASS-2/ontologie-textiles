<https://w3id.org/eudpp/standard/sustainability/468> a eudpp:SustainabilityStandard ;
  dct:description "The main goals of Fairtrade are making changes to the conventional trading system that aim to benefit disadvantaged small producers and workers in the Global South and increasing their access to markets These actions can lead to improvements in small producer‘s social and economic well-being, as well as to their empowerment, and to environmental sustainability. The Fairtrade Standard for Gold and Associated Precious Metals for Artisanal and Small-Scale Mining covers the requirements that need to be complied with in order to participate in the Fairtrade system." ;
  dct:issued "1997"^^xsd:gYear ;
  dct:relation <https://files.fairtrade.net/standards/2015-04-15_EN_Gold-and-Precious_Metals.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/468> ;
  dct:title "Fairtrade International - Gold Standard" ;
