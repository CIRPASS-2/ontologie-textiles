<https://w3id.org/eudpp/standard/sustainability/245> a eudpp:SustainabilityStandard ;
  dct:description "FlorEcuador® Certification is applicable to companies of all sizes dedicated to the production, export and / or commercialization of flowers in the Ecuadorian territory within the framework of their social and environmental requirements. The objectives of FlorEcuador are: a. Guarantee the fulfillment of rights, benefits, safety and health of workers. b. Minimize the environmental impact caused by the flower-growing activity in Ecuador. c. Control and reduce the use of pesticides and other inputs used in the activity." ;
  dct:issued "2005"^^xsd:gYear ;
  dct:relation <https://expoflores.com/certificacion-flor-ecuador/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/245> ;
  dct:title "FlorEcuador" ;
