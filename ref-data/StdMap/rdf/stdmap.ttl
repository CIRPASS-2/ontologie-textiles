<https://w3id.org/eudpp/standard/sustainability/685> a eudpp:SustainabilityStandard ;
  dct:description "Good Environmental Choice Australia (GECA) runs an Australian not-for-profit, multi-sector Ecolabeling program.  GECA  develops standards against which products and services can be independently audited,  following ISO 14024 principles for global best practice in Ecolabeling. It certifies a various range of products, varrying from building products, cleaning products, furnitures and textiles items.  GECA's scheme enables consumers to choose from thousands of certified products and services and have confidence that they have a lower impact on the environment and human health and address important social considerations." ;
  dct:issued "2000"^^xsd:gYear ;
  dct:relation <http://www.geca.eco/our-standard-list/>, <http://www.geca.eco/wp-content/uploads/2019/06/GECA-Assurance-Provider-Appointment-Guidelines_190116.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/685> ;
  dct:title "Good Environmental Choice Australia (GECA) - Panel Boards" ;
