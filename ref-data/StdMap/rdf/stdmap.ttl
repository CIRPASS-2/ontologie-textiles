<https://w3id.org/eudpp/standard/sustainability/311> a eudpp:SustainabilityStandard ;
  dct:description "The Standard is a voluntary, stakeholder developed standard to allow manufacturers to demonstrate that they are operating to high standards of food safety and quality management. The Standard is based on HACCP principles  supported by a documented quality management system and good manufacturing processes assessed through an annual audit. The Standard provides a framework for food manufacturers to assist them in the production of safe, authentic, legal food and to manage product quality to meet customers’ requirements." ;
  dct:issued "1996"^^xsd:gYear ;
  dct:relation <https://www.brcgs.com/product/global-standard-food-safety-issue-9/p-13279/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/311> ;
  dct:title "BRCGS Food Safety" ;
