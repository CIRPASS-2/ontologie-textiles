<https://w3id.org/eudpp/standard/sustainability/8047> a eudpp:SustainabilityStandard ;
  dct:description "The Green Initiative Advises and Certifies Organizations that seek to Accelerate Progress toward Climate and Nature Positive Impacts.  At Green Initiative, we empower organizations to integrate climate action at the core of their business models, helping achieve decarbonization targets and comply with international standards.  We design creative solutions for your organization to address climate change, provide certification and advisory services that help our clients to understand the global trends and to identify and implement climate actions that provide consistent and long-lasting positive impacts. https://greeninitiative.eco/about/" ;
  dct:created "2023-05-16"^^xsd:date ;
  dct:issued "2014"^^xsd:gYear ;
  dct:references <https://greeninitiative.eco/about/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/8047> ;
  dct:title "Green Initiative" ;
