<https://w3id.org/eudpp/standard/sustainability/15687> a eudpp:SustainabilityStandard ;
  dct:description "Cotton production provides livelihoods for more than 30 million people in over 60 countries. However, in conventional cotton production the use of both water and pesticides is enormous. This does not only endanger the environment, but also the health of people living in the vicinity of production sites. Migros Bio Cotton makes use of natural fertilizers and natural methods of fighting pests. Thus, nature is left intact and the earth remains fertile in the long term. Farmers do not have to spend money on expensive pesticides and fertilizers and protect their health at the same time. They make use of crop rotation and intercropping strategies. All genetic engineering is prohibited." ;
  dct:issued "1996"^^xsd:gYear ;
  dct:relation <https://generation-m.migros.ch/dam/jcr:33a61ab1-0616-46d6-9c28-108700c17003/Migros_eco-Standard_Feb_2014.pdf>, <https://generation-m.migros.ch/dam/jcr:3b9cbe41-3d1d-46b6-9b9a-986fb9dcaa6a/Eco_Criteria_2014_e.pdf>, <https://generation-m.migros.ch/dam/jcr:9dd8267f-1551-490f-8fb0-27625931d9d8/Migros%20RSL%20Liste%20Textilien_e.pdf>, <https://generation-m.migros.ch/dam/jcr:ad820964-525a-4428-954d-aee1b6320b87/Migros+Bio+Cotton_Criteria_2014_e.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/15687> ;
  dct:title "Migros Bio Cotton" ;
