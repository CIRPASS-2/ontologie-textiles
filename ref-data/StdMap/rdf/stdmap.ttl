<https://w3id.org/eudpp/standard/sustainability/1007> a eudpp:SustainabilityStandard ;
  dct:description "The \"REDcert2 System principles for biomass production in the food industry-Version 02\" is a certification scheme for sustainable biomass production for the food industry. It can also be expanded to include processing (conversion) and supply /  trade. REDcert² offers system participants already certified under REDcert-EU and prospective system participants from the food industry a way to expand their sustainability certification to include the food sector. The REDcert² certification scheme can be used for the phases raw materials production and collection, trade and processing.  https://www.redcert.org/images/Englisch/RQ_RC2__Production_Vers.02.pdf https://www.redcert.org/images/Information_about_the_REDcert2_system.pdf" ;
  dct:issued "2010"^^xsd:gYear ;
  dct:references <https://www.redcert.org/images/Englisch/RQ_RC2__Production_Vers.02.pdf> ;
  dct:relation <https://www.redcert.org/en/redcert-eu-uk.html>, <https://www.redcert.org/en/redcert.html> ;
  dct:source <https://www.standardsmap.org/en/factsheet/1007> ;
  dct:title "REDcert²" ;
