<https://w3id.org/eudpp/standard/sustainability/143> a eudpp:SustainabilityStandard ;
  dct:description "Die Knospe ist die Marke der Schweizer Bio-Landwirte und -Gärtner und verfolgt eine für Mensch, Tier und Umwelt nachhaltige Landwirtschaft und Lebensmittelproduktion.  Für Lebensmittel aus biologischer Landwirtschaft mit mindestens 10% Importanteil. Label des Dachverbandes der Bio Suisse Produzenten." ;
  dct:issued "1981"^^xsd:gYear ;
  dct:relation <http://www.bio-suisse.ch/en/downloads.php> ;
  dct:source <https://www.standardsmap.org/en/factsheet/143> ;
  dct:title "Bio-Knospe" ;
