<https://w3id.org/eudpp/standard/sustainability/1080> a eudpp:SustainabilityStandard ;
  dct:description "The Sustentar Programme was created based on the experience accumulated throughout our long-lasting technical assistance operation and follow-up of suppliers and comprises the Seal, the Certification and the Standard. The Sustentar Seal is awarded to raw material suppliers that have effectively complied with all our raw material procurement principles (e.g.: no deforestation, forced or child labour), required for all purchase transactions with Caramuru; The certification is granted to interested suppliers who have been assessed against the Sustentar Standard and met its criteria.  \t The Sustentar Standard includes social, environmental, and financial indicators, also covering ethics and governance aspects, and intends to ensure the application of sustainability concepts in our entire production chain from the supply of raw materials to the sale of our products." ;
  dct:created "2023-07-18"^^xsd:date ;
  dct:issued "1964"^^xsd:gYear ;
  dct:relation <https://sustentar.caramuru.com/en/>, <https://sustentar.caramuru.com/en/padrao-sustentar/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/1080> ;
  dct:title "Caramuru Sustentar Programme" ;
