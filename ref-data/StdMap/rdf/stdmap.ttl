  eudpp:appliesToCountryOfOriginCode "BE", "FR", "LU", "NL" ;
  eudpp:appliesToCountryOfOriginStr "Belgium", "France", "Luxembourg", "Netherlands" ;
  eudpp:benchmarkedAfter2022 true ;
  eudpp:benchmarkedBefore2022 true ;
  eudpp:hasThirdPartyVerification true ;
  eudpp:isConsumableLabel true ;
  eudpp:isInternational true ;
  eudpp:isPrivate true ;
  eudpp:isPublic false ;
  eudpp:pillarScoreEthics 6 ;
  eudpp:pillarScoreQuality 29 ;
  eudpp:pillarScoreSocial 2 ;
