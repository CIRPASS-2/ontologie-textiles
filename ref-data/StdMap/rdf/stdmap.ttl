<https://w3id.org/eudpp/standard/sustainability/146> a eudpp:SustainabilityStandard ;
  dct:description "The European Feed and Food Ingredient Safety Certification Aisbl (EFISC-GTP), a non- profit organization based in Brussels, administers the EFISC and GTP Code and their certification and promotes the schemes and their acceptance on the EU market." ;
