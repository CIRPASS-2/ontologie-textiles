<https://w3id.org/eudpp/standard/sustainability/495> a eudpp:SustainabilityStandard ;
  dct:description "Ecogarantie is THE strictest ecolabel on the market meant for non-food products. Each member of our non profit organization endeavours to offer you healthy and eco-friendly products. In order to offer a reference in terms of sustainability and organic products to the consumer, we chose to go beyond the requirements of other existing ecolabels on the market. All our eco labelled products are audited by independent control organizations following our strict specification. This way, the certification is 100% neutral! https://ecogarantie.eu/wp-content/uploads/2021/06/Press-kit-EG.pdf" ;
  dct:issued "1984"^^xsd:gYear ;
  dct:references <https://ecogarantie.eu/wp-content/uploads/2021/06/Press-kit-EG.pdf> ;
  dct:relation <https://ecogarantie.eu/>, <https://ecogarantie.eu/wp-content/uploads/2021/06/Press-kit-EG.pdf>, <https://ecogarantie.eu/wp-content/uploads/2024/11/28_10_24-Ecogarantie-full-Standards-1.pdf> ;
  dct:source <https://www.standardsmap.org/en/factsheet/495> ;
  dct:title "Ecogarantie - Washing and cleaning products" ;
