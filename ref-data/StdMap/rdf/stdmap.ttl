<https://w3id.org/eudpp/standard/sustainability/73> a eudpp:SustainabilityStandard ;
  dct:description "Founded in 2004 by a group of leading electronics companies, the Responsible Business Alliance (RBA), formerly the Electronic Industry Citizenship Coalition (EICC), is a nonprofit comprised of electronics, retail, auto and toy companies committed to supporting the rights and well-being of workers and communities worldwide affected by the global supply chain. RBA members commit and are held accountable to a common Code of Conduct and utilize a range of RBA training and assessment tools to support continual improvement in the social, environmental and ethical responsibility of their supply chains." ;
  dct:issued "2004"^^xsd:gYear ;
  dct:relation <https://www.responsiblebusiness.org/code-of-conduct/>, <https://www.responsiblebusiness.org/code-standards-and-accountability/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/73> ;
  dct:title "Responsible Business Alliance (RBA)" ;
