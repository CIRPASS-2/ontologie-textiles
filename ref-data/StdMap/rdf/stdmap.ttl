<https://w3id.org/eudpp/standard/sustainability/1001> a eudpp:SustainabilityStandard ;
  dct:description "On the way to PlanetProof is the environmental quality label which stands for sustainable production methods. On the way to PlanetProof-farmers and growers strive towards a cultivation that is in balance with the earth’s capacity. On the way to PlanetProof ensures sustainability of the agricultural sector in the Netherlands and other European countries. As of October 2020, there is 41,000 hectares of  production and 43,000 hectares of sustainably managed land for dairy cows. https://www.planetproof-international.eu/527/home.html" ;
  dct:issued "1992"^^xsd:gYear ;
  dct:references <https://www.planetproof-international.eu/527/home.html> ;
  dct:relation <https://www.planetproof.eu/en/certify/plant-products/> ;
  dct:source <https://www.standardsmap.org/en/factsheet/1001> ;
  dct:title "On The Way To PlanetProof for Plant Products in Central Europe" ;
