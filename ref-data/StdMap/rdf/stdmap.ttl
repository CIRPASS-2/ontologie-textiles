  eudpp:appliesToCountryOfOriginCode "BE", "CH", "DK", "GB", "NL", "NO", "SE" ;
  eudpp:appliesToCountryOfOriginStr "Belgium", "Denmark", "Netherlands", "Norway", "Sweden", "Switzerland", "United Kingdom of Great Britain and Northern Ireland" ;
  eudpp:benchmarkedAfter2022 true ;
  eudpp:benchmarkedBefore2022 true ;
  eudpp:hasThirdPartyVerification true ;
  eudpp:isConsumableLabel false ;
  eudpp:isInternational false ;
  eudpp:isPrivate true ;
  eudpp:isPublic false ;
  eudpp:pillarScoreEthics 19 ;
  eudpp:pillarScoreQuality 6 ;
  eudpp:pillarScoreSocial 57 ;
