base <https://w3id.org/eudpp/>
prefix eudpp: <https://w3id.org/eudpp/>
prefix dct: <http://purl.org/dc/terms/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
construct {
  ?standard_sustainability_id_URL a eudpp:SustainabilityStandard;
    eudpp:appliesToCountryOfDestinationStr ?destination_SPLIT_SEMI;
    eudpp:appliesToCountryOfDestinationCode ?destination_country_code_SPLIT_SEMI;
    eudpp:appliesToCountryOfDestination ?country_destination_country_code_SPLIT_SEMI_URL.}
where {
    bind(iri(concat("standard/sustainability/",?id)) as ?standard_sustainability_id_URL)
    ?destination_SPLIT_SEMI apf:strSplit (?destination "; ?").
    ?destination_country_code_SPLIT_SEMI apf:strSplit (?destination_country_code "; ?").
    bind(iri(concat("country/",?destination_country_code_SPLIT_SEMI)) as ?country_destination_country_code_SPLIT_SEMI_URL)
}
