<standard/sustainability/(id)> a eudpp:SustainabilityStandard;
  dct:title "(standard)";
  # (logo) # none has it
  # (lastUpdated) # unix timestamp
  # (client) # not interesting
  eudpp:countryOfOrigin "SPLIT_SEMI(origin)"; # TODO: lookup by name to link to UNLOCODE. Check country-origin.txt is covered by UNLOCODE
  # TODO: SPLIT_SEMI should allow optional space
  eudpp:countryOfDestination "SPLIT_SEMI(destination)";
  dct:issued "(yearOfEstablishment)"^^xsd:gYear;
  # (det_products) # TODO: seems to be a superset (child expansion) of below
  eudpp:product "SPLIT_SEMI(products)"; # TODO: turn to taxonomy
  eudpp:sector <thesauri/Sector/URLIFY(SPLIT_SEMI(sectors))>; # TODO check if spelling corrections broke link
  # (isInternational) # inconsistent with two lines below, so ignore
  eudpp:isPrivate "IS_PRIVATE(typology)"^^xsd:boolean;
  eudpp:isInternational "IS_INTERNATIONAL(typology)"^^xsd:boolean;
  eudpp:hasThirdPartyVerification "(hasThirdPartyVerification)"^^xsd:boolean;
  eudpp:isConsumableLabel "(isConsumableLabel)"^^xsd:boolean;
  dct:description "(descr)";
  # (mandate) # some unclear digits 
(valueChain)
(nonConversion)
(supplyChain)
(recogAndCerts)
  eudpp:sustainableDevelopmentGoals <thesauri/sustainableDevelopmentGoals/SPLIT_SEMI(sdgs)>; # TODO: find SDG as SKOS
(pillars)
(themes)
(BenchmarkedFEFAC)
(createdDate)
(url)
(weblink)
(docs_exists)
(docs_items)
(weblinkExtra)
(pillarScores_soc)
(pillarScores_ethics)
(pillarScores_qual)
