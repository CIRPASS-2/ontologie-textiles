base         <https://w3id.org/eudpp/thesauri/>
prefix xyz:  <http://sparql.xyz/facade-x/data/>
prefix fx:   <http://sparql.xyz/facade-x/ns/>
prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix dcterms: <http://purl.org/dc/terms/>

construct {
  ?collection_iri rdf:type skos:Collection .
  ?collection_iri skos:member ?item.

  #?parent_iri rdf:type skos:ConceptScheme .
  ?parent_iri rdf:type ?parent_rdf_type .
  
  ?item rdf:type skos:Concept .
  ?item a skos:Concept; 
    ?hierarchyRel ?parent_iri ;
    skos:notation ?code; skos:prefLabel ?name_en; skos:definition ?descr_en.
}
where { service <x-sparql-anything:>
  { fx:properties fx:location $_location; fx:csv.delimiter "\t"; fx:csv.headers true.
    [] a fx:root; ?li [xyz:Code%20Tag ?code; xyz:Code%20Value ?name; xyz:Description ?descr]
  }

  # Convert the CLI string arguments into proper IRIs using the BASE
  # $_parent = "thesauri/document"
  # $_collection = "doc/unece/refCodeListsTextile"
  bind(iri(concat(str(<https://w3id.org/eudpp/>), $_parent)) as ?parent_iri)
  bind(iri(concat(str(<https://w3id.org/eudpp/>), $_collection)) as ?collection_iri)
  bind(strlang(?name,"en") as ?name_en)
  bind(strlang(?descr,"en") as ?descr_en)
  bind(iri(concat(str(?parent_iri),"/",?code)) as ?item)
  bind(strlen(replace($_parent, "[^/]", "")) AS ?slashCount)
  bind(if(?slashCount = 1, skos:ConceptScheme, skos:Concept)  as ?parent_rdf_type)
  bind(if(?slashCount = 1, skos:topConceptOf, skos:broader) AS ?hierarchyRel)
}
