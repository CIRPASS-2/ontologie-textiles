        rdf:type           skos:Concept;
        skos:definition    "Document/message containing the demand of tax."@en;
        skos:notation      "940";
        skos:prefLabel     "Tax demand"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

