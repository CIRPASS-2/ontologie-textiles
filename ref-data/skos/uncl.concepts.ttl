<https://w3id.org/eudpp/thesauri/document/937>
        rdf:type           skos:Concept;
        skos:definition    "Document/message in which an importer states the pertinent information required by the competent body for assessment of value-added tax."@en;
        skos:notation      "937";
        skos:prefLabel     "Tax declaration (value added tax)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/936>
        rdf:type           skos:Concept;
        skos:definition    "Document/message which, according to Article 106 of the \"Agreement concerning Postal Parcels\" under the UPU Convention, must accompany post parcels and in which the contents of such parcels are specified."@en;
        skos:notation      "936";
        skos:prefLabel     "Customs declaration (post parcels)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/935>
        rdf:type           skos:Concept;
        skos:definition    "Document/message required by the Customs in an importing country in which an exporter states the invoice or other price (e.g. selling price, price of identical goods), and specifies costs for freight, insurance and packing, etc., terms of delivery and payment, for the purpose of determining the Customs value in the importing country of goods consigned to that country."@en;
        skos:notation      "935";
        skos:prefLabel     "Customs invoice"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/934>
        rdf:type           skos:Concept;
        skos:definition    "Document/message in which a declarant (importer) states the invoice or other price (e.g. selling price, price of identical goods), and specifies costs for freight, insurance and packing, etc., terms of delivery and payment, any relationship with the trading partner, etc., for the purpose of determining the Customs value of goods imported."@en;
        skos:notation      "934";
        skos:prefLabel     "Value declaration"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/933>
        rdf:type           skos:Concept;
        skos:definition    "Generic term, sometimes referred to as Freight declaration, applied to the documents providing the particulars required by the Customs concerning the cargo (freight) carried by commercial means of transport (CCC)."@en;
        skos:notation      "933";
        skos:prefLabel     "Cargo declaration (arrival)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/932>
        rdf:type           skos:Concept;
        skos:definition    "Document/message whereby a Customs authority releases goods under its control to be placed at the disposal of the party concerned. Synonym: Customs release note."@en;
        skos:notation      "932";
        skos:prefLabel     "Customs delivery note"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/931>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by an importer notifying Customs that goods have been removed from an importing means of transport to the importer's premises under a Customs- approved arrangement for immediate release, or requesting authorization to do so."@en;
        skos:notation      "931";
        skos:prefLabel     "Customs immediate release declaration"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/930>
        rdf:type           skos:Concept;
        skos:definition    "Document/message by which goods are declared for import Customs clearance according to Annex B.1 (concerning clearance for home use) to the Kyoto convention (CCC)."@en;
        skos:notation      "930";
        skos:prefLabel     "Goods declaration for home use"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/929>
        rdf:type           skos:Concept;
        skos:definition    "Document/message by which goods are declared for import Customs clearance [sister entry of 830]."@en;
        skos:notation      "929";
        skos:prefLabel     "Goods declaration for importation"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/927>
        rdf:type           skos:Concept;
        skos:definition    "Document/message completed by an importer/buyer as a means for the competent body to control that a trade transaction for which foreign exchange has been allocated has been executed and that money has been transferred in accordance with the conditions of payment and the exchange control regulations in force."@en;
        skos:notation      "927";
        skos:prefLabel     "Exchange control declaration (import)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

