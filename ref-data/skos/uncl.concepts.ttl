        skos:definition    "Negotiable document/message issued by a forwarder to certify that he has taken charge of a specified consignment for despatch and delivery in accordance with the consignor's instructions, as indicated in the document, and that he accepts responsibility for delivery of the goods to the holder of the document through the intermediary of a delivery agent of his choice. E.g. FIATA-FCT."@en;
        skos:notation      "763";
        skos:prefLabel     "Forwarder's certificate of transport"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/762>
        rdf:type           skos:Concept;
        skos:definition    "A document/message providing information regarding pricing and catalogue details for goods and/or services to be offered as part of a tender."@en;
        skos:notation      "762";
        skos:prefLabel     "Tendering price/sales catalogue"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/761>
        rdf:type           skos:Concept;
        skos:definition    "Bill of lading which evidences a contract of carriage from one place to another in separate stages of which at least one stage is a sea transit, and by which the issuing carrier accepts responsibility for the carriage as set forth in the through bill of lading."@en;
        skos:notation      "761";
        skos:prefLabel     "Through bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/760>
        rdf:type           skos:Concept;
        skos:definition    "A transport document used when more than one mode of transportation is involved in the movement of cargo. It is a contract of carriage and receipt of the cargo for a multimodal transport. It indicates the place where the responsible transport company in the move takes responsibility for the cargo, the place where the responsibility of this transport company in the move ends and the conveyances involved."@en;
        skos:notation      "760";
        skos:prefLabel     "Multimodal/combined transport document (generic)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/759>
        rdf:type           skos:Concept;
        skos:definition    "A document/message containing a self-declaration by the supplier, providing preliminary evidence during the tendering phase."@en;
        skos:notation      "759";
        skos:prefLabel     "European Single Procurement Document"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/758>
        rdf:type           skos:Concept;
        skos:definition    "A document/message used by a supplier to bid in a procurement procedure."@en;
        skos:notation      "758";
        skos:prefLabel     "Tender"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/757>
        rdf:type           skos:Concept;
        skos:definition    "A document/message requesting information regarding pricing and catalogue details for goods and/or services to be offered as part of a tender."@en;
        skos:notation      "757";
        skos:prefLabel     "Tendering price/sales catalogue request"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/756>
        rdf:type           skos:Concept;
        skos:definition    "A document/message requesting a self-declaration from the supplier, providing preliminary evidence during the tendering phase."@en;
        skos:notation      "756";
        skos:prefLabel     "European Single Procurement Document request"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/755>
        rdf:type           skos:Concept;
        skos:definition    "A document/message used by a buyer to define the procurement procedure and request specific suppliers to participate."@en;
        skos:notation      "755";
        skos:prefLabel     "Invitation to tender"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/754>
        rdf:type           skos:Concept;
        skos:definition    "A document/message used by a buyer to define the procurement procedure and request suppliers to participate."@en;
        skos:notation      "754";
        skos:prefLabel     "Call for tender"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/753>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a competent body certifying sustainability."@en;
        skos:notation      "753";
        skos:prefLabel     "Certificate of sustainability"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/752>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a competent body certifying the phytosanitary status of plants or plant products for international trade."@en;
        skos:notation      "752";
        skos:prefLabel     "Plant Passport"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/751>
        rdf:type           skos:Concept;
        skos:definition    "A document / message containing accounting related information such as monetary summations, seller id and VAT information. This may not be a complete invoice according to legal requirements. For instance the line item information might be excluded."@en;
        skos:notation      "751";
        skos:prefLabel     "Invoice information for accounting purposes"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/750>
        rdf:type           skos:Concept;
        skos:definition    "Document/message which, according to Article 106 of the \"Agreement concerning Postal Parcels\" under the UPU convention, is to accompany post parcels."@en;
        skos:notation      "750";
        skos:prefLabel     "Despatch note (post parcels)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/749>
        rdf:type           skos:Concept;
        skos:definition    "Message containing information regarding gross mass verification of transport equipment."@en;
        skos:notation      "749";
        skos:prefLabel     "Transport equipment gross mass verification message"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/748>
        rdf:type           skos:Concept;
        skos:definition    "Document/message by means of which the supplier informs the buyer about the despatch of goods ordered on consignment (goods to be delivered into stock with agreement on payment when goods are sold out of this stock)."@en;
        skos:notation      "748";
        skos:prefLabel     "Consignment despatch advice"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/747>
        rdf:type           skos:Concept;
        skos:definition    "A message sent by a party (usually an employer or its representative) to a service providing organisation, to detail payroll deductions paid on behalf of its employees to the service providing organisation."@en;
        skos:notation      "747";
        skos:prefLabel     "Payroll deductions advice"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/746>
        rdf:type           skos:Concept;
        skos:definition    "Document/message created by the consignor or by the departure station, joined to the transport or sent to the consignee, giving the possibility to the consignee or the arrival station to attest the delivery of the goods. The document must be returned to the consignor or to the departure station."@en;
        skos:notation      "746";
        skos:prefLabel     "Delivery notice (rail transport)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/745>
        rdf:type           skos:Concept;
        skos:definition    "Declaration to Customs regarding passengers aboard the conveyance; equivalent to IMO FAL 6."@en;
        skos:notation      "745";
        skos:prefLabel     "Passenger list"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/744>
        rdf:type           skos:Concept;
        skos:definition    "Declaration to Customs regarding the personal effects of crew members aboard the conveyance; equivalent to IMO FAL 4."@en;
        skos:notation      "744";
        skos:prefLabel     "Crew's effects declaration"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/743>
        rdf:type           skos:Concept;
        skos:definition    "A temporary air waybill which contains only limited information because of the absence of the original."@en;
        skos:notation      "743";
        skos:prefLabel     "Substitute air waybill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/742>
        rdf:type           skos:Concept;
        skos:definition    "Document/message providing metered consumption details."@en;
        skos:notation      "742";
        skos:prefLabel     "Metered services consumption report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/741>
        rdf:type           skos:Concept;
        skos:definition    "Document/message made out by or on behalf of the agent/consolidator which evidences the contract between the agent/consolidator and carrier(s) for carriage of goods over routes of the carrier(s) for a consignment consisting of goods originated by more than one shipper (IATA)."@en;
        skos:notation      "741";
        skos:prefLabel     "Master air waybill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/740>
        rdf:type           skos:Concept;
        skos:definition    "Document/message made out by or on behalf of the shipper which evidences the contract between the shipper and carrier(s) for carriage of goods over routes of the carrier(s) and which is identified by the airline prefix issuing the document plus a serial (IATA)."@en;
        skos:notation      "740";
        skos:prefLabel     "Air waybill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/739>
        rdf:type           skos:Concept;
        skos:definition    "Document/message providing metered consumption details supporting an invoice."@en;
        skos:notation      "739";
        skos:prefLabel     "Metered services consumption report supporting an invoice"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/738>
        rdf:type           skos:Concept;
        skos:definition    "A message from a party to a warehouse, distribution centre, or logistics service provider identifying the handling services and where required the movement of specified goods, limited to warehouses within the jurisdiction of the distribution centre or log."@en;
        skos:notation      "738";
        skos:prefLabel     "Cargo/goods handling and movement message"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/737>
        rdf:type           skos:Concept;
        skos:definition    "A message by which a consignee provides for a carrier proof of delivery of a consignment."@en;
        skos:notation      "737";
        skos:prefLabel     "Proof of delivery"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/736>
        rdf:type           skos:Concept;
        skos:definition    "A product inquiry which stands until it is cancelled. It requests not only the updates since last time, but always the complete product information of a data supplier. This means that within the standing request every time a complete download of the respective data is automatically sent to the data inquirer."@en;
        skos:notation      "736";
        skos:prefLabel     "Standing inquiry on complete product information"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/735>
        rdf:type           skos:Concept;
        skos:definition    "A message enabling companies to exchange or report electronically, basic sales data related to products or services, including the corresponding location, time period, product identification, pricing and quantity information. It enables the recipient to p."@en;
        skos:notation      "735";
        skos:prefLabel     "Sales data report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/734>
        rdf:type           skos:Concept;
        skos:definition    "A message enabling companies to exchange or report electronically, basic sales forecast data related to products or services, including the corresponding location, time period, product identification, pricing and quantity information. It enables the recip."@en;
        skos:notation      "734";
        skos:prefLabel     "Sales forecast report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/733>
        rdf:type           skos:Concept;
        skos:definition    "A message by which a party informs another party whether and how goods shall be returned."@en;
        skos:notation      "733";
        skos:prefLabel     "Instruction for returns"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/732>
        rdf:type           skos:Concept;
        skos:definition    "A message by which a party announces to another party details of goods for return due to specified reasons (e.g. returns for repair, returns because of damage, etc)."@en;
        skos:notation      "732";
        skos:prefLabel     "Announcement for returns"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/731>
        rdf:type           skos:Concept;
        skos:definition    "A message enabling the transmission of commercial data concerning payments made and outstanding items on an account over a period of time."@en;
        skos:notation      "731";
        skos:prefLabel     "Commercial account summary"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/730>
        rdf:type           skos:Concept;
        skos:definition    "Transport document/message which evidences a contract between a carrier and a sender for the carriage of goods by road (generic term). Remark: For international road traffic, this document must contain at least the particulars prescribed by the convention on the contract for the international carriage of goods by road (CMR)."@en;
        skos:notation      "730";
        skos:prefLabel     "Road consignment note"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/729>
        rdf:type           skos:Concept;
        skos:definition    "Document/message by means of which the buyer informs the seller about the despatch of returned goods."@en;
        skos:notation      "729";
        skos:prefLabel     "Returns advice"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/728>
        rdf:type           skos:Concept;
        skos:definition    "A price/sales catalogue message containing only commercial terms or conditions data."@en;
        skos:notation      "728";
        skos:prefLabel     "Price/sales catalogue containing commercial information"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/727>
        rdf:type           skos:Concept;
        skos:definition    "A price/sales catalogue message containing no commercial information, such as prices, terms or conditions."@en;
        skos:notation      "727";
        skos:prefLabel     "Price/sales catalogue not containing commercial information"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/726>
        rdf:type           skos:Concept;
        skos:definition    "Document/message providing details of a consignment order which has been raised by a manufacturer."@en;
        skos:notation      "726";
        skos:prefLabel     "Manufacturer raised consignment order"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/725>
        rdf:type           skos:Concept;
        skos:definition    "Document/message providing details of an order which has been raised by a manufacturer."@en;
        skos:notation      "725";
        skos:prefLabel     "Manufacturer raised order"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/724>
        rdf:type           skos:Concept;
        skos:definition    "Fictitious transport document regarding a previous transport, enabling a carrier's agent to give to another carrier's agent (in a different country) the possibility to collect charges relating to the original transport (rail environment)."@en;
        skos:notation      "724";
        skos:prefLabel     "Recharging document"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/723>
        rdf:type           skos:Concept;
        skos:definition    "Document/message which gives right to the owner to exert all functions normally transferred to a guard in a train by which an escorted consignment is transported."@en;
        skos:notation      "723";
        skos:prefLabel     "Escort official recognition"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/722>
        rdf:type           skos:Concept;
        skos:definition    "Accounting document, one copy of which is drawn up for each consignment note; it accompanies the consignment over the whole route and is a rail transport document."@en;
        skos:notation      "722";
        skos:prefLabel     "Road list-SMGS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/721>
        rdf:type           skos:Concept;
        skos:definition    "Document/message responding to a previously received Product Data document/message."@en;
        skos:notation      "721";
        skos:prefLabel     "Product data response"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/720>
        rdf:type           skos:Concept;
        skos:definition    "Transport document constituting a contract for the carriage of goods between the sender and the carrier (the railway). For international rail traffic, this document must conform to the model prescribed by the international conventions concerning carriage of goods by rail, e.g. CIM Convention, SMGS Convention."@en;
        skos:notation      "720";
        skos:prefLabel     "Rail consignment note (generic term)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/719>
        rdf:type           skos:Concept;
        skos:definition    "Document/message providing agreed textual information."@en;
        skos:notation      "719";
        skos:prefLabel     "General message"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/718>
        rdf:type           skos:Concept;
        skos:definition    "A national identity document issued to professional seamen that contains a record of their rank and service career."@en;
        skos:notation      "718";
        skos:prefLabel     "Seaman’s book"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/717>
        rdf:type           skos:Concept;
        skos:definition    "A document authorizing residence."@en;
        skos:notation      "717";
        skos:prefLabel     "Residence permit"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/716>
        rdf:type           skos:Concept;
        skos:definition    "Non-negotiable document issued by a freight forwarder evidencing a contract for the carriage of goods by sea and the taking over or loading of the goods by the freight forwarder, and by which the freight forwarder undertakes to deliver the goods to the consignee named in the document."@en;
        skos:notation      "716";
        skos:prefLabel     "Forwarder's bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/715>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a commercial party or a bank of an insurance company accepting responsibility to the beneficiary of the indemnity in accordance with the terms thereof."@en;
        skos:notation      "715";
        skos:prefLabel     "Letter of indemnity for non-surrender of bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/714>
        rdf:type           skos:Concept;
        skos:definition    "The bill of lading issued not by the carrier but by the freight forwarder/consolidator known by the carrier."@en;
        skos:notation      "714";
        skos:prefLabel     "House bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/713>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a ship's officer to acknowledge that a specified consignment has been received on board a vessel, and the apparent condition of the goods; enabling the carrier to issue a Bill of lading."@en;
        skos:notation      "713";
        skos:prefLabel     "Mate's receipt"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/712>
        rdf:type           skos:Concept;
        skos:definition    "Non-negotiable document which evidences a contract for the carriage of goods by sea and the taking over or loading of the goods by the carrier, and by which the carrier undertakes to deliver the goods to the consignee named in the document. E.g. Sea waybill. Remark: Synonymous with \"straight\" or \"non-negotiable Bill of lading\" used in certain countries, e.g. Canada."@en;
        skos:notation      "712";
        skos:prefLabel     "Non-negotiable maritime transport document (generic)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/711>
        rdf:type           skos:Concept;
        skos:definition    "Negotiable transport document made out to a named person, to order or to bearer, signed by the carrier and handed to the sender after receipt of the goods."@en;
        skos:notation      "711";
        skos:prefLabel     "Inland waterway bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/710>
        rdf:type           skos:Concept;
        skos:definition    "Non-negotiable document which evidences a contract for the carriage of goods by sea and the taking over of the goods by the carrier, and by which the carrier undertakes to deliver the goods to the consignee named in the document."@en;
        skos:notation      "710";
        skos:prefLabel     "Sea waybill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/709>
        rdf:type           skos:Concept;
        skos:definition    "Document which evidences a transport of liquid bulk cargo."@en;
        skos:notation      "709";
        skos:prefLabel     "Tanker bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/708>
        rdf:type           skos:Concept;
        skos:definition    "Bill of lading indicating an empty container."@en;
        skos:notation      "708";
        skos:prefLabel     "Empty container bill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/707>
        rdf:type           skos:Concept;
        skos:definition    "A copy of the bill of lading issued by a transport company."@en;
        skos:notation      "707";
        skos:prefLabel     "Bill of lading copy"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/706>
        rdf:type           skos:Concept;
        skos:definition    "The original of the bill of lading issued by a transport company. When issued by the maritime industry it could signify ownership of the cargo."@en;
        skos:notation      "706";
        skos:prefLabel     "Bill of lading original"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/705>
        rdf:type           skos:Concept;
        skos:definition    "Negotiable document/message which evidences a contract of carriage by sea and the taking over or loading of goods by carrier, and by which carrier undertakes to deliver goods against surrender of the document. A provision in the document that goods are to be delivered to the order of a named person, or to order, or to bearer, constitutes such an undertaking."@en;
        skos:notation      "705";
        skos:prefLabel     "Bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/704>
        rdf:type           skos:Concept;
        skos:definition    "A bill of lading issued by the master of a vessel (in actuality the owner or charterer of the vessel). It could cover a number of house bills."@en;
        skos:notation      "704";
        skos:prefLabel     "Master bill of lading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/703>
        rdf:type           skos:Concept;
        skos:definition    "The document made out by an agent/consolidator which evidences the contract between the shipper and the agent/consolidator for the arrangement of carriage of goods."@en;
        skos:notation      "703";
        skos:prefLabel     "House waybill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/702>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a carrier or a carrier's agent, acknowledging receipt for carriage of goods specified therein on conditions stated or referred to in the document, enabling the carrier to issue a transport document."@en;
        skos:notation      "702";
        skos:prefLabel     "Goods receipt, carriage"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/701>
        rdf:type           skos:Concept;
        skos:definition    "Document/message evidencing a contract of carriage covering the movement of goods by any mode of transport, or combination of modes, for national as well as international transport, under any applicable international convention or national law and under the conditions of carriage of any carrier or transport operator undertaking or arranging the transport referred to in the document."@en;
        skos:notation      "701";
        skos:prefLabel     "Universal (multipurpose) transport document"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/700>
        rdf:type           skos:Concept;
        skos:definition    "Non-negotiable document evidencing the contract for the transport of cargo."@en;
        skos:notation      "700";
        skos:prefLabel     "Waybill"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/659>
        rdf:type           skos:Concept;
        skos:definition    "A partial bayplan. containing only a selected part of the available stowage locations."@en;
        skos:notation      "659";
        skos:prefLabel     "Bayplan/stowage plan, partial"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/658>
        rdf:type           skos:Concept;
        skos:definition    "A full bayplan containing all occupied and/or blocked stowage locations."@en;
        skos:notation      "658";
        skos:prefLabel     "Bayplan/stowage plan, full"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/657>
        rdf:type           skos:Concept;
        skos:definition    "A message/document consistent with the model for re- export phytosanitary certificates of the IPPC, attesting that a consignment meets phytosanitary import requirements."@en;
        skos:notation      "657";
        skos:prefLabel     "Phytosanitary Re-export Certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/656>
        rdf:type           skos:Concept;
        skos:definition    "Document/message providing information on a resale."@en;
        skos:notation      "656";
        skos:prefLabel     "Resale information"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/655>
        rdf:type           skos:Concept;
        skos:definition    "Document/message authorizing goods specified therein to be brought out of a fenced-in port or terminal area."@en;
        skos:notation      "655";
        skos:prefLabel     "Gate pass"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/654>
        rdf:type           skos:Concept;
        skos:definition    "A declaration to be presented to the competent authority when radioactive material moves cross-border."@en;
        skos:notation      "654";
        skos:prefLabel     "Declaration for radioactive material"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/653>
        rdf:type           skos:Concept;
        skos:definition    "Correspondence previously exchanged."@en;
        skos:notation      "653";
        skos:prefLabel     "Previous correspondence"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/652>
        rdf:type           skos:Concept;
        skos:definition    "An official letter issued by an import authority granted to the importer of goods from a low risk country which allows the importer to place its products in the local market with certain favorable considerations."@en;
        skos:notation      "652";
        skos:prefLabel     "Low risk country formal letter"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/651>
        rdf:type           skos:Concept;
        skos:definition    "A license granted by a competent authority to a manufacturer for production of specific products."@en;
        skos:notation      "651";
        skos:prefLabel     "Manufacturing license"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/650>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a cargo handling organization (port administration, terminal operator, etc.) for the removal or other handling of goods under their care."@en;
        skos:notation      "650";
        skos:prefLabel     "Handling order"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/649>
        rdf:type           skos:Concept;
        skos:definition    "A license granted by a competent authority to a production facility for manufacturing specific products."@en;
        skos:notation      "649";
        skos:prefLabel     "Production facility license"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/648>
        rdf:type           skos:Concept;
        skos:definition    "Organization for Animal Health (OIE) A certification that the products have been treated in a way consistent with the standards set by the World Organization for Animal Health (OIE)."@en;
        skos:notation      "648";
        skos:prefLabel     "Certificate of compliance with standards of the World"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/647>
        rdf:type           skos:Concept;
        skos:definition    "A document containing results from the study which determines the shelf life, namely the time period of storage at a specified condition within which a drug substance or drug product still meets its established specifications; its identity, strength, quality and purity."@en;
        skos:notation      "647";
        skos:prefLabel     "Drug shelf life study report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/646>
        rdf:type           skos:Concept;
        skos:definition    "A certification executed by the competent authority from country of production stating the price of the goods to the general public."@en;
        skos:notation      "646";
        skos:prefLabel     "Public price certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/645>
        rdf:type           skos:Concept;
        skos:definition    "A certification executed by the competent authority from country of exportation stating the export price of the goods."@en;
        skos:notation      "645";
        skos:prefLabel     "Export price certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/644>
        rdf:type           skos:Concept;
        skos:definition    "A document that shows the main structure that composes the packaging material."@en;
        skos:notation      "644";
        skos:prefLabel     "Packaging material composition report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/643>
        rdf:type           skos:Concept;
        skos:definition    "A document legalized from a competent authority that shows that the food packaging product is safe to come into contact with food."@en;
        skos:notation      "643";
        skos:prefLabel     "Food packaging contact certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/642>
        rdf:type           skos:Concept;
        skos:definition    "A certificate to verify readiness of a transport or transport area such as a reservoir or hold to transport food items."@en;
        skos:notation      "642";
        skos:prefLabel     "Certificate of food item transport readiness"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/641>
        rdf:type           skos:Concept;
        skos:definition    "A report of temperature readings over a period."@en;
        skos:notation      "641";
        skos:prefLabel     "Thermographic reading report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/640>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a party entitled to authorize the release of goods specified therein to a named consignee, to be retained by the custodian of the goods."@en;
        skos:notation      "640";
        skos:prefLabel     "Delivery order"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/639>
        rdf:type           skos:Concept;
        skos:definition    "Inspection document shows that the container, the cooling devices and measured temperature is in good working condition."@en;
        skos:notation      "639";
        skos:prefLabel     "Certificate of refrigerated transport equipment inspection"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/638>
        rdf:type           skos:Concept;
        skos:definition    "Certificate of inspection for the vessel stating its readiness and suitability for transporting grains and legumes."@en;
        skos:notation      "638";
        skos:prefLabel     "Certificate of suitability for transport of grains and legumes"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/637>
        rdf:type           skos:Concept;
        skos:definition    "A document that shows that the product (food additive, detergent, disinfectant and sanitizer) is suitable to be used in the food industry."@en;
        skos:notation      "637";
        skos:prefLabel     "Food grade certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/636>
        rdf:type           skos:Concept;
        skos:definition    "A document legalized from a competent authority that shows that the product has been tested microbiologically and is free from any pathogens and fit for human consumption and/or declares that the product is in compliance with sanitary and phytosanitary measures."@en;
        skos:notation      "636";
        skos:prefLabel     "Health certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/635>
        rdf:type           skos:Concept;
        skos:definition    "Negotiable receipt document, issued by a Warehouse Keeper to a person placing goods in a warehouse and conferring title to the goods stored."@en;
        skos:notation      "635";
        skos:prefLabel     "Warehouse warrant"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/634>
        rdf:type           skos:Concept;
        skos:definition    "A document legalized from a competent authority that shows the components of the product (food additive, detergent, disinfectant and sanitizer)."@en;
        skos:notation      "634";
        skos:prefLabel     "Certified list of ingredients"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/633>
        rdf:type           skos:Concept;
        skos:definition    "Documents/messages specifying services rendered, storage and handling costs, demurrage and other charges due to the owner of goods described therein."@en;
        skos:notation      "633";
        skos:prefLabel     "Port charges documents"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/632>
        rdf:type           skos:Concept;
        skos:definition    "Document/message to acknowledge the receipt of goods and in addition may indicate receiving conditions."@en;
        skos:notation      "632";
        skos:prefLabel     "Goods receipt"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/631>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a forwarder acting as Warehouse Keeper acknowledging receipt of goods placed in a warehouse, and stating or referring to the conditions which govern the warehousing and the release of goods. The document contains detailed provisions regarding the rights of holders-by-endorsement, transfer of ownership, etc. E.g. FIATA-FWR."@en;
        skos:notation      "631";
        skos:prefLabel     "Forwarder's warehouse receipt"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/630>
        rdf:type           skos:Concept;
        skos:definition    "(1123) Document/message provided by the shipper or his agent to the carrier, multimodal transport operator, terminal or other receiving authority, giving information about export consignments offered for transport, and providing for the necessary receipts and declarations of liability. Sometimes a multipurpose cargo handling document also fulfilling the functions of document 632, 633, 650 and 655."@en;
        skos:notation      "630";
        skos:prefLabel     "Shipping note"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/629>
        rdf:type           skos:Concept;
        skos:definition    "A certification that livestock or animal products, that are either imported or entering free zones, are kept under health supervision for a time period determined by veterinary quarantine instructions."@en;
        skos:notation      "629";
        skos:prefLabel     "Veterinary quarantine certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/628>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by the competent body in accordance with transit regulations in force, by which authorization is granted to a party to move articles under customs procedure."@en;
        skos:notation      "628";
        skos:prefLabel     "Transit license"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/627>
        rdf:type           skos:Concept;
        skos:definition    "A certificate confirming that a specified product is free for sale in the country of origin."@en;
        skos:notation      "627";
        skos:prefLabel     "Free Sale Certificate in the Country of Origin"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/626>
        rdf:type           skos:Concept;
        skos:definition    "Wild Fauna and Flora (CITES) Certificate A certificate used in the trade of endangered species in accordance with the CITES convention."@en;
        skos:notation      "626";
        skos:prefLabel     "Convention on International Trade in Endangered Species of"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/625>
        rdf:type           skos:Concept;
        skos:definition    "A certificate verifying the heat treatment of the product is in conformance with international standards to ensure the product’s healthiness and/or shows the mode of heat treatment indicating the temperature and the amount of time the product or raw material used in the product was treated (such as milk)."@en;
        skos:notation      "625";
        skos:prefLabel     "Heat Treatment Certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/624>
        rdf:type           skos:Concept;
        skos:definition    "Non-negotiable document issued by a forwarder to certify that he has assumed control of a specified consignment, with irrevocable instructions to send it to the consignee indicated in the document or to hold it at his disposal. E.g. FIATA-FCR."@en;
        skos:notation      "624";
        skos:prefLabel     "Forwarder's certificate of receipt"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/623>
        rdf:type           skos:Concept;
        skos:definition    "Invoice issued by a freight forwarder specifying services rendered and costs incurred and claiming payment therefore."@en;
        skos:notation      "623";
        skos:prefLabel     "Forwarder's invoice"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/622>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a freight forwarder informing an exporter of the action taken in fulfillment of instructions received."@en;
        skos:notation      "622";
        skos:prefLabel     "Forwarder's advice to exporter"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/621>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued by a freight forwarder in an exporting country advising his counterpart in an importing country about the forwarding of goods described therein."@en;
        skos:notation      "621";
        skos:prefLabel     "Forwarder's advice to import agent"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/610>
        rdf:type           skos:Concept;
        skos:definition    "Document/message issued to a freight forwarder, giving instructions regarding the action to be taken by the forwarder for the forwarding of goods described therein."@en;
        skos:notation      "610";
        skos:prefLabel     "Forwarding instructions"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/589>
        rdf:type           skos:Concept;
        skos:definition    "A certificate verifying that meat has been produced from slaughter in accordance with Islamic laws and practices."@en;
        skos:notation      "589";
        skos:prefLabel     "Halal Slaughtering Certificate"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/588>
        rdf:type           skos:Concept;
        skos:definition    "A document reporting the security status and related information of a means of transport."@en;
        skos:notation      "588";
        skos:prefLabel     "Transport Means Security Report"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/587>
        rdf:type           skos:Concept;
        skos:definition    "A Customs declaration in which goods move under cover of TIR Carnets."@en;
        skos:notation      "587";
        skos:prefLabel     "Customs declaration for TIR Carnet goods"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/586>
        rdf:type           skos:Concept;
        skos:definition    "San Marino (T2LSM) Form establishing the Community status of goods (\"T2L\" under European Legislation) in the context of trade between the EU and San Marino. (\"T2LSM\" under EU Legislation)."@en;
        skos:notation      "586";
        skos:prefLabel     "Document for establishing the Customs Status of goods for"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/585>
        rdf:type           skos:Concept;
        skos:definition    "for certain fiscal purposes (T2LF) Form establishing the Community status of goods in the context of trade between the \"VAT\" territory of EU Member States and EU territories where the VAT rules do not apply, such as Canary islands, some French overseas territories, the Channel islands and the Aaland islands, and between those territories (\"T2LF\" under EU Legislation)."@en;
        skos:notation      "585";
        skos:prefLabel     "EU Document for establishing the Community status of goods"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/584>
        rdf:type           skos:Concept;
        skos:definition    "(T2L) Form establishing the Community status of goods (\"T2L\" under EU Legislation)."@en;
        skos:notation      "584";
        skos:prefLabel     "EU Document for establishing the Community status of goods"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/583>
        rdf:type           skos:Concept;
        skos:definition    "Customs declaration for goods under the Community/common transit procedure for mixed consignments (i.e. consignments that comprise goods of different statuses, like \"T1\" and \"T2\") (\"T\" under EU Legislation)."@en;
        skos:notation      "583";
        skos:prefLabel     "EU Customs declaration for mixed consignments (T)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/582>
        rdf:type           skos:Concept;
        skos:definition    "(T2SM) Customs declaration for goods under the internal Community transit procedure between the Community and San Marino. (\"T2SM\" under EU Legislation)."@en;
        skos:notation      "582";
        skos:prefLabel     "EU Customs declaration for internal transit to San Marino"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/document> .

<https://w3id.org/eudpp/thesauri/document/581>
        rdf:type           skos:Concept;
        skos:definition    "Community Transit (T2F) Declaration for goods under the internal Community transit procedure in the context of trade between the \"VAT\" territory of EU Member States and EU territories where the VAT rules do not apply, such as Canary islands, some French overseas territories, the Channel islands and the Aaland islands, and between those territories. (\"T2F\" under EU Legislation)."@en;
