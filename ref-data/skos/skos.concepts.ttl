<https://w3id.org/eudpp/thesauri/date_time_format/719>
        rdf:type           skos:Concept;
        skos:definition    "A period of time which includes the century, year, month, day, hour and minute. Format of period to be given in actual message without hyphen."@en;
        skos:notation      "719";
        skos:prefLabel     "CCYYMMDDHHMM-CCYYMMDDHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/720>
        rdf:type           skos:Concept;
        skos:definition    "Format of period to be given without hyphen (D=day of the week, 1=Monday; 2=Tuesday; ... 7=Sunday)."@en;
        skos:notation      "720";
        skos:prefLabel     "DHHMM-DHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/801>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of years."@en;
        skos:notation      "801";
        skos:prefLabel     "Year"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/802>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of months."@en;
        skos:notation      "802";
        skos:prefLabel     "Month"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/803>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of weeks."@en;
        skos:notation      "803";
        skos:prefLabel     "Week"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/804>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of days."@en;
        skos:notation      "804";
        skos:prefLabel     "Day"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/805>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of hours."@en;
        skos:notation      "805";
        skos:prefLabel     "Hour"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/806>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of minutes."@en;
        skos:notation      "806";
        skos:prefLabel     "Minute"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/807>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of seconds."@en;
        skos:notation      "807";
        skos:prefLabel     "Second"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/808>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of semesters (six months)."@en;
        skos:notation      "808";
        skos:prefLabel     "Semester"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/809>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of four months periods."@en;
        skos:notation      "809";
        skos:prefLabel     "Four months period"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/810>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of trimesters (three months)."@en;
        skos:notation      "810";
        skos:prefLabel     "Trimester"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/811>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of half months."@en;
        skos:notation      "811";
        skos:prefLabel     "Half month"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/812>
        rdf:type           skos:Concept;
        skos:definition    "To indicate a quantity of ten days periods."@en;
        skos:notation      "812";
        skos:prefLabel     "Ten days"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/813>
        rdf:type           skos:Concept;
        skos:definition    "Numeric representation of the day (Monday = 1)."@en;
        skos:notation      "813";
        skos:prefLabel     "Day of the week"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/814>
        rdf:type           skos:Concept;
        skos:definition    "Number of working days."@en;
        skos:notation      "814";
        skos:prefLabel     "Working days"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/718>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start date followed by the end date (both including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "718";
        skos:prefLabel     "CCYYMMDD-CCYYMMDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/717>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start date followed by the end date (both not including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "717";
        skos:prefLabel     "YYMMDD-YYMMDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/716>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start week of a year followed by the end week of year (both including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "716";
        skos:prefLabel     "CCYYWW-CCYYWW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/715>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start week of a year followed by the end week of year (both not including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "715";
        skos:prefLabel     "YYWW-YYWW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/713>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start time followed by the end time (format year, month, day, hour and minute). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "713";
        skos:prefLabel     "YYMMDDHHMM-YYMMDDHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/710>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start month of a year followed by the end month of a year (both including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "710";
        skos:prefLabel     "CCYYMM-CCYYMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/709>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start month of a year followed by the end month of a year (both not including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "709";
        skos:prefLabel     "YYMM-YYMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/708>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start quarter of a year followed by the end quarter of year (both including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "708";
        skos:prefLabel     "CCYYQ-CCYYQ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/707>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start quarter of a year followed by the end quarter of year (both not including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "707";
        skos:prefLabel     "YYQ-YYQ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/706>
        rdf:type           skos:Concept;
        skos:definition    "Format of period to be given without hyphen (P = period of 4 months)."@en;
        skos:notation      "706";
        skos:prefLabel     "CCYYP-CCYYP"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/705>
        rdf:type           skos:Concept;
        skos:definition    "Format of period to be given without hyphen (P = period of 4 months)."@en;
        skos:notation      "705";
        skos:prefLabel     "YYPYYP"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/704>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start semester of a year followed by the end semester of a year (both including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "704";
        skos:prefLabel     "CCYYS-CCYYS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/703>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start semester of a year followed by the end semester of a year (both not including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "703";
        skos:prefLabel     "YYS-YYS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/702>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start year followed by the end year (both including century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "702";
        skos:prefLabel     "CCYY-CCYY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/701>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start year followed by the end year (both without century). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "701";
        skos:prefLabel     "YY-YY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/616>
        rdf:type           skos:Concept;
        skos:definition    "Week within a calendar year: CC = Century; Y = Year; W = Week (1st week of January = week 01)."@en;
        skos:notation      "616";
        skos:prefLabel     "CCYYWW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/615>
        rdf:type           skos:Concept;
        skos:definition    "Week within a calendar year: Y = Year; W = Week 1st week of January = week 01."@en;
        skos:notation      "615";
        skos:prefLabel     "YYWW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/614>
        rdf:type           skos:Concept;
        skos:definition    "To specifiy a ten-day period within a month of a year, including century  (A = ten day period)."@en;
        skos:notation      "614";
        skos:prefLabel     "CCYYMMA"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/613>
        rdf:type           skos:Concept;
        skos:definition    "To specifiy a ten-day period within a month of a year (A = ten day period)."@en;
        skos:notation      "613";
        skos:prefLabel     "YYMMA"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/610>
        rdf:type           skos:Concept;
        skos:definition    "Month within a calendar year: CC = Century; Y = Year; M = Month."@en;
        skos:notation      "610";
        skos:prefLabel     "CCYYMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/609>
        rdf:type           skos:Concept;
        skos:definition    "Month within a calendar year: Y = Year; M = Month."@en;
        skos:notation      "609";
        skos:prefLabel     "YYMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/608>
        rdf:type           skos:Concept;
        skos:definition    "Quarter in a calendar year: C = Century; Y = Year; Q = Quarter."@en;
        skos:notation      "608";
        skos:prefLabel     "CCYYQ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/604>
        rdf:type           skos:Concept;
        skos:definition    "Semester in a calendar year: C = Century; Y = Year; S = Semester."@en;
        skos:notation      "604";
        skos:prefLabel     "CCYYS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/603>
        rdf:type           skos:Concept;
        skos:definition    "Semester in a calendar year: Y = Year; S = Semester."@en;
        skos:notation      "603";
        skos:prefLabel     "YYS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/602>
        rdf:type           skos:Concept;
        skos:definition    "Calendar year including century: C = Century; Y = Year."@en;
        skos:notation      "602";
        skos:prefLabel     "CCYY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/601>
        rdf:type           skos:Concept;
        skos:definition    "Calendar year: Y = Year."@en;
        skos:notation      "601";
        skos:prefLabel     "YY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/600>
        rdf:type           skos:Concept;
        skos:definition    "Century."@en;
        skos:notation      "600";
        skos:prefLabel     "CC"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/503>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start time followed by the end time (both expressed by hours minutes, seconds and time zone). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "503";
        skos:prefLabel     "HHMMSSZZZ-HHMMSSZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/502>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start time followed by the end time (both expressed by hours minutes and seconds). Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "502";
        skos:prefLabel     "HHMMSS-HHMMSS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/501>
        rdf:type           skos:Concept;
        skos:definition    "Time span without seconds: H = Hour; m = Minute;."@en;
        skos:notation      "501";
        skos:prefLabel     "HHMMHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/406>
        rdf:type           skos:Concept;
        skos:definition    "Offset from Coordinated Universal Time (UTC) where Z is plus (+) or minus (-)."@en;
        skos:notation      "406";
        skos:prefLabel     "ZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/405>
        rdf:type           skos:Concept;
        skos:definition    "Time without hours: m=minutes, s=seconds."@en;
        skos:notation      "405";
        skos:prefLabel     "MMMMSS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/404>
        rdf:type           skos:Concept;
        skos:definition    "See 402 plus Z=Time zone."@en;
        skos:notation      "404";
        skos:prefLabel     "HHMMSSZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/402>
        rdf:type           skos:Concept;
        skos:definition    "Time with seconds: H = Hour; m = Minute; s = Seconds."@en;
        skos:notation      "402";
        skos:prefLabel     "HHMMSS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/401>
        rdf:type           skos:Concept;
        skos:definition    "Time without seconds: H = Hour; m = Minute."@en;
        skos:notation      "401";
        skos:prefLabel     "HHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/308>
        rdf:type           skos:Concept;
        skos:definition    "A period of time which includes the century, year, month, day, hour and minute and time zone. Format of period to be given in actual message without hyphen."@en;
        skos:notation      "308";
        skos:prefLabel     "CCYYMMDDHHMMZZZ-CCYYMMDDHHMMZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/307>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with seconds and milliseconds C = century, Y = year, M = month, D = day, H = hour, M = minute, S = second, F = millisecond."@en;
        skos:notation      "307";
        skos:prefLabel     "CCYYMMDDHHMMSSFFF"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/306>
        rdf:type           skos:Concept;
        skos:definition    "Day, hours, minutes; D = Day; H = Hour; M = Minute."@en;
        skos:notation      "306";
        skos:prefLabel     "DDHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/305>
        rdf:type           skos:Concept;
        skos:definition    "Month, day, hours, minutes; M = Month; D = Day; H = Hour; M = Minute."@en;
        skos:notation      "305";
        skos:prefLabel     "MMDDHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/304>
        rdf:type           skos:Concept;
        skos:definition    "See 204 plus Z=Time zone."@en;
        skos:notation      "304";
        skos:prefLabel     "CCYYMMDDHHMMSSZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/303>
        rdf:type           skos:Concept;
        skos:definition    "See 203 plus Z=Time zone."@en;
        skos:notation      "303";
        skos:prefLabel     "CCYYMMDDHHMMZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/302>
        rdf:type           skos:Concept;
        skos:definition    "See 202 + Z = Time zone."@en;
        skos:notation      "302";
        skos:prefLabel     "YYMMDDHHMMSSZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/301>
        rdf:type           skos:Concept;
        skos:definition    "See 201 + Z = Time zone."@en;
        skos:notation      "301";
        skos:prefLabel     "YYMMDDHHMMZZZ"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/210>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start time followed by the end time (both expressed by hours, minutes, seconds and time zone leading plus/minus sign and time zone difference in hours and minutes)."@en;
        skos:notation      "210";
        skos:prefLabel     "HHMMSSZHHMM-HHMMSSZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/209>
        rdf:type           skos:Concept;
        skos:definition    "Time with seconds and with Time Zone: H = Hour; M = Minute, S = Seconds, Z = leading plus/minus sign, HHMM = difference to UTC in Hours and Minutes."@en;
        skos:notation      "209";
        skos:prefLabel     "HHMMSSZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/208>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with seconds, with Time Zone: C = Century, Y = Year; M = Month; D = Day; H = Hour; M = Minute, S = Seconds, Z = leading plus/minus sign, HHMM = difference to UTC in Hours and Minutes."@en;
        skos:notation      "208";
        skos:prefLabel     "CCYYMMDDHHMMSSZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/207>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with seconds, with Time Zone: Y = Year; M = Month; D = Day; H = Hour; M = Minute, S = Seconds Z = leading plus/minus sign, HHMM = difference to UTC in Hours and Minutes."@en;
        skos:notation      "207";
        skos:prefLabel     "YYMMDDHHMMSSZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/206>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time without seconds, with Time Zone: Y = Year; M = Month; D = Day; H = Hour; M = Minute, Z = leading plus/minus sign, HHMM = difference to UTC in Hours and Minutes."@en;
        skos:notation      "206";
        skos:prefLabel     "YYMMDDHHMMZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/205>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time and time zone expressed in hours and minutes. ZHHMM = time zone given as offset from Coordinated Universal Time (UTC)."@en;
        skos:notation      "205";
        skos:prefLabel     "CCYYMMDDHHMMZHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/204>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with seconds: C=Century;Y=Year; M=Month;D=Day;H=Hour;M=Minute;S=Second."@en;
        skos:notation      "204";
        skos:prefLabel     "CCYYMMDDHHMMSS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/203>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with minutes: C=Century; Y=Year; M=Month; D=Day; H=Hour; M=Minutes."@en;
        skos:notation      "203";
        skos:prefLabel     "CCYYMMDDHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/202>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with seconds: Y = Year; M = Month; D = Day; H = Hour; m = Minutes = Seconds."@en;
        skos:notation      "202";
        skos:prefLabel     "YYMMDDHHMMSS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/201>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time without seconds: Y = Year; M = Month; D = Day; H = Hour; M = Minute."@en;
        skos:notation      "201";
        skos:prefLabel     "YYMMDDHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/110>
        rdf:type           skos:Concept;
        skos:definition    "Day's number within is a specific month: D = Day."@en;
        skos:notation      "110";
        skos:prefLabel     "DD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/109>
        rdf:type           skos:Concept;
        skos:definition    "Month's number within a specific year: M = Month."@en;
        skos:notation      "109";
        skos:prefLabel     "MM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/108>
        rdf:type           skos:Concept;
        skos:definition    "Week's number within a specific year: W = Week."@en;
        skos:notation      "108";
        skos:prefLabel     "WW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/107>
        rdf:type           skos:Concept;
        skos:definition    "Day's number within a specific year: D = Day."@en;
        skos:notation      "107";
        skos:prefLabel     "DDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/2>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date: D = Day; M = Month; Y = Year."@en;
        skos:notation      "2";
        skos:prefLabel     "DDMMYY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/3>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date: M = Month; D = Day; Y = Year."@en;
        skos:notation      "3";
        skos:prefLabel     "MMDDYY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/4>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date C=Century; Y=Year; M=Month; D=Day."@en;
        skos:notation      "4";
        skos:prefLabel     "DDMMCCYY"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/5>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date and time: C=Century; Y=Year; M=Month; D=Day; H=Hour; M=Minute."@en;
        skos:notation      "5";
        skos:prefLabel     "DDMMCCYYHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/6>
        rdf:type           skos:Concept;
        skos:definition    "Half-month: CC=century YY=year MM=month, B=1:first half month, B=2:second half month."@en;
        skos:notation      "6";
        skos:prefLabel     "CCYYMMB"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/7>
        rdf:type           skos:Concept;
        skos:definition    "Week within a calendar month: CC=century YY=year MM=month. W=1-5 first week to fifth week in a month."@en;
        skos:notation      "7";
        skos:prefLabel     "CCYYMMW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/8>
        rdf:type           skos:Concept;
        skos:definition    "Shift within a calendar day: CC=century YY=year MM=month DD=day S=1-9 shift in a day."@en;
        skos:notation      "8";
        skos:prefLabel     "CCYYMMDDS"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/9>
        rdf:type           skos:Concept;
        skos:definition    "Time period within a calendar day: CC=century YY=year MM=month DD=day PP=00-99 time period."@en;
        skos:notation      "9";
        skos:prefLabel     "CCYYMMDDPP"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/10>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date including time with minutes: C=Century; Y=Year; M=Month; D=Day; T=Time designator; H=Hour; M=Minutes. The character [T] shall be used as time designator to indicate the start of the representation of the time. For example: 20010912T1433."@en;
        skos:notation      "10";
        skos:prefLabel     "CCYYMMDDTHHMM"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/101>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date: Y = Year; M = Month; D = Day."@en;
        skos:notation      "101";
        skos:prefLabel     "YYMMDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/102>
        rdf:type           skos:Concept;
        skos:definition    "Calendar date: C = Century ; Y = Year ; M = Month ; D = Day."@en;
        skos:notation      "102";
        skos:prefLabel     "CCYYMMDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/103>
        rdf:type           skos:Concept;
        skos:definition    "Calendar week day: Y = Year ; W = Week ; D = Day Week number 01 is always first week of January Day number 1 is always Monday."@en;
        skos:notation      "103";
        skos:prefLabel     "YYWWD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/104>
        rdf:type           skos:Concept;
        skos:definition    "A period of time specified by giving the start week of a month followed by the end week of a month. Data is to be transmitted as consecutive characters without hyphen."@en;
        skos:notation      "104";
        skos:prefLabel     "MMWW-MMWW"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/105>
        rdf:type           skos:Concept;
        skos:definition    "Calendar day: Y = Year ; D = Day January the first = Day 001 Always start numbering the days of the year from January 1st through December 31st."@en;
        skos:notation      "105";
        skos:prefLabel     "YYDDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

<https://w3id.org/eudpp/thesauri/date_time_format/106>
        rdf:type           skos:Concept;
        skos:definition    "Day of a month: M = Month; D = Day."@en;
        skos:notation      "106";
        skos:prefLabel     "MMDD"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/date_time_format> .

