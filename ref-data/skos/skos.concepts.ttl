        rdf:type           skos:Concept;
        skos:definition    "[3160] Place at which the goods have been received."@en;
        skos:notation      "4";
        skos:prefLabel     "Goods receipt place"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

