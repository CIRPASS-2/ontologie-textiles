        skos:notation      "370";
        skos:prefLabel     "Social Security Administration (SSA)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/369>
