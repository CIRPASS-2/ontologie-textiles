        skos:definition    "[3348] Place where the goods are taken over by the carrier."@en;
        skos:notation      "10";
        skos:prefLabel     "Place of acceptance"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

