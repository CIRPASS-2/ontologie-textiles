        rdf:type           skos:Concept;
        skos:definition    "Place where the responsibility is transferred."@en;
        skos:notation      "15";
        skos:prefLabel     "Place of transfer responsibility"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

