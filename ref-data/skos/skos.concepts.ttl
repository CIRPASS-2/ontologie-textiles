        rdf:type           skos:Concept;
        skos:definition    "[3109] To identify the place where the payment has been or should be made."@en;
        skos:notation      "2";
        skos:prefLabel     "Payment location"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/3>
        rdf:type           skos:Concept;
        skos:definition    "Place where equipment tare has been or must be checked for official assessment."@en;
        skos:notation      "3";
        skos:prefLabel     "Tare check place"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

