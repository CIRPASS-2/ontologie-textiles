        rdf:type           skos:Concept;
        skos:definition    "[3392] Seaport, airport, freight terminal, rail station or other place at which goods are unloaded from the means of transport having been used for their carriage."@en;
        skos:notation      "11";
        skos:prefLabel     "Place of discharge"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

