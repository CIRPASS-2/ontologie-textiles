        skos:definition    "The name and country of the last port where waste of any type was delivered."@en;
        skos:notation      "307";
        skos:prefLabel     "Port of last waste delivery"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/308>
