        rdf:type           skos:Concept;
        skos:definition    "(3246) Place to which the goods are to be finally delivered under transport contract terms (operational term)."@en;
        skos:notation      "7";
        skos:prefLabel     "Place of delivery"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/8>
