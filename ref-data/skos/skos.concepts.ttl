        skos:definition    "An intergovernmental organization mandated to manage tuna and tuna-like species in the Indian Ocean and adjacent seas."@en;
        skos:notation      "365";
        skos:prefLabel     "Indian Ocean Tuna Commission (IOTC)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/364>
        rdf:type           skos:Concept;
        skos:definition    "(CCSBT) An organization which oversees the management and conservation of southern blue fin tuna."@en;
        skos:notation      "364";
        skos:prefLabel     "Commission for the Conservation of Southern Bluefin Tuna"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/363>
        rdf:type           skos:Concept;
        skos:definition    "An organization responsible for the conservation and management of fisheries for tunas and other species taken by tuna-fishing vessels in the eastern Pacific Ocean."@en;
        skos:notation      "363";
        skos:prefLabel     "Inter-American Tropical Tuna Commission (IATTC)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/362>
        rdf:type           skos:Concept;
        skos:definition    "Tunas (ICCAT) An inter-governmental fishery organization responsible for the conservation of tunas and tuna-like species in the Atlantic Ocean and its adjacent seas."@en;
        skos:notation      "362";
        skos:prefLabel     "International Commission for the Conservation of Atlantic"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/361>
        rdf:type           skos:Concept;
        skos:definition    "An office within the US Executive Branch, Office of the President. USTR negotiates directly with foreign governments to create trade agreements; resolves disputes and participates in global trade policy organizations; meets with governments, business groups, legislators and public interest groups to gather input on trade issues; and explains the president’s trade policy positions."@en;
        skos:notation      "361";
        skos:prefLabel     "US, Office of the United States Trade Representative (USTR)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/360>
        rdf:type           skos:Concept;
        skos:definition    "A division of US Department of Homeland Security. USCG is a military branch of the United States involved in maritime law, mariner assistance, and search and rescue."@en;
        skos:notation      "360";
        skos:prefLabel     "US, Coast Guard (USCG)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/359>
        rdf:type           skos:Concept;
        skos:definition    "USAID is an independent US federal government agency. USAID supports long-term and equitable economic growth and advances US foreign policy objectives."@en;
        skos:notation      "359";
        skos:prefLabel     "US, Agency for International Development (USAID)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/358>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Defense (Army). USACE protects the US aquatic resources, while allowing reasonable development through fair, flexible and balanced permit decisions."@en;
        skos:notation      "358";
        skos:prefLabel     "US, Army Corp of Engineers (USACE)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/357>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of the Treasury. TTB collects alcohol, tobacco, firearms, and ammunition excise taxes; to ensure that these products are labeled, advertised, and marketed in accordance with the law; and administers the laws and regulations."@en;
        skos:notation      "357";
        skos:prefLabel     "US, Alcohol and Tobacco Tax and Trade Bureau (TTB)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/356>
        rdf:type           skos:Concept;
        skos:definition    "(PHMSA) A division of the US Department of Transportation. PHMSA works to protect the American public and the environment by ensuring the safe and secure movement of hazardous materials to industry and consumers by all transportation modes, including the nation's pipelines."@en;
        skos:notation      "356";
        skos:prefLabel     "US, Pipeline and Hazardous Materials Safety Administration"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/355>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Defense (Navy)."@en;
        skos:notation      "355";
        skos:prefLabel     "US, Office of Naval Intelligence (ONI)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/354>
        rdf:type           skos:Concept;
        skos:definition    "Scientific Affairs (OES) A division of the US Department of State. OES works with issues surrounding foreign policy formulation and implementation in global environment, science, and technology."@en;
        skos:notation      "354";
        skos:prefLabel     "US, Bureau of Oceans and International Environmental and"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/353>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of State. OFM provides the legal foundation to facilitate secure and efficient operations of US missions abroad, and of foreign missions and international organizations in the United States."@en;
        skos:notation      "353";
        skos:prefLabel     "US, Office of Foreign Missions (OFM)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/352>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Energy."@en;
        skos:notation      "352";
        skos:prefLabel     "US, Office of Fossil Energy (OFE)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/351>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Commerce. NMFS issues permits to support their effort to regulate commercial and recreational international transactions involving resources such as such as swordfish, tooth fish, and tuna while overseeing the management, conservation and protection of living marine resources within the areas of ocean surrounding the United States."@en;
        skos:notation      "351";
        skos:prefLabel     "US, National Marine Fisheries Service (NMFS)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/350>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Transportation. NHTSA monitors the importation of motor vehicles and motor vehicle equipment to ensure compliance with applicable Federal motor vehicle safety standards."@en;
        skos:notation      "350";
        skos:prefLabel     "US, National Highway Traffic Safety Administration (NHTSA)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/349>
        rdf:type           skos:Concept;
        skos:definition    "An independent commission. ITC investigates the effects of dumped and subsidized imports on domestic industries and conducts global safeguard investigations."@en;
        skos:notation      "349";
        skos:prefLabel     "US, International Trade Commission (ITC)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/348>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of the Treasury. IRS collects excise taxes on imports and on conveyances involved in international traffic."@en;
        skos:notation      "348";
        skos:prefLabel     "US, Internal Revenue Service (IRS)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/347>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Commerce. IA enforces the US unfair trade laws (i.e., the anti-dumping and countervailing duty laws) and develops and implements other policies and programs aimed at countering foreign unfair trade practices."@en;
        skos:notation      "347";
        skos:prefLabel     "US, Import Administration (IA)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/346>
        rdf:type           skos:Concept;
        skos:definition    "Administration (GIPSA) A division of the US Department of Agriculture. GIPSA facilitates the marketing of livestock, poultry, meat, cereals, oilseeds, and related agricultural products, and promotes fair and competitive trading practices for the overall benefit of consumers and American agriculture."@en;
        skos:notation      "346";
        skos:prefLabel     "US, The Grain Inspection, Packers and Stockyards"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/345>
        rdf:type           skos:Concept;
        skos:definition    "FTZB licenses, regulates, and monitors the activity of foreign-trade zones (FTZ) in the United States."@en;
        skos:notation      "345";
        skos:prefLabel     "US, Foreign Trade Zones Board (FTZB)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/344>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Agriculture. FSIS is responsible for ensuring that the nation's commercial supply of meat, poultry, and egg products is safe, wholesome, and correctly labeled and packaged."@en;
        skos:notation      "344";
        skos:prefLabel     "US, Food Safety Inspection Service (FSIS)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/343>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Transportation. FMCSA is focused on reducing crashes, injuries, and fatalities involving large trucks and buses."@en;
