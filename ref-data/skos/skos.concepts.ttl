        skos:prefLabel     "US, Environmental Protection Agency (EPA)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/339>
