        skos:prefLabel     "US, Federal Motor Carrier Safety Administration (FMCSA)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/342>
        rdf:type           skos:Concept;
        skos:definition    "A division of the US Department of Agriculture. FAS works to improve foreign market access for US products, build new markets, improve the competitive position of US agriculture in the global marketplace, and provide food aid and technical assistance to foreign countries."@en;
        skos:notation      "342";
        skos:prefLabel     "US, Foreign Agriculture Service (FAS)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/341>
