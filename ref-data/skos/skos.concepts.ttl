        skos:prefLabel     "Transit principal's agent/representative"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AI>
        rdf:type           skos:Concept;
        skos:definition    "Person who has been chosen for a job."@en;
        skos:notation      "AI";
        skos:prefLabel     "Successful job applicant"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AJ>
        rdf:type           skos:Concept;
        skos:definition    "The party which has issued all mutually agreed codes used in the message."@en;
        skos:notation      "AJ";
        skos:prefLabel     "Party issuing mutually agreed codes"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AK>
        rdf:type           skos:Concept;
        skos:definition    "Party to whom acknowledgement should be sent."@en;
        skos:notation      "AK";
        skos:prefLabel     "Acknowledgement recipient"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AL>
        rdf:type           skos:Concept;
        skos:definition    "(3340) Party accepting liability for goods held or moving (e.g. transit) under a Customs authorization and - when applicable - a guarantee."@en;
        skos:notation      "AL";
        skos:prefLabel     "Principal responsible party"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AM>
        rdf:type           skos:Concept;
        skos:definition    "Employee of a company or firm authorized to act on behalf of that company or firm e.g. to make a Customs declaration."@en;
        skos:notation      "AM";
        skos:prefLabel     "Authorized official"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AN>
        rdf:type           skos:Concept;
        skos:definition    "Person or company which is authorised by the relevant Customs authority to import goods without payment all taxes or specific taxes at the point of entry into the country."@en;
        skos:notation      "AN";
        skos:prefLabel     "Approved importer"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AO>
        rdf:type           skos:Concept;
        skos:definition    "Party account is assigned to."@en;
        skos:notation      "AO";
        skos:prefLabel     "Account of"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AP>
        rdf:type           skos:Concept;
        skos:definition    "(3336) Party accepting goods, products, services, etc."@en;
        skos:notation      "AP";
        skos:prefLabel     "Accepting party"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

<https://w3id.org/eudpp/thesauri/party_function/AQ>
        rdf:type           skos:Concept;
        skos:definition    "Person or company approved by the relevant authority in the country to pack and export specific goods under Customs supervision."@en;
        skos:notation      "AQ";
        skos:prefLabel     "Approved consignor"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/party_function> .

