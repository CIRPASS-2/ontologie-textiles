<https://w3id.org/eudpp/thesauri/document/document/971>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document for a course of transit used for a carrier who is neither the carrier at the beginning nor the arrival. The transit carrier can directly invoice the expenses for its part of the transport."@en;
        skos:notation    "971";
        skos:prefLabel   "Transit Conveyor Document"@en .

<https://w3id.org/eudpp/thesauri/document/document/972>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document which is a copy of the rail consignment note printed especially for the need of the forwarder."@en;
        skos:notation    "972";
        skos:prefLabel   "Rail consignment note forwarder copy"@en .

<https://w3id.org/eudpp/thesauri/document/document/974>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document giving details for the carriage of excisable goods on a duty-suspended basis."@en;
        skos:notation    "974";
        skos:prefLabel   "Duty suspended goods"@en .

<https://w3id.org/eudpp/thesauri/document/document/975>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "A document providing proof that a transit declaration has been accepted."@en;
        skos:notation    "975";
        skos:prefLabel   "Proof of transit declaration"@en .

<https://w3id.org/eudpp/thesauri/document/document/976>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document for the carriage of containers. Syn: transfer note."@en;
        skos:notation    "976";
        skos:prefLabel   "Container transfer note"@en .

<https://w3id.org/eudpp/thesauri/document/document/977>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Customs transit document for the carriage of shipments of the NATO armed forces under Customs supervision."@en;
        skos:notation    "977";
        skos:prefLabel   "NATO transit document"@en .

<https://w3id.org/eudpp/thesauri/document/document/978>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document containing the authorization from the relevant authority for the international carriage of waste. Syn: Transfrontier waste shipment permit."@en;
        skos:notation    "978";
        skos:prefLabel   "Transfrontier waste shipment authorization"@en .

<https://w3id.org/eudpp/thesauri/document/document/979>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document certified by the carriers and the consignee to be used for the international carriage of waste."@en;
        skos:notation    "979";
        skos:prefLabel   "Transfrontier waste shipment movement document"@en .

<https://w3id.org/eudpp/thesauri/document/document/990>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document issued by Customs granting the end-use Customs procedure."@en;
        skos:notation    "990";
        skos:prefLabel   "End use authorization"@en .

<https://w3id.org/eudpp/thesauri/document/document/991>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message describing a contract with a government authority."@en;
        skos:notation    "991";
        skos:prefLabel   "Government contract"@en .

<https://w3id.org/eudpp/thesauri/document/document/995>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message describing an import document that is used for statistical purposes."@en;
        skos:notation    "995";
        skos:prefLabel   "Statistical document, import"@en .

<https://w3id.org/eudpp/thesauri/document/document/996>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Message with application for opening of a documentary credit."@en;
        skos:notation    "996";
        skos:prefLabel   "Application for documentary credit"@en .

<https://w3id.org/eudpp/thesauri/document/document/998>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Indication of the previous Customs document/message concerning the same transaction."@en;
        skos:notation    "998";
        skos:prefLabel   "Previous Customs document/message"@en .

<https://w3id.org/eudpp/thesauri/document/document/964>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Package response message to permit the transfer of data from Customs to the transmitter of the previous message."@en;
        skos:notation    "964";
        skos:prefLabel   "Package response (Customs)"@en .

<https://w3id.org/eudpp/thesauri/document/document/963>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Error response message to permit the transfer of data from Customs to the transmitter of the previous message."@en;
        skos:notation    "963";
        skos:prefLabel   "Error response (Customs)"@en .

<https://w3id.org/eudpp/thesauri/document/document/962>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document response message to permit the transfer of data from Customs to the transmitter of the previous message."@en;
        skos:notation    "962";
        skos:prefLabel   "Document response (Customs)"@en .

<https://w3id.org/eudpp/thesauri/document/document/961>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "General response message to permit the transfer of data from Customs to the transmitter of the previous message."@en;
        skos:notation    "961";
        skos:prefLabel   "General response (Customs)"@en .

<https://w3id.org/eudpp/thesauri/document/document/960>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "A set of documents, replacing the various (national) forms for Customs declaration within the EC, implemented on 01-01-1988."@en;
        skos:notation    "960";
        skos:prefLabel   "Single administrative document"@en .

<https://w3id.org/eudpp/thesauri/document/document/955>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "International Customs document (Admission Temporaire / Temporary Admission) which, issued under the terms of the ATA Convention (1961), incorporates an internationally valid guarantee and may be used, in lieu of national Customs documents and as security for import duties and taxes, to cover the temporary admission of goods and, where appropriate, the transit of goods. If accepted for controlling the temporary export and reimport of goods, international guarantee does not apply (CCC)."@en;
        skos:notation    "955";
        skos:prefLabel   "ATA carnet"@en .

<https://w3id.org/eudpp/thesauri/document/document/954>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Customs certificate used in preferential goods interchanges between EC countries and EC external countries."@en;
        skos:notation    "954";
        skos:prefLabel   "EUR 1 certificate of origin"@en .

<https://w3id.org/eudpp/thesauri/document/document/953>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "EC customs transit document issued by EC customs authorities for transit and/or temporary user of goods within the EC."@en;
        skos:notation    "953";
        skos:prefLabel   "EC carnet"@en .

<https://w3id.org/eudpp/thesauri/document/document/952>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "International Customs document (International Transit by Road), issued by a guaranteeing association approved by the Customs authorities, under the cover of which goods are carried, in most cases under Customs seal, in road vehicles and/or containers in compliance with the requirements of the Customs TIR Convention of the International Transport of Goods under cover of TIR Carnets (UN/ECE)."@en;
        skos:notation    "952";
        skos:prefLabel   "TIR carnet"@en .

<https://w3id.org/eudpp/thesauri/document/document/951>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "International Customs transit document by which the sender declares goods for carriage by rail in accordance with the provisions of the 1952 International Convention to facilitate the crossing of frontiers for goods carried by rail (TIF Convention of UIC)."@en;
        skos:notation    "951";
        skos:prefLabel   "TIF form"@en .

<https://w3id.org/eudpp/thesauri/document/document/950>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message by which the sender declares goods for Customs transit according to Annex E.1 (concerning Customs transit) to the Kyoto convention (CCC)."@en;
        skos:notation    "950";
        skos:prefLabel   "Goods declaration for Customs transit"@en .

<https://w3id.org/eudpp/thesauri/document/document/941>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message giving the permission to export specified goods."@en;
        skos:notation    "941";
        skos:prefLabel   "Embargo permit"@en .

<https://w3id.org/eudpp/thesauri/document/document/940>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message containing the demand of tax."@en;
        skos:notation    "940";
        skos:prefLabel   "Tax demand"@en .

<https://w3id.org/eudpp/thesauri/document/document/938>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message containing a general tax declaration."@en;
        skos:notation    "938";
        skos:prefLabel   "Tax declaration (general)"@en .

<https://w3id.org/eudpp/thesauri/document/document/937>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message in which an importer states the pertinent information required by the competent body for assessment of value-added tax."@en;
        skos:notation    "937";
        skos:prefLabel   "Tax declaration (value added tax)"@en .

<https://w3id.org/eudpp/thesauri/document/document/936>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message which, according to Article 106 of the \"Agreement concerning Postal Parcels\" under the UPU Convention, must accompany post parcels and in which the contents of such parcels are specified."@en;
        skos:notation    "936";
        skos:prefLabel   "Customs declaration (post parcels)"@en .

<https://w3id.org/eudpp/thesauri/document/document/935>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message required by the Customs in an importing country in which an exporter states the invoice or other price (e.g. selling price, price of identical goods), and specifies costs for freight, insurance and packing, etc., terms of delivery and payment, for the purpose of determining the Customs value in the importing country of goods consigned to that country."@en;
        skos:notation    "935";
        skos:prefLabel   "Customs invoice"@en .

<https://w3id.org/eudpp/thesauri/document/document/934>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message in which a declarant (importer) states the invoice or other price (e.g. selling price, price of identical goods), and specifies costs for freight, insurance and packing, etc., terms of delivery and payment, any relationship with the trading partner, etc., for the purpose of determining the Customs value of goods imported."@en;
        skos:notation    "934";
        skos:prefLabel   "Value declaration"@en .

<https://w3id.org/eudpp/thesauri/document/document/933>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Generic term, sometimes referred to as Freight declaration, applied to the documents providing the particulars required by the Customs concerning the cargo (freight) carried by commercial means of transport (CCC)."@en;
        skos:notation    "933";
        skos:prefLabel   "Cargo declaration (arrival)"@en .

<https://w3id.org/eudpp/thesauri/document/document/932>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message whereby a Customs authority releases goods under its control to be placed at the disposal of the party concerned. Synonym: Customs release note."@en;
        skos:notation    "932";
        skos:prefLabel   "Customs delivery note"@en .

<https://w3id.org/eudpp/thesauri/document/document/931>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message issued by an importer notifying Customs that goods have been removed from an importing means of transport to the importer's premises under a Customs- approved arrangement for immediate release, or requesting authorization to do so."@en;
        skos:notation    "931";
        skos:prefLabel   "Customs immediate release declaration"@en .

<https://w3id.org/eudpp/thesauri/document/document/930>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message by which goods are declared for import Customs clearance according to Annex B.1 (concerning clearance for home use) to the Kyoto convention (CCC)."@en;
        skos:notation    "930";
        skos:prefLabel   "Goods declaration for home use"@en .

<https://w3id.org/eudpp/thesauri/document/document/929>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message by which goods are declared for import Customs clearance [sister entry of 830]."@en;
        skos:notation    "929";
        skos:prefLabel   "Goods declaration for importation"@en .

<https://w3id.org/eudpp/thesauri/document/document/927>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message completed by an importer/buyer as a means for the competent body to control that a trade transaction for which foreign exchange has been allocated has been executed and that money has been transferred in accordance with the conditions of payment and the exchange control regulations in force."@en;
        skos:notation    "927";
        skos:prefLabel   "Exchange control declaration (import)"@en .

<https://w3id.org/eudpp/thesauri/document/document/926>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message issued by the competent body authorizing an importer/buyer to transfer an amount of foreign exchange to an exporter/seller in payment for goods."@en;
        skos:notation    "926";
        skos:prefLabel   "Foreign exchange permit"@en .

<https://w3id.org/eudpp/thesauri/document/document/925>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message whereby an importer/buyer requests the competent body to allocate an amount of foreign exchange to be transferred to an exporter/seller in payment for goods."@en;
        skos:notation    "925";
        skos:prefLabel   "Application for exchange allocation"@en .

<https://w3id.org/eudpp/thesauri/document/document/917>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Receipt for Customs duty/tax/fee paid."@en;
        skos:notation    "917";
        skos:prefLabel   "Receipt (Customs)"@en .

<https://w3id.org/eudpp/thesauri/document/document/916>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document that has a relationship with the stated document/message."@en;
        skos:notation    "916";
        skos:prefLabel   "Related document"@en .

<https://w3id.org/eudpp/thesauri/document/document/915>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "CUSDEC transmission that does not include data from the item detail section of the message."@en;
        skos:notation    "915";
        skos:prefLabel   "Customs declaration without item detail"@en .

<https://w3id.org/eudpp/thesauri/document/document/914>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "CUSDEC transmission that includes data from both the commercial detail and item detail sections of the message."@en;
        skos:notation    "914";
        skos:prefLabel   "Customs declaration with commercial and item detail"@en .

<https://w3id.org/eudpp/thesauri/document/document/913>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "CUSDEC transmission that does not include data from the commercial detail section of the message."@en;
        skos:notation    "913";
        skos:prefLabel   "Customs declaration without commercial detail"@en .

<https://w3id.org/eudpp/thesauri/document/document/912>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Message to provide the releasing information of transport means and goods."@en;
        skos:notation    "912";
        skos:prefLabel   "Transport Means and Goods Release Message."@en .

<https://w3id.org/eudpp/thesauri/document/document/911>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message issued by the competent body in accordance with import regulations in force, by which authorization is granted to a named party to import either a limited quantity of designated articles or an unlimited quantity of such articles during a limited period, under conditions specified in the document."@en;
        skos:notation    "911";
        skos:prefLabel   "Import licence"@en .

<https://w3id.org/eudpp/thesauri/document/document/910>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message in which an interested party applies to the competent body for authorization to import either a limited quantity of articles subject to import restrictions, or an unlimited quantity of such articles during a limited period, and specifies the kind of articles, their origin and value, etc."@en;
        skos:notation    "910";
        skos:prefLabel   "Import licence, application for"@en .

<https://w3id.org/eudpp/thesauri/document/document/909>
