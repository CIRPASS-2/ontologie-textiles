        skos:notation      "18";
        skos:prefLabel     "Warehouse"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/17>
        rdf:type           skos:Concept;
        skos:definition    "Place where goods are transported across a country border."@en;
        skos:notation      "17";
        skos:prefLabel     "Border crossing place"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/16>
        rdf:type           skos:Concept;
        skos:definition    "Place where the ownership of the goods is transferred."@en;
        skos:notation      "16";
        skos:prefLabel     "Place of transfer of ownership"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

