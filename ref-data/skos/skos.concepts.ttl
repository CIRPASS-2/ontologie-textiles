        skos:definition    "(3258) Port, airport or other location to which a means of transport or transport equipment is destined."@en;
        skos:notation      "8";
        skos:prefLabel     "Place of destination"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/9>
