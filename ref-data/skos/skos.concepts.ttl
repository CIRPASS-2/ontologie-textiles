        skos:broader     <https://w3id.org/eudpp/thesauri/document/document>;
        skos:definition  "Document/message in which a bank states that it has issued a documentary credit under which the beneficiary is to obtain payment, acceptance or negotiation on compliance with certain terms and conditions and against presentation of stipulated documents and such drafts as may be specified. The credit may or may not be confirmed by another bank."@en;
        skos:notation    "465";
        skos:prefLabel   "Documentary credit"@en .

<https://w3id.org/eudpp/thesauri/document/document/464>
