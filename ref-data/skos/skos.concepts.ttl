<https://w3id.org/eudpp/thesauri/document/status/35>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is incomplete."@en;
        skos:notation    "35";
        skos:prefLabel   "Document incomplete"@en .

<https://w3id.org/eudpp/thesauri/document/status/36>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document has already been submitted."@en;
        skos:notation    "36";
        skos:prefLabel   "Document previously submitted"@en .

<https://w3id.org/eudpp/thesauri/document/status/37>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is complete."@en;
        skos:notation    "37";
        skos:prefLabel   "Document complete"@en .

<https://w3id.org/eudpp/thesauri/document/status/38>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document has been finalised."@en;
        skos:notation    "38";
        skos:prefLabel   "Final"@en .

<https://w3id.org/eudpp/thesauri/document/status/39>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document or message will not be processed until further release information."@en;
        skos:notation    "39";
        skos:prefLabel   "On hold"@en .

<https://w3id.org/eudpp/thesauri/document/status/40>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The validity of the document is or has been suspended."@en;
        skos:notation    "40";
        skos:prefLabel   "Validity suspended"@en .

<https://w3id.org/eudpp/thesauri/document/status/41>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The validity of the document is or has been revoked."@en;
        skos:notation    "41";
        skos:prefLabel   "Validity revoked"@en .

<https://w3id.org/eudpp/thesauri/document/status/42>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The specified document is in error."@en;
        skos:notation    "42";
        skos:prefLabel   "In error"@en .

<https://w3id.org/eudpp/thesauri/document/status/43>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is received."@en;
        skos:notation    "43";
        skos:prefLabel   "Received"@en .

<https://w3id.org/eudpp/thesauri/document/status/44>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is accepted, but has generated warnings."@en;
        skos:notation    "44";
        skos:prefLabel   "Accepted with warnings"@en .

<https://w3id.org/eudpp/thesauri/document/status/45>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document is being processed."@en;
        skos:notation    "45";
        skos:prefLabel   "In process"@en .

<https://w3id.org/eudpp/thesauri/document/status/46>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document has been halted pending response to a query."@en;
        skos:notation    "46";
        skos:prefLabel   "Under query"@en .

<https://w3id.org/eudpp/thesauri/document/status/47>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document has been paid."@en;
        skos:notation    "47";
        skos:prefLabel   "Paid"@en .

<https://w3id.org/eudpp/thesauri/document/status/48>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document is acknowledged as understood and submitted for further processing."@en;
        skos:notation    "48";
        skos:prefLabel   "Acknowledged"@en .

<https://w3id.org/eudpp/thesauri/document/status/49>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document is accepted under conditions stated and proceeded accordingly unless disputed."@en;
        skos:notation    "49";
        skos:prefLabel   "Conditionally accepted"@en .

<https://w3id.org/eudpp/thesauri/document/status/50>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document has been rejected, and a clarification or reason is required."@en;
        skos:notation    "50";
        skos:prefLabel   "Rejected, no further processing"@en .

<https://w3id.org/eudpp/thesauri/document/status/34>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is in the possession of the sender or sender's agent or representative."@en;
        skos:notation    "34";
        skos:prefLabel   "Retained by sender of this message, or by sender's agent or representative"@en .

<https://w3id.org/eudpp/thesauri/document/status/33>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is already on file with the party receiving the message."@en;
        skos:notation    "33";
        skos:prefLabel   "Already on file with receiver of this message"@en .

<https://w3id.org/eudpp/thesauri/document/status/32>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document is not required, waiver of requirement has been issued."@en;
        skos:notation    "32";
        skos:prefLabel   "Document not required, waiver issued"@en .

<https://w3id.org/eudpp/thesauri/document/status/31>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The documents are enclosed in the second transmission."@en;
        skos:notation    "31";
        skos:prefLabel   "Documents enclosed in the second transmission"@en .

<https://w3id.org/eudpp/thesauri/document/status/30>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The documents are enclosed in the first transmission."@en;
        skos:notation    "30";
        skos:prefLabel   "Documents enclosed in the first transmission"@en .

<https://w3id.org/eudpp/thesauri/document/status/29>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document or message has no official status."@en;
        skos:notation    "29";
        skos:prefLabel   "Provisional"@en .

<https://w3id.org/eudpp/thesauri/document/status/28>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document or message has been archived."@en;
        skos:notation    "28";
        skos:prefLabel   "Archived"@en .

<https://w3id.org/eudpp/thesauri/document/status/27>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Document to include freight figures."@en;
        skos:notation    "27";
        skos:prefLabel   "Document freighted"@en .

<https://w3id.org/eudpp/thesauri/document/status/26>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Document not to include freight figures."@en;
        skos:notation    "26";
        skos:prefLabel   "Document not freighted"@en .

<https://w3id.org/eudpp/thesauri/document/status/25>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Message is under development."@en;
        skos:notation    "25";
        skos:prefLabel   "Message under development"@en .

<https://w3id.org/eudpp/thesauri/document/status/24>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Message is at status 2."@en;
        skos:notation    "24";
        skos:prefLabel   "Status 2"@en .

<https://w3id.org/eudpp/thesauri/document/status/23>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Message is at status 1."@en;
        skos:notation    "23";
        skos:prefLabel   "Status 1"@en .

<https://w3id.org/eudpp/thesauri/document/status/22>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Message is at status 0."@en;
        skos:notation    "22";
        skos:prefLabel   "Status 0"@en .

<https://w3id.org/eudpp/thesauri/document/status/21>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document has legal validity from the date that cargo is loaded on board a vessel."@en;
        skos:notation    "21";
        skos:prefLabel   "Shipped on board"@en .

<https://w3id.org/eudpp/thesauri/document/status/20>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Indicates that the document has legal validity from the date of receival of the cargo."@en;
        skos:notation    "20";
        skos:prefLabel   "Received for shipment"@en .

<https://w3id.org/eudpp/thesauri/document/status/19>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Application has been submitted for that document."@en;
        skos:notation    "19";
        skos:prefLabel   "Document applied for"@en .

<https://w3id.org/eudpp/thesauri/document/status/18>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Specified document is attached to the Customs declaration and will be required to be returned to the declarant after Customs endorsement."@en;
        skos:notation    "18";
        skos:prefLabel   "Document attached, to be returned after endorsement"@en .

<https://w3id.org/eudpp/thesauri/document/status/17>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Document not attached to the Customs declaration but is attached to the goods."@en;
        skos:notation    "17";
        skos:prefLabel   "Document with the goods"@en .

<https://w3id.org/eudpp/thesauri/document/status/16>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Specified document is not or cannot be attached."@en;
        skos:notation    "16";
        skos:prefLabel   "Document not attached"@en .

<https://w3id.org/eudpp/thesauri/document/status/1>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The specified document is accepted."@en;
        skos:notation    "1";
        skos:prefLabel   "Accepted"@en .

<https://w3id.org/eudpp/thesauri/document/status/2>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Notice that a specific document will be accompanying the goods."@en;
        skos:notation    "2";
        skos:prefLabel   "Accompanying goods"@en .

<https://w3id.org/eudpp/thesauri/document/status/3>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The specified document is conditionally accepted."@en;
        skos:notation    "3";
        skos:prefLabel   "Conditionally accepted"@en .

<https://w3id.org/eudpp/thesauri/document/status/4>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Notice that a specific document/message will be transmitted via a separate EDI message."@en;
        skos:notation    "4";
        skos:prefLabel   "To arrive by separate EDI message"@en .

<https://w3id.org/eudpp/thesauri/document/status/5>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Notice that the specific document or message is for information only."@en;
        skos:notation    "5";
        skos:prefLabel   "Information only"@en .

<https://w3id.org/eudpp/thesauri/document/status/6>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Notice that a specific document or message will not be sent via EDI."@en;
        skos:notation    "6";
        skos:prefLabel   "To arrive by manual means"@en .

<https://w3id.org/eudpp/thesauri/document/status/7>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Request for a specific message to be formatted and transmitted or a request for a specific document to be raised and sent."@en;
        skos:notation    "7";
        skos:prefLabel   "To be raised and sent"@en .

<https://w3id.org/eudpp/thesauri/document/status/8>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The specified document is rejected."@en;
        skos:notation    "8";
        skos:prefLabel   "Rejected"@en .

<https://w3id.org/eudpp/thesauri/document/status/9>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "The document or message is to be printed."@en;
        skos:notation    "9";
        skos:prefLabel   "To be printed"@en .

<https://w3id.org/eudpp/thesauri/document/status/10>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Specific document is currently valid."@en;
        skos:notation    "10";
        skos:prefLabel   "Document currently valid"@en .

<https://w3id.org/eudpp/thesauri/document/status/11>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Specified document is not available."@en;
        skos:notation    "11";
        skos:prefLabel   "Document not available"@en .

<https://w3id.org/eudpp/thesauri/document/status/12>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Customs declaration to which the document is related completed or exhaust the allowance stated on the document. The document is attached to the Customs declaration."@en;
        skos:notation    "12";
        skos:prefLabel   "Document exhausted by declaration and attached"@en .

<https://w3id.org/eudpp/thesauri/document/status/13>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Customs declaration to which the document is related does not complete or exhaust the allowance stated on the document . The document is not attached to the declaration but has already been lodged in the Customs station."@en;
        skos:notation    "13";
        skos:prefLabel   "Document not exhausted by declaration and attached"@en .

<https://w3id.org/eudpp/thesauri/document/status/14>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Customs declaration to which the document is related completed or exhaust the allowance stated on the document. The usage of the document is complete. The document is not attached to the declaration but has already been lodged in the Customs station."@en;
        skos:notation    "14";
        skos:prefLabel   "Document exhausted by declaration and previously lodged"@en .

<https://w3id.org/eudpp/thesauri/document/status/15>
        rdf:type         skos:Concept;
        skos:broader     <https://w3id.org/eudpp/thesauri/document/status>;
        skos:definition  "Customs declaration to which the document is related does not complete or exhaust the allowance stated on the document. The document can continue to be used for future declarations until the allowance is exhausted. The document is not attached to the declaration but has already been lodged in the Customs station."@en;
        skos:notation    "15";
        skos:prefLabel   "Document not exhausted by declaration and previously lodged"@en .

<https://w3id.org/eudpp/thesauri/document/status>
        rdf:type  skos:ConceptScheme .

