<https://w3id.org/eudpp/thesauri/location_function/309>
        rdf:type           skos:Concept;
        skos:definition    "A facility that cleans industrial and/or domestic effluents, before reusing the water or discharging it to the environment."@en;
        skos:notation      "309";
        skos:prefLabel     "Effluent Treatment Plant"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/310>
        rdf:type           skos:Concept;
        skos:definition    "An area of land, water or a building that is primarily devoted to agricultural or aquacultural processes, such as growing crops and/or keeping animals."@en;
        skos:notation      "310";
        skos:prefLabel     "Farm"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/311>
        rdf:type           skos:Concept;
        skos:definition    "A facility where an operation or a series of operations are performed in the making or treatment of a product."@en;
        skos:notation      "311";
        skos:prefLabel     "Manufacturing facility"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/312>
        rdf:type           skos:Concept;
        skos:definition    "An area of land, water or a building that is primarily devoted to animals for the purpose of obtaining their meat, wool, hides, milk, eggs, etc."@en;
        skos:notation      "312";
        skos:prefLabel     "Animal Farm"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

