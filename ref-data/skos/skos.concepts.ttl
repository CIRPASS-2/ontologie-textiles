<https://w3id.org/eudpp/thesauri/location_function/48>
        rdf:type           skos:Concept;
        skos:definition    "Region where item has been or will be produced."@en;
        skos:notation      "48";
        skos:prefLabel     "Region of production"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/47>
        rdf:type           skos:Concept;
        skos:definition    "Region known to the consignor or his agent at the time of despatch to be the final region to which the goods are to be delivered."@en;
        skos:notation      "47";
        skos:prefLabel     "Region of destination"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/46>
        rdf:type           skos:Concept;
        skos:definition    "Region from which goods are despatched between countries of a Customs union."@en;
        skos:notation      "46";
        skos:prefLabel     "Region of despatch"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/45>
        rdf:type           skos:Concept;
        skos:definition    "(3086) Customs office at which a transit operation is terminated. Synonym: Customs office of transit termination."@en;
        skos:notation      "45";
        skos:prefLabel     "Customs office of destination (transit)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/44>
        rdf:type           skos:Concept;
        skos:definition    "(3410) Place where document is signed or otherwise authenticated. Synonym: Place of issue of document."@en;
        skos:notation      "44";
        skos:prefLabel     "Place of authentication of document"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/43>
        rdf:type           skos:Concept;
        skos:definition    "Place where Customs undertakes a physical inspection of goods to satisfy themselves that the goods' nature, origin, condition, quantity and value are in accordance with the particulars furnished on the goods declaration (CCC)."@en;
        skos:notation      "43";
        skos:prefLabel     "Place of Customs examination"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/42>
        rdf:type           skos:Concept;
        skos:definition    "[3097] To identify the customs office at which the goods leave or are intended to leave the customs territory of despatch."@en;
        skos:notation      "42";
        skos:prefLabel     "Consignment exit customs office location"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/41>
        rdf:type           skos:Concept;
        skos:definition    "[3089] To identify the customs office at which the goods enter the customs territory of destination."@en;
        skos:notation      "41";
        skos:prefLabel     "Consignment entry customs office location"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/40>
        rdf:type           skos:Concept;
        skos:definition    "Country where item has been or will be traded."@en;
        skos:notation      "40";
        skos:prefLabel     "Country of trading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/39>
        rdf:type           skos:Concept;
        skos:definition    "Country where item has been or will be produced."@en;
        skos:notation      "39";
        skos:prefLabel     "Country of production"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/38>
        rdf:type           skos:Concept;
        skos:definition    "[3219] To identify the country where a consignment is off-loaded from the means of transport used for the original exportation."@en;
        skos:notation      "38";
        skos:prefLabel     "Consignment first destination country"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/37>
        rdf:type           skos:Concept;
        skos:definition    "[3331] To identify the country from which goods have been or will be consigned prior to final importation."@en;
        skos:notation      "37";
        skos:prefLabel     "Consignment final exportation country"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/36>
        rdf:type           skos:Concept;
        skos:definition    "(3216) Country known to the consignor or his agent at the time of despatch to be the final country to which the goods are to be delivered."@en;
        skos:notation      "36";
        skos:prefLabel     "Country of ultimate destination"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/35>
        rdf:type           skos:Concept;
        skos:definition    "[3220] Country from which the goods were initially exported to the importing country without any commercial transaction taking place in intermediate countries. Synonym: Country whence consigned. Country of despatch: Country from which goods are despatched between countries of a Customs union."@en;
        skos:notation      "35";
        skos:prefLabel     "Exportation country"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/34>
        rdf:type           skos:Concept;
        skos:definition    "[3322] Place at which the cargo is loaded on a means of transport according to the transport contract. The goods may or may not be loaded on the main means of transport at this place or port."@en;
        skos:notation      "34";
        skos:prefLabel     "Baseport of loading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/33>
        rdf:type           skos:Concept;
        skos:definition    "[3356] Place at which the cargo is discharged or unloaded from a means of transport according to the transport contract. The goods may or may not be discharged from the main means of transport at this place or port."@en;
        skos:notation      "33";
        skos:prefLabel     "Baseport of discharge"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/32>
        rdf:type           skos:Concept;
        skos:definition    "First rail station in a predefined section of the chargeable voyage. A complete voyage may be divided in sections, even within one country, that are separately chargeable using different tariff rules (split tariffs)."@en;
        skos:notation      "32";
        skos:prefLabel     "Beginning of chargeable section"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/31>
        rdf:type           skos:Concept;
        skos:definition    "A building or part thereof relevant to a particular consignment or transaction."@en;
        skos:notation      "31";
        skos:prefLabel     "Building"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/30>
        rdf:type           skos:Concept;
        skos:definition    "Country in which raw material or components were originally produced prior to manufacture or assembly in another country."@en;
        skos:notation      "30";
        skos:prefLabel     "Country of source"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/29>
        rdf:type           skos:Concept;
        skos:definition    "Name or identification of a railway station/yard relevant to a particular consignment."@en;
        skos:notation      "29";
        skos:prefLabel     "Railway station"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/28>
        rdf:type           skos:Concept;
        skos:definition    "Country to which the goods are to be delivered."@en;
        skos:notation      "28";
        skos:prefLabel     "Country of destination of goods"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/27>
        rdf:type           skos:Concept;
        skos:definition    "[3239] To identify the country in which the goods have been produced or manufactured, according to criteria laid down for the application of the Customs tariff or quantitative restrictions, or any measure related to trade."@en;
        skos:notation      "27";
        skos:prefLabel     "Country of origin"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/26>
        rdf:type           skos:Concept;
        skos:definition    "City or town relevant for a particular transaction or consignment."@en;
        skos:notation      "26";
        skos:prefLabel     "City"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/25>
        rdf:type           skos:Concept;
        skos:definition    "Country relevant for a particular transaction."@en;
        skos:notation      "25";
        skos:prefLabel     "Country"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/24>
        rdf:type           skos:Concept;
        skos:definition    "Port where final documentation is filed for Customs Entry processing."@en;
        skos:notation      "24";
        skos:prefLabel     "Port of entry"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/23>
        rdf:type           skos:Concept;
        skos:definition    "Port where goods are released from Customs custody."@en;
        skos:notation      "23";
        skos:prefLabel     "Port of release"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/22>
        rdf:type           skos:Concept;
        skos:definition    "[3080] Place at which Customs clearance should or has taken place."@en;
        skos:notation      "22";
        skos:prefLabel     "Customs clearance location"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/21>
        rdf:type           skos:Concept;
        skos:definition    "Place of departure, shipment or destination as specified in the terms of sale agreed between the parties."@en;
        skos:notation      "21";
        skos:prefLabel     "Terms of sale place"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/20>
        rdf:type           skos:Concept;
        skos:definition    "Place where goods will ultimately be delivered."@en;
        skos:notation      "20";
        skos:prefLabel     "Place of ultimate destination of goods"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

