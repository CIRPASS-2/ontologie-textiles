        skos:definition    "[3334] Seaport, airport, freight terminal, rail station or other place at which the goods (cargo) are loaded on to the means of transport being used for their carriage."@en;
        skos:notation      "9";
        skos:prefLabel     "Place of loading"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/10>
