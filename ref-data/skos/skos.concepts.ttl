        skos:definition    "Port at which the goods are discharged from the vessel used for their transport."@en;
        skos:notation      "12";
        skos:prefLabel     "Port of discharge"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/13>
        rdf:type           skos:Concept;
        skos:definition    "[3424] Place where goods are to be or have been transferred from one means of transport to another during the course of one transport operation."@en;
        skos:notation      "13";
        skos:prefLabel     "Place of transhipment"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/14>
        rdf:type           skos:Concept;
        skos:definition    "[3385] To identify the place where a goods item is located."@en;
        skos:notation      "14";
        skos:prefLabel     "Goods item storage location"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

