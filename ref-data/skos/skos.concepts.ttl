        rdf:type           skos:Concept;
        skos:definition    "Factory/plant relevant for a particular consignment."@en;
        skos:notation      "19";
        skos:prefLabel     "Factory/plant"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/location_function> .

<https://w3id.org/eudpp/thesauri/location_function/18>
