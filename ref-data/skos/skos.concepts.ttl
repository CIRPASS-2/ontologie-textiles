        skos:prefLabel     "US, Federal Aviation Administration (FAA)"@en;
        skos:topConceptOf  <https://w3id.org/eudpp/thesauri/code_list_responsible_agency> .

<https://w3id.org/eudpp/thesauri/code_list_responsible_agency/340>
