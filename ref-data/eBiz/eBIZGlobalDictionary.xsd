                    <xsd:documentation>
                        <eds:Definition>TEXPrintOrdChange: document "TEXTILES PRINTING COMMISSION ORDER CHANGE"</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXDyFinOrdChange" type="TEXDyFinOrdChange_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TEXDyFinOrdChange: document "TEXTILES DYEING-FINISHING COMMISSION ORDER CHANGE"</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="YARNQualityRpt" type="YARNQualityRpt_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>YARNQualityRpt: Yarn quality report</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="YARNOffer" type="YARNOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>YARNOffer: Offer or Catalogue of yarn articles embedding technical sheets</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="YARNOfferRequest" type="YARNOfferRequest_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>YARNOfferRequest: Request for a specific kind of yarn</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TGPOrderResponse" type="TGPOrderResponse_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TGPOrderResponse: root of the document "Taylormade Garment Production Order Response"</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWSpinOrdChange" type="RAWSpinOrdChange_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWSpinOrdChange: Spinning Order Change for a raw material</eds:Definition>

                    </xsd:documentation>

