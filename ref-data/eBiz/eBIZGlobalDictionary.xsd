                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="trade" type="trade_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>Trade details: general terms of trade for the specified supply</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="exportCustomOffice" type="exportCustomOffice_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>export custom office: Dispatch/export customs office</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="exitCustomOffice" type="exitCustomOffice_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>exit custom office: Exit customs office - customs office through which the goods leave the customs territory of the Union</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="bondedWarehouse" type="bondedWarehouse_Type" minOccurs="0" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>bonded warehouse: Details about the bonded warehouse</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="transportRouteInfo" type="transportRouteInfo_Type" minOccurs="0" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>transport route info: Information for customs use on transport relating to a transit area of the shipment</eds:Definition>

                    </xsd:documentation>

