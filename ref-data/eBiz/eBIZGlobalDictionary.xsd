            <xsd:element name="statusReason" type="statusReason_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>status reason: the reason for the indicated status.</eds:Definition>

                    </xsd:documentation>

