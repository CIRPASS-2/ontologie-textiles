                        <eds:AggregationNote>it may be used to specify the location where lie the pieces that the Subcontractor must use for the commissioned work operation</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="note" type="note_Type" minOccurs="0" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>general note: free text or structured (computer processing) note. For note structuring use the attributes "noteLabel" and "codelist"</eds:Definition>

