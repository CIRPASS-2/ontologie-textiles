                    <xsd:documentation>
                        <eds:Definition>serial number: serial number used for the identification of a physical unit</eds:Definition>
                        <eds:AggregationNote>it may be used to identify the pieces/chains that the Subcontractor must use for the commissioned work</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
                <xsd:element name="itemsList" type="itemsList_Type" minOccurs="0" maxOccurs="unbounded">
