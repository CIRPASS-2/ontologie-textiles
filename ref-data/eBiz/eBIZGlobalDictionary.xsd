                <xsd:element name="fabricChar" type="fabricChar_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>fabric characteristic code: code of the physical or mechanical parameter used to define a "technical characteristic of the fabric" (see Fabric technical sheet)</eds:Definition>
