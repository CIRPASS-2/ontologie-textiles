                    <xsd:documentation>
                        <eds:Definition>TEXDyFinOffer: Offer from Subcontractor for textile Dyeing/Finishing</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXWeaveOffer" type="TEXWeaveOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TEXWeaveOffer: Offer from Subcontractor for Weaving</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="WARPOffer" type="WARPOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>WARPOffer: Offer from Subcontractor for Warping</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="YARNDyeOffer" type="YARNDyeOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>YARNDyeOffer: Offer from Subcontractor for Dyeing of yarn</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="YARNTwistOffer" type="YARNTwistOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>YARNTwistOffer: Offer from Subcontractor for Twisting</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWSpinOffer" type="RAWSpinOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWSpinOffer: Offer from Subcontractor for Spinning</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWDyeOffer" type="RAWDyeOffer_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWDyeOffer: Offer from Subcontractor for Dyeing of raw material</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXDyFinRequest" type="TEXDyFinRequest_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TEXDyFinRequest: Request to Subcontractor for textile Dyeing/Finishing</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXWeaveRequest" type="TEXWeaveRequest_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
