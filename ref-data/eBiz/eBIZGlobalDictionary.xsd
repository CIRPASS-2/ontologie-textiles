    <xsd:complexType name="accountingSupplier_Type">
        <xsd:annotation>
            <xsd:documentation>
                <eds:Definition>accountingSupplier</eds:Definition>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="id" type="id_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>Party identifier: primary identification code of a Party; it is recommended to use an EORI number (with @numberingOrg= "EO”) or the format: nation code (ISO 3166) + national tax code (i.e. VAT identification number ) with @numberingOrg= "MF"</eds:Definition>
                        <eds:AggregationNote>Use EORI as identifier (numberingOrg='EO')</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="additionalIdentifier" type="additionalIdentifier_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>Additional Party Identifier: additional identification code of a Party, for example customs registries or others</eds:Definition>
                        <eds:AggregationNote>If available, indicate the REX code  - identifier in EU Registered Exporter system (numberingOrg='REX')</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="authExporterFlag" type="authExporterFlag_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>authorized exporter flag: Indicates whether the supplier is an Exporter authorized by the Customs Authority (value 'true') or not (value 'false')</eds:Definition>

                    </xsd:documentation>

