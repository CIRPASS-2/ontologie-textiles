                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="pieceAllow" type="pieceAllow_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>piece allowance measure: allowance required or accorded for the piece</eds:Definition>
                        <eds:AggregationNote>this is the allowance estimated for the fault by the same "source" responsible for the other measurements</eds:AggregationNote>
