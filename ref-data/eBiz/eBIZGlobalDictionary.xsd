    <!-- Element (Instance ID: 1411) -->
    <xsd:complexType name="MCIInformationSupply_Type">
        <xsd:annotation>
            <xsd:documentation>
                <eds:Definition>MCIInformationSupply</eds:Definition>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="SRVheader" type="SRVheader_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SRV header: header of documents supporting ePlatform services</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ProductIdentification" type="ProductIdentification_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>transparency product identification: Identifies the product whose transparency and sustainability characteristics are reported</eds:Definition>
                        <eds:AggregationNote>indicate object type code</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="productReferenceQty" type="productReferenceQty_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>product reference quantity: net reference quantity of the product</eds:Definition>
                        <eds:AggregationNote>indicate the quantity of product to which the element refers (for example in relation to the quantities of each component)</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="billOfComponents" type="billOfComponents_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>bill of product components: bill of components used to create the product.</eds:Definition>
                        <eds:AggregationNote>mandatory to specify quantity (weight) related to final product reference quantity (productReferenceQty)</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="productCompos" type="productCompos_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>product composition: Quantitative composition of a product</eds:Definition>
                        <eds:AggregationNote>mandatory to specify the feedstock share from reused sources, from recycled sources  (and related efficiency of the recycling process) and from renewable sources</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="certificate" type="certificate_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>certificate document: Reference and details relating to a document containing a certification issued by a third party who is entitled to issue it</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="selfAssertion" type="selfAssertion_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>self assertion: A self declared statement that issuer is able to support with detailed descriptions or documentation. It might comply with standards about assertions (it is the case for example of ISO14021 for environmental assertions).</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="assessmentStudyDocument" type="assessmentStudyDocument_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>assessment study document: resulting study document (e.g. an LCA study).
It can be related to a component or a product.
It can be a dataset (in any format) or a report according to isStudyDataset flag).
In the case of PEF study, prefer PEFStudyDocument if possible.</eds:Definition>
                        <eds:AggregationNote>any further useful documentation</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="billOfWaste" type="billOfWaste_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>bill of waste: list of waste generated to make the product, excluding waste water, relating to quantities of the reference product or to yearly data of a facility/plant</eds:Definition>
                        <eds:AggregationNote>pre-usage bill of waste (related to production).
Mandatory to specify in wasteFinalTreatmentType the efficiency (in mass percentage) of the recycling process for the waste arising from production.</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="expectedUsagePerformance" type="expectedUsagePerformance_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>expected usage performance: Information useful for evaluating the life expectations of a product in ordinary use (for example duration and number of washing before the end of life).</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="endOfLifePerformance" type="endOfLifePerformance_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>end of life performance: IInformation on what is expected to happen at the end of the product's life with respect to reuse, recycling and composting</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="componentCircularityInformation" type="componentCircularityInformation_Type" minOccurs="0" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>component circularity information: circularity information related to one component</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="note" type="note_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>general note: free text or structured (computer processing) note. For note structuring use the attributes "noteLabel" and "codelist"</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
        <xsd:attribute name="version" type="version_Type" use="optional" default="draft"/>
        <xsd:attribute name="useProfile" type="useProfile_Type" use="optional"/>
        <xsd:attribute name="disclosureLevel" type="disclosureLevel_Type" use="optional"/>
        <xsd:attribute name="storageAction" type="storageAction_Type" use="optional"/>
    </xsd:complexType>

