<?xml version="1.0" encoding="ISO-8859-1" ?>
<xsd:schema targetNamespace="urn:moda-ml:repository:schema:eBIZGlobalDictionary" xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
xmlns="urn:moda-ml:repository:schema:eBIZGlobalDictionary" 
xmlns:ml="urn:moda-ml:repository:schema:eBIZGlobalDictionary" 
xmlns:eds="urn:moda-ml:repository:schema:eBIZDocumentationSpecification" 
elementFormDefault="unqualified" attributeFormDefault="unqualified" version="draft" >

    <!-- Root element   -->
    <xsd:element name="eBIZGlobalDictionary" type="eBIZGlobalDictionary_Type"/>

    <!-- Type of Root element -->
    <xsd:complexType name="eBIZGlobalDictionary_Type">
        <xsd:annotation>
            <xsd:documentation>
                <eds:Definition>eBIZGlobalDictionary</eds:Definition>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="TRCTTInformation" type="TRCTTInformation_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRCTTInformation: Traceability and sustainability information for consumer. Document used to synchronize the data of a consumer APP capable of retrieving specific information about the batch or product instance.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PCORequestForCustomsESDIdentifier" type="PCORequestForCustomsESDIdentifier_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PCORequestForCustomsESDIdentifier: Request for an identifier for a ESD (Export Shipment Dossier) to a customs authority.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PCOShipmentReport" type="PCOShipmentReport_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PCOShipmentReport: Preliminary information for writing the SAD related to a shipment by a customs software</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PCOPreliminaryInformation" type="PCOPreliminaryInformation_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PCOPreliminaryInformation: Contains information to activate the PCO service</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="MCIInformationSupply" type="MCIInformationSupply_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>MCIInformationSupply: information supplying for data collection for the Material Circularity (MCI methodology) assessment of the textile product</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="MCIPreliminaryInformationSupply" type="MCIPreliminaryInformationSupply_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>MCIPreliminaryInformationSupply: preliminary information supplying for data collection for the Material Circularity (MCI methodology) assessment of the textile product. Some information might be initially omitted in respect of the MCIInformationSupply document</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PCOExportShippingManifesto" type="PCOExportShippingManifesto_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PCOExportShippingManifesto: Manifesto of the Export Shipping Dossier (ESD) to be presented to the customs authority in support of the export customs declaration.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="SRVIndicatorsDeclaration" type="SRVIndicatorsDeclaration_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SRVindicatorsdeclaration: Declaration of the obtained sustainability indicators</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PEFpreliminaryinformation" type="PEFpreliminaryinformation_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PEFpreliminaryinformation: Preliminary data for PEF and product environmental footprint data collection</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PEFInformationSupply" type="PEFInformationSupply_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PEFinformationSupply: information supplying for PEF and product environmental footprint data collection</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="SRVServiceResultsReaction" type="SRVServiceResultsReaction_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SRVServiceResultsReaction: User reaction to the results of the assessment performed by the service. Includes disclosure instructions.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="SEpreliminaryinformation" type="SEpreliminaryinformation_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SEpreliminaryinformation: Preliminary data or Social and Ethical Protection data collection</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="SEInformationSupply" type="SEInformationSupply_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SEinformationSupply: information supplying for Social and Ethical Protection data collection</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="SRVFinalResponse" type="SRVFinalResponse_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SRVfinalresponse: Service final report and proposed actions (if any)</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="HPInformationSupply" type="HPInformationSupply_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>HPinformationsupply: information supplying for Health Protection data collection</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="SRVinformationrequest" type="SRVinformationrequest_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>SRVinformationrequest: request for further information, assertion, certificates and laboratory tests in order to accomplish the requested service</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="HPPreliminaryInformation" type="HPPreliminaryInformation_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>HPpreliminaryinformation: Preliminary data for Health Protection data collection</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="GPDocAvailability" type="GPDocAvailability_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>GPDocAvailability: Document Availability Advise</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TRCTRAReport" type="TRCTRAReport_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRCTRAreport: Traceability Report for one or more lots or items of a good</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TRCDesAdvise" type="TRCDesAdvise_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRCDesAdvise: Despatching Advise for traceability of goods sent upon any business transaction</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TRCRecAdvise" type="TRCRecAdvise_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRCRecAdvise: Receiving Advise for traceability of goods sent upon any business transaction</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TRCTRNReport" type="TRCTRNReport_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRCTRNreport: Transparency Report for one or more products and facilities</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="FASCatalog" type="FASCatalog_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>FASCatalog: FASHION articles catalogue and pricelist</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="GARMasterData" type="GARMasterData_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>GARMasterData: Fashion Master Data is the document used by the Buyer to inform the Supplier about technical features of an item that he will receive.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="PARTIn" type="PARTIn_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>PARTIN: Party information message to be used to provide basic information (address, contact references, trading data, payment references, etc.) regarding one or more parties involved in a commercial transaction.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXPrintOrdChange" type="TEXPrintOrdChange_Type" minOccurs="0" maxOccurs="1">
