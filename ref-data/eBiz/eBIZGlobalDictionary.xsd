                    <xsd:documentation>
                        <eds:Definition>YARNDyeOrdResponse: Dyeing order response for a yarn</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWDyeOrdChange" type="RAWDyeOrdChange_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWDyeOrdChange: Dyeing Order Change for a raw material</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWDyeOrdResponse" type="RAWDyeOrdResponse_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWDyeOrdResponse: Dyeing Order Response for a raw material</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWWorkInv" type="RAWWorkInv_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWWorkInv: Raw Material in Work Inventory report</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RAWOrdStatus" type="RAWOrdStatus_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>RAWOrdStatus: Order status report for works on the raw material</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="GARStockStat" type="GARStockStat_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>GARStockStat: Garment Stock Offer Status</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXControlOrder" type="TEXControlOrder_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TEXControlOrder: Control (inspection) order for a fabric piece</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TEXDyFinOffer" type="TEXDyFinOffer_Type" minOccurs="0" maxOccurs="1">
