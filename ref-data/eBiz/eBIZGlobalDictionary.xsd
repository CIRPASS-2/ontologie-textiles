            <xsd:element name="added" type="added_Type" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>article's additional identifier: additional code of the product (complementing the formers)</eds:Definition>
