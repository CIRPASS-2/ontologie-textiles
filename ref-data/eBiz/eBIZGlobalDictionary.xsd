                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            </xsd:choice>
            <xsd:element name="experimValue" type="experimValue_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>experimental measure: experimental value of the measurement</eds:Definition>
                        <eds:AggregationNote>this data can be iterated to provide  repeated instances of the same test</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="comply" type="comply_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>compliance indicator: specifies if the experimental value complies with the standard requirement (target value)</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="note" type="note_Type" minOccurs="0" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>general note: free text or structured (computer processing) note. For note structuring use the attributes "noteLabel" and "codelist"</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

