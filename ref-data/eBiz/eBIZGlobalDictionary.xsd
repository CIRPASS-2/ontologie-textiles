            <xsd:element name="productCompos" type="productCompos_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>product composition: Quantitative composition of a product</eds:Definition>
                        <eds:AggregationNote>mandatory to specify the feedstock share from reused sources, from recycled sources  (and related efficiency of the recycling process) and from renewable sources</eds:AggregationNote>
