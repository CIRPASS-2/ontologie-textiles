	{"@id":"gpc:20002476","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Water Treatment","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of water treatment."},
	{"@id":"gpc:20002848","type":["gpc:Attribute","rdf:Property"],"label_en":"Rim Diameter Inches","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the rim diameter"},
	{"@id":"gpc:20002364","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Jamb","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of jamb."},
	{"@id":"gpc:20000376","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Hair Styling (Non Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify different hair styling products."},
	{"@id":"gpc:20002552","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Down Spout Parts/Fittings","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of Downspout Part or Fitting used as part of a drainage system."},
