	{"@id":"gpc:50350100","type":"gpc:Class","label_en":"Chicory Leaves","subClassOf":"gpc:50350000","comment_en":"This standard applies to Chicory leaves, a somewhat woody, perennial herbaceous plant leaf which are cultivated for salad leaves. It is native to Europe, and in North America and Australia, where it has become naturalized."},
	{"@id":"gpc:50350200","type":"gpc:Class","label_en":"Head Lettuce","subClassOf":"gpc:50350000","comment_en":"This standard applies to Head/Iceberg Lettuce of varieties (cultivars) grown from Lactuca sativa L. var. capitata L. to be supplied fresh."},
	{"@id":"gpc:50350300","type":"gpc:Class","label_en":"Loose Leaf/Multileaf Salad Greens","subClassOf":"gpc:50350000","comment_en":"This standard applies to loose or multi leaf lettuce grown from Lactuca sativa L. var. crispa L. to be supplied fresh."},
	{"@id":"gpc:50350400","type":"gpc:Class","label_en":"Single Leaf Salad Greens","subClassOf":"gpc:50350000","comment_en":"This standard applies to single leaf greens of varieties (cultivars) grown from all botanical species to be supplied fresh."},
	{"@id":"gpc:50350500","type":"gpc:Class","label_en":"Spinach (Fresh)","subClassOf":"gpc:50350000","comment_en":"This Class contains Spinach (Spinacia oleracea), an edible flowering plant in the family of Amaranthaceae. While native to central and south western Asia, it is commonly grown through out the world. It grows to a height of up to 30 cm long and 1-15 cm broad, with larger leaves at the base of the plant and small leaves higher on the flowering stem. Spinach has a high nutritional value and is extremely rich in antioxidants, especially when fresh, steamed, or quickly boiled. It is rich in vitamins."},
	{"@id":"gpc:50350600","type":"gpc:Class","label_en":"Leaf Vegetables - Unprepared/Unprocessed Variety Packs","subClassOf":"gpc:50350000"},
	{"@id":"gpc:50350700","type":"gpc:Class","label_en":"Stem Lettuce","subClassOf":"gpc:50350000","comment_en":"This standard applies to Stem Lettuce of varieties (cultivars) grown from&#160; Lactuca sativa&#160;var.&#160;asparagina,&#160;augustana, or&#160;angustata &#160;to be supplied fresh."},
