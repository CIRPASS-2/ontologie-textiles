	{"@id":"gpc:20002040","type":["gpc:Attribute","rdf:Property"],"label_en":"If Reinforced","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product type is reinforced with extra protection against the build up of pressure."},
	{"@id":"gpc:20002119","type":["gpc:Attribute","rdf:Property"],"label_en":"Bound/Unbound","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is bound and if so, what type of binding is used."},
	{"@id":"gpc:20002878","type":["gpc:Attribute","rdf:Property"],"label_en":"Drive Type","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the drive type of the car, bus or truck."},
	{"@id":"gpc:20001419","type":["gpc:Attribute","rdf:Property"],"label_en":"Specified Number of Persons","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the number of persons that can use the product at one time."},
	{"@id":"gpc:20003093","type":["gpc:Attribute","rdf:Property"],"label_en":"Number of Poles","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the number of poles needed."},
	{"@id":"gpc:20002566","type":["gpc:Attribute","rdf:Property"],"label_en":"Automatic/Mechanical","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product makes a connection automatically or through mechanical operation."},
	{"@id":"gpc:20002435","type":["gpc:Attribute","rdf:Property"],"label_en":"Radius Corner","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the radius of the corner."},
	{"@id":"gpc:20001251","type":["gpc:Attribute","rdf:Property"],"label_en":"Number of Speaker Output Channels","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the number of speaker output channels."},
	{"@id":"gpc:20002136","type":["gpc:Attribute","rdf:Property"],"label_en":"If Keyless Entry System","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the alarm type has a keyless entry system."},
	{"@id":"gpc:20002446","type":["gpc:Attribute","rdf:Property"],"label_en":"Padded/Non-padded","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is encased in rubber or a non-slip material to enable a better grip."},
	{"@id":"gpc:20002522","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Paint Additive/Enhancer","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the enhancing properties of the paint additive."},
	{"@id":"gpc:20000192","type":["gpc:Attribute","rdf:Property"],"label_en":"Firmness of Cheese","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the firmness of the cheese product."},
	{"@id":"gpc:20002189","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Multi-control Switch","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product comes with a multi-control switch."},
	{"@id":"gpc:20000156","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sandwich/Filled Roll/Wrap","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify a type of sandwich, filled roll or wrap."},
	{"@id":"gpc:20001350","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sculptors/Pottery Craft Material","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of sculptors or pottery supply material."},
	{"@id":"gpc:20002132","type":["gpc:Attribute","rdf:Property"],"label_en":"If Shock Absorbing","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is designed with shock absorbing capability."},
	{"@id":"gpc:20002663","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Car Video/Navigation - Replacement Part/Accessory","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of car video navigation replacement part or accessory."},
	{"@id":"gpc:20002879","type":["gpc:Attribute","rdf:Property"],"label_en":"Maximum Number of Passengers","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the number of persons that can be transported by the vehicle."},
	{"@id":"gpc:20002205","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Auto Reverse","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has an automatic reverse function which turns the tape over and plays the other side."},
	{"@id":"gpc:20001375","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Basketry Craft Accessory","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of basketry craft accessory."},
	{"@id":"gpc:20002468","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Bracket/Brace","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the design of a bracket or brace."},
	{"@id":"gpc:20000534","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Lubricant","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains a lubricant."},
	{"@id":"gpc:20002912","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Presentation Board (Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of powered presentation board."},
	{"@id":"gpc:20002475","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Central Heating Replacement Part/Accessory","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of central heating replacement part or accessory."},
	{"@id":"gpc:20002917","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Kale","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the type of Kale."},
	{"@id":"gpc:20001939","type":["gpc:Attribute","rdf:Property"],"label_en":"Fitting Type","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify how the product is fixed in position."},
	{"@id":"gpc:20001060","type":["gpc:Attribute","rdf:Property"],"label_en":"Platform","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the product platform."},
	{"@id":"gpc:20001087","type":["gpc:Attribute","rdf:Property"],"label_en":"If Wireless","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is wireless."},
	{"@id":"gpc:20000646","type":["gpc:Attribute","rdf:Property"],"label_en":"If Water Resistant","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is water resistant."},
	{"@id":"gpc:20002322","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Storm Shelter","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of storm shelter."},
	{"@id":"gpc:20002816","type":["gpc:Attribute","rdf:Property"],"label_en":"In Shell Pasteurisation","comment_en":"Indicates, with reference to the product branding, labeling or packaging, the descriptive term that is used by the product manufacturer to describe the type of manufacturers treatment/cooking process the product has undergone."},
	{"@id":"gpc:20002558","type":["gpc:Attribute","rdf:Property"],"label_en":"If Flanged","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has a protruding rim used to strengthen or hold the product firmly in place."},
	{"@id":"gpc:20002629","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Microphone Attachment","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify where or how the microphone is attached."},
	{"@id":"gpc:20000681","type":["gpc:Attribute","rdf:Property"],"label_en":"If Synthetic","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is synthetic."},
	{"@id":"gpc:20001966","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sporting Activity","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of sporting activity for which the product is intended to be worn."},
	{"@id":"gpc:20003105","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fondue Set Accessory/Spare Part (Non Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of accessory/spare part for non-powered fondue set."},
	{"@id":"gpc:20002882","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Engine Degreaser/Pollution Control","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of engine degreaser or pollution control product."},
	{"@id":"gpc:20003166","type":["gpc:Attribute","rdf:Property"],"label_en":"Waist Height","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the waist height."},
	{"@id":"gpc:20002078","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Gardening Kneelers/Seats","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify how the product is designed to be used."},
	{"@id":"gpc:20002847","type":["gpc:Attribute","rdf:Property"],"label_en":"Commercial Type of Oranges","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the commercial category of oranges."},
	{"@id":"gpc:20002669","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Console Accessory","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of console accessory."},
	{"@id":"gpc:20002125","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Belt/Holster/Pouch","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of a belt, holster or pouch."},
	{"@id":"gpc:20001116","type":["gpc:Attribute","rdf:Property"],"label_en":"Corded/Cordless","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is connected to a base unit or power supply by a cord."},
	{"@id":"gpc:20000170","type":["gpc:Attribute","rdf:Property"],"label_en":"Style of Beer","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify a particular style of beer."},
	{"@id":"gpc:20002093","type":["gpc:Attribute","rdf:Property"],"label_en":"Continuous/Intermittent","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is designed to work continuously or intermittently."},
	{"@id":"gpc:20001886","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Garden Shears","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used to identify the type of garden shears."},
	{"@id":"gpc:20003034","type":["gpc:Attribute","rdf:Property"],"label_en":"Theme or Occasion"},
	{"@id":"gpc:20002535","type":["gpc:Attribute","rdf:Property"],"label_en":"Response Time","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the time taken to respond to an overcurrent condition."},
	{"@id":"gpc:20000526","type":["gpc:Attribute","rdf:Property"],"label_en":"Form","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the form of the product."},
	{"@id":"gpc:20002995","type":["gpc:Attribute","rdf:Property"],"label_en":"If Packaged for Vending Machine","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to indicate that the product is packaged for a vending machine."},
	{"@id":"gpc:20002897","type":["gpc:Attribute","rdf:Property"],"label_en":"Ultra Violet (UV) Protection","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the ultra violet (UV) protection of the product, usually labelled as a numerical Sun Protection Factor (SPF)."},
	{"@id":"gpc:20001346","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sand Art Supplies","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of sand art supplies."},
	{"@id":"gpc:20002038","type":["gpc:Attribute","rdf:Property"],"label_en":"Fletching Material","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the material of the arrow fletching."},
	{"@id":"gpc:20000134","type":["gpc:Attribute","rdf:Property"],"label_en":"Method of Cooking/Reheating","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the method of heating or cooking the product."},
	{"@id":"gpc:20002256","type":["gpc:Attribute","rdf:Property"],"label_en":"Finish Type","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has been processed prior to distribution."},
	{"@id":"gpc:20002771","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Bottle Closure","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the type of closure of the wine bottle."},
	{"@id":"gpc:20001126","type":["gpc:Attribute","rdf:Property"],"label_en":"If Colour Screen","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product includes a colour screen."},
	{"@id":"gpc:20001804","type":["gpc:Attribute","rdf:Property"],"label_en":"Consistency","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the physical state of the product, not including the packaging."},
	{"@id":"gpc:20001183","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Home Audio Cassette Deck","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacture to identify the number of cassettes that the product can hold."},
	{"@id":"gpc:20002061","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Modem","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is supplied with a modem."},
	{"@id":"gpc:20002234","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Screwdriver/Rotary Tool","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of screwdriver with reference to its functionality."},
	{"@id":"gpc:20002682","type":["gpc:Attribute","rdf:Property"],"label_en":"Goat Cut","comment_en":"The portion of the animal present in the product and the product&apos;s customary presentation as defined by a United Nations product identity standard or other recognized, public domain standards if no standard has yet been established for that product by the United Nations."},
	{"@id":"gpc:20000657","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Firelighting Tools/Matches","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to differentiate firelighting tools and matches."},
	{"@id":"gpc:20000067","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fish","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of fish."},
	{"@id":"gpc:20002739","type":["gpc:Attribute","rdf:Property"],"label_en":"Growing Method","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the presence of an industry recognized &quot;Organic&quot; or &quot;Transitional&quot; certification upon the product labelling or packaging."},
	{"@id":"gpc:20001509","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fishing Rod/Pole","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of fishing rod or pole."},
	{"@id":"gpc:20002151","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Puzzle","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of puzzle."},
	{"@id":"gpc:20002383","type":["gpc:Attribute","rdf:Property"],"label_en":"Climatic Zone","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the geographical zone, taking into account temperature, in which the animal lives prevails."},
	{"@id":"gpc:20000658","type":["gpc:Attribute","rdf:Property"],"label_en":"If Waterproof","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is waterproof."},
	{"@id":"gpc:20001598","type":["gpc:Attribute","rdf:Property"],"label_en":"Fan Assisted/Non Fan Assisted","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify whether the product is fan assisted or not."},
	{"@id":"gpc:20000262","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Bleaching/Lightening Product","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to differentiate between those bleaching/lightening products that can be used on the face or body or both."},
	{"@id":"gpc:20001217","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Converter Cassette","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of converter cassette."},
	{"@id":"gpc:20001950","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Trousers/Shorts","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of trousers or shorts."},
	{"@id":"gpc:20002319","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Liferaft/Life-Buoy/Flotation Cushion","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of liferaft, lifebuoy or flotation cushion."},
	{"@id":"gpc:20000169","type":["gpc:Attribute","rdf:Property"],"label_en":"Strength of Tobacco","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the strength of the tobacco product."},
	{"@id":"gpc:20002143","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Securing Equipment","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of securing product described."},
	{"@id":"gpc:20000999","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Handbag/Shoulder Bag","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of handbag or shoulder bag."},
	{"@id":"gpc:20002900","type":["gpc:Attribute","rdf:Property"],"label_en":"Aspect Ratio","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the tread width of the aspect ratio, which is the ratio of the height to the width."},
	{"@id":"gpc:20000202","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Honey","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify a particular type of honey."},
	{"@id":"gpc:20002392","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Plaster Mix","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of plaster mix in relation to the substance it is based upon."},
	{"@id":"gpc:20001483","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Game Lure/Decoy/Caller","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of game lure or decoy or caller."},
	{"@id":"gpc:20002388","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Grit","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the texture or fineness of the grit."},
	{"@id":"gpc:20000092","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Caffeine","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains caffeine."},
	{"@id":"gpc:20002221","type":["gpc:Attribute","rdf:Property"],"label_en":"If with Case","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has a case to protect it from scratches whilst in use."},
	{"@id":"gpc:20002577","type":["gpc:Attribute","rdf:Property"],"label_en":"If with Seating Arrangement","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has the additional functionality of being used as a furniture item."},
	{"@id":"gpc:20001914","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Weather Resistance","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used to identify whether the product has been treated to resist the corrosive or damaging effects of weather."},
	{"@id":"gpc:20002382","type":["gpc:Attribute","rdf:Property"],"label_en":"Environment","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the natural environment in which the animal lives."},
	{"@id":"gpc:20002832","type":["gpc:Attribute","rdf:Property"],"label_en":"Intended Use","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to differentiate between strength and intented used of vitamins, minerals and combination."},
	{"@id":"gpc:20001340","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Artists Pastel/Charcoal/Crayon","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of pastel, charcoal or crayon."},
	{"@id":"gpc:20001541","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Humidity Control","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify whether the appliance has a humidity control."},
	{"@id":"gpc:20003003","type":["gpc:Attribute","rdf:Property"],"label_en":"Lifestage of Pet","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the lifestage of the pet."},
	{"@id":"gpc:20002802","type":["gpc:Attribute","rdf:Property"],"label_en":"Colour of Flesh of Watermelon","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify coulour of flesh of the Watermelon."},
	{"@id":"gpc:20003133","type":["gpc:Attribute","rdf:Property"],"label_en":"If Non-Chilled Filtered"},
	{"@id":"gpc:20002271","type":["gpc:Attribute","rdf:Property"],"label_en":"With/Without Spout","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has a spout."},
	{"@id":"gpc:20003044","type":["gpc:Attribute","rdf:Property"],"label_en":"Single Player or Multiplayer","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is intended to be used by a single player or multiple players."},
	{"@id":"gpc:20002803","type":["gpc:Attribute","rdf:Property"],"label_en":"If Mini","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer fruits/vegetables to indicates whether or not the produce is a Mini or Baby product. Miniature product means a variety or cultivar of vegetable, obtained by plant breeding and/or special cultivation techniques, excluding specimens of non-miniature varieties which have not fully developed or are of inadequate size."},
	{"@id":"gpc:20002729","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Unit Load Device (ULD)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the unit load device."},
	{"@id":"gpc:20000219","type":["gpc:Attribute","rdf:Property"],"label_en":"Style of Fortified Wine","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify a particular style of fortified wine."},
	{"@id":"gpc:20000038","type":["gpc:Attribute","rdf:Property"],"label_en":"Format of Cigar","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular format or variety of cigar."},
