	{"@id":"gpc:20002008","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Amplifier/Preamplifier","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is an amplifier or a preamplifier."},
	{"@id":"gpc:20000328","type":["gpc:Attribute","rdf:Property"],"label_en":"If Ammonia Free","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains ammonia."},
	{"@id":"gpc:20002028","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Adjustable Handle","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is complete with an adjustable handle."},
	{"@id":"gpc:20000433","type":["gpc:Attribute","rdf:Property"],"label_en":"Application Method","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the application method of the product."},
	{"@id":"gpc:20002564","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Distribution Board/Box","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of distribution board or box."},
	{"@id":"gpc:20003000","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Oral Hygiene - Replacement Parts","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of oral hygiene replacement part."},
	{"@id":"gpc:20002927","type":["gpc:Attribute","rdf:Property"],"label_en":"With Beverage"},
	{"@id":"gpc:20000544","type":["gpc:Attribute","rdf:Property"],"label_en":"Homeopathic Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has a homeopathic claim."},
	{"@id":"gpc:20003073","type":["gpc:Attribute","rdf:Property"],"label_en":"Variety of Mint","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the variety of Mint."},
	{"@id":"gpc:20000116","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Pulp","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains fruit or vegetable pulp."},
	{"@id":"gpc:20001337","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Artists Brush/Applicator","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of artist&apos;s brush or applicator."},
	{"@id":"gpc:20002251","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Applicator/Brush","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of applicator."},
	{"@id":"gpc:20003046","type":["gpc:Attribute","rdf:Property"],"label_en":"Is Recessed","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is recessed."},
	{"@id":"gpc:20002448","type":["gpc:Attribute","rdf:Property"],"label_en":"If with Hatch Included","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the ladder is sold with a hatch included"},
	{"@id":"gpc:20002470","type":["gpc:Attribute","rdf:Property"],"label_en":"Manual/Digital","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is controlled by manual or digital operation."},
	{"@id":"gpc:20002825","type":["gpc:Attribute","rdf:Property"],"label_en":"Lettering","comment_en":"The style or form of lettering or wording which is used present with the product. This lettering can be attached to the sign to provide information to readers of the sign."},
	{"@id":"gpc:20001053","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Personal Computer - Portable","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of portable personal computer."},
	{"@id":"gpc:20002549","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Guttering Parts/Fittings","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the specific guttering parts or fittings that allow the safe drainage of water."},
	{"@id":"gpc:20000755","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Recycled Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product claims to be made from recycled paper."},
	{"@id":"gpc:20003163","type":["gpc:Attribute","rdf:Property"],"label_en":"If Push Up","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product has a supportive underwire and moulded cups made to maximize the bust."},
	{"@id":"gpc:20003037","type":["gpc:Attribute","rdf:Property"],"label_en":"Fiction/Non-Fiction","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is fiction or non-fiction."},
	{"@id":"gpc:20002849","type":["gpc:Attribute","rdf:Property"],"label_en":"Cooking Type Of Potatoes","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer that specifies the cooking characteristics of potatoes . For culinary purposes, varieties are often described in terms of their waxiness."},
	{"@id":"gpc:20002332","type":["gpc:Attribute","rdf:Property"],"label_en":"If Fire Resistant","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is fire resistant."},
	{"@id":"gpc:20000997","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Body Bag/Waist Bag","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of body or waist bag."},
	{"@id":"gpc:20000003","type":["gpc:Attribute","rdf:Property"],"label_en":"Age of Product","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the quantitative term that is used by the product manufacturer to identify the precise number of years that the product has been aged prior to being offered for sale."},
	{"@id":"gpc:20001649","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Mirrors - Personal Care","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of personal care mirror."},

