	{"@id":"gpc:20001379","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Glasswork/Enamelling/Marquetry Craft Material","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of glasswork, enamelling or marquetry crafting material."},
