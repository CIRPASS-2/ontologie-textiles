	{"@id":"gpc:20000073","type":["gpc:Attribute","rdf:Property"],"label_en":"Fresh or Seawater Farmed","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the whether the product has been fresh or sea water farmed."},
	{"@id":"gpc:20002730","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Container","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of container."},
	{"@id":"gpc:20000538","type":["gpc:Attribute","rdf:Property"],"label_en":"Frequency of Application","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify how often the product should be applied."},
	{"@id":"gpc:20000801","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Baby Feeding Aid","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify different types of baby feeding aids."},
