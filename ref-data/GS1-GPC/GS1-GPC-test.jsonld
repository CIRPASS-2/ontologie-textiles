	{"@id":"gpc:20003141","type":["gpc:Attribute","rdf:Property"],"label_en":"Secondary Added Flavouring","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the secondary flavouring added to the product."},
	{"@id":"gpc:20001112","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fixed Communication Pre-pay Voucher/Calling Card","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of fixed communication device pre-pay voucher or calling card."},
	{"@id":"gpc:20003162","type":["gpc:Attribute","rdf:Property"],"label_en":"If Stretch","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is made of stretch material."},
	{"@id":"gpc:20001810","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Water Feature","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used to identify the type of water feature."},
	{"@id":"gpc:20000204","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Flavour","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of Flavour the product has."},
	{"@id":"gpc:20002217","type":["gpc:Attribute","rdf:Property"],"label_en":"Number of Suction Cups","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the number of suction pads the suction lifter uses to lift awkward items. The more suction pads the more control the user will have over large, bulky items."},
	{"@id":"gpc:20002245","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Cleaning Appliances Replacement Part/Accessory","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of cleaning appliance replacement part or accessory."},
	{"@id":"gpc:20001722","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Storage Rail/Holder","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of storage rail or holder."},
	{"@id":"gpc:20000899","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Presentation Equipment Accessory","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of presentation equipment accessory."},
	{"@id":"gpc:20002464","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Garage Door","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of the garage door in relation to its running gear."},
	{"@id":"gpc:20002053","type":["gpc:Attribute","rdf:Property"],"label_en":"Container","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the plant is sold as &apos;containerised&apos; or not."},
	{"@id":"gpc:20003018","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Grain","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the particular type or variety of grain."},
	{"@id":"gpc:20002152","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Doll/Soft Toy","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of doll or soft toy."},
	{"@id":"gpc:20000732","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Baby/Infant Specialised Formula","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of specialised baby or infant formula product."},
	{"@id":"gpc:20002516","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Locking Brake","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has a locking brake."},
	{"@id":"gpc:20000571","type":["gpc:Attribute","rdf:Property"],"label_en":"Gas Permeable/Soft Contact Lens","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that it used by the product manufacturer to identify whether a contact lens is gas permeable or soft."},
	{"@id":"gpc:20001642","type":["gpc:Attribute","rdf:Property"],"label_en":"If UV Protection Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product provides UV Protection."},
	{"@id":"gpc:20002484","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fireplace/Fireplace Surround/Mantel Shelf","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of fireplace, fireplace surround or mantel shelf."},
	{"@id":"gpc:20003128","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Tableware Accessory Other","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of table accessory."},
	{"@id":"gpc:20001472","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Targets (Non Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of non-powered target."},
	{"@id":"gpc:20000475","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Non Personal Repellent","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify different types of insects/rodents that the non-personal repellents are used for."},
	{"@id":"gpc:20002207","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Desktop Mat","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of desktop mat."},
	{"@id":"gpc:20001723","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Household Organiser/Tidy","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of household organiser or tidy."},
	{"@id":"gpc:20002088","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Component","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of product component."},
	{"@id":"gpc:20002693","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Watch Mechanism","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of watch mechanism."},
	{"@id":"gpc:20000753","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Aquatic Invertebrate/Fish/Shellfish/Seafood Mix","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of aquatic invertebrate, fish, shellfish and seafood mix."},
	{"@id":"gpc:20000050","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Dessert Sauce/Topping/Filling","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify a particular type of dessert topping/filling or sauce."},
	{"@id":"gpc:20002393","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Cement","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of cement in relation to its composition."},
	{"@id":"gpc:20000056","type":["gpc:Attribute","rdf:Property"],"label_en":"Diabetic Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging, whether the product makes a claim to be suitable for consumption by consumers who have diabetes."},
	{"@id":"gpc:20000499","type":["gpc:Attribute","rdf:Property"],"label_en":"If Coloured","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is coloured."},
	{"@id":"gpc:20002617","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Loudspeakers","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is supplied with loudspeakers."},
	{"@id":"gpc:20001418","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sled","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of sled."},
	{"@id":"gpc:20000691","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Hair Aid (Non Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify different hair products that are essential to hair maintenance."},
	{"@id":"gpc:20002349","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Flooring Accessory","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of flooring accessory."},
	{"@id":"gpc:20002417","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Deck Railing","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the material of the deck railing."},
	{"@id":"gpc:20002085","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Garden Power Tool Replacement Parts/Accessories","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the replacement part or accessory designed to enhance the usability of a garden power tool."},
	{"@id":"gpc:20001478","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Airgun Propulsion","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of airgun propulsion."},
	{"@id":"gpc:20000514","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Home Diagnostic Test","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the different types of home diagnostic tests."},
	{"@id":"gpc:20003022","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Personal Transport","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of personal transport."},
	{"@id":"gpc:20002926","type":["gpc:Attribute","rdf:Property"],"label_en":"With Dessert/Treat"},
	{"@id":"gpc:20002902","type":["gpc:Attribute","rdf:Property"],"label_en":"Speed Rating","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the speed rating. If a listed speed rating contains two letters (such as VR), the first letter represents the speed rating and the second letter (R) indicates that it is a radial tire."},
	{"@id":"gpc:20002133","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Stationery Adhesive Tape","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of adhesive stationery tape."},
	{"@id":"gpc:20001245","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Car Video Receiving Equipment","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of car video receiving equipment."},
	{"@id":"gpc:20002987","type":["gpc:Attribute","rdf:Property"],"label_en":"Shaft Height","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the shaft height of the boot. &#160;This is measured from the middle of the arch up the outsole of the boot to the top of the boot."},
	{"@id":"gpc:20002316","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Attached Respirator","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has an incorporated respirator."},
	{"@id":"gpc:20001582","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Electric Graters","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the type of product."},
	{"@id":"gpc:20001107","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Wave Filter","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product contains a wave filter."},
	{"@id":"gpc:20001014","type":["gpc:Attribute","rdf:Property"],"label_en":"If Anti-radiation","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product has anti-radiation properties."},
	{"@id":"gpc:20002080","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Razor/Barbed Wire Fencing","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the fencing has barbs or razors to increase security."},
	{"@id":"gpc:20002638","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Adaptor","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of adaptor."},
	{"@id":"gpc:20002404","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sand","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of sand used in construction in relation to its composition."},
	{"@id":"gpc:20002910","type":["gpc:Attribute","rdf:Property"],"label_en":"IF Battery Backup","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has a built-in battery backup."},
	{"@id":"gpc:20002461","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Cistern","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of cistern."},
	{"@id":"gpc:20002016","type":["gpc:Attribute","rdf:Property"],"label_en":"If With DVD Functionality","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product has the functionality to play pre-recorded DVDs."},
	{"@id":"gpc:20002204","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Detachable Faceplate","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has a detachable faceplate."},
	{"@id":"gpc:20001890","type":["gpc:Attribute","rdf:Property"],"label_en":"If Telescopic","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used to identify whether the product is telescopic."},
	{"@id":"gpc:20002478","type":["gpc:Attribute","rdf:Property"],"label_en":"Mechanical/Digital","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is operated mechanically or digitally."},
	{"@id":"gpc:20002314","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fire Escape Chute/Ladder","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of fire escape chute or ladder."},
	{"@id":"gpc:20003002","type":["gpc:Attribute","rdf:Property"],"label_en":"State of Pet Nutritional Supplement","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the state the nutritional supplement is sold."},
	{"@id":"gpc:20001697","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Kitchen Knife","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of kitchen knife."},
	{"@id":"gpc:20001720","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Handles","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has handles to facilitate being moved or carried."},
	{"@id":"gpc:20003031","type":["gpc:Attribute","rdf:Property"],"label_en":"Veal Cut","comment_en":"The portion of the animal present in the product and the product&apos;s customary presentation as defined by a United Nations product identity standard or other recognized, public domain standards if no standard has yet been established for that product by the United Nations."},
	{"@id":"gpc:20002871","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Engine Oil Target","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of engine oil target for the lubricate."},
	{"@id":"gpc:20000933","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Paper Measuring Guide","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has a paper measuring guide."},
	{"@id":"gpc:20000995","type":["gpc:Attribute","rdf:Property"],"label_en":"Specified Occasion","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is intended for a specific occasion."},
	{"@id":"gpc:20001149","type":["gpc:Attribute","rdf:Property"],"label_en":"Colour Format","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the colour format."},
	{"@id":"gpc:20000228","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Chocolate/Cocoa/Malt","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the particular type or variety of chocolate, cocoa and malt."},
	{"@id":"gpc:20002723","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Pallet","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of pallet."},
	{"@id":"gpc:20001529","type":["gpc:Attribute","rdf:Property"],"label_en":"Energy Type","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify what form of energy the appliance uses to fuel its operation."},
	{"@id":"gpc:20002462","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Flush","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the flush mechanism is manually operated or automatically activated by sensors."},
	{"@id":"gpc:20001898","type":["gpc:Attribute","rdf:Property"],"label_en":"If Adjustable","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used to identify whether the product is capable of being changed so as to match or fit the user&apos;s needs."},
	{"@id":"gpc:20002966","type":["gpc:Attribute","rdf:Property"],"label_en":"If Marking","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has the possibility to affix marks (e.g. front - left)."},
	{"@id":"gpc:20002370","type":["gpc:Attribute","rdf:Property"],"label_en":"If Self-Adhesive","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is self-adhesive."},
	{"@id":"gpc:20001063","type":["gpc:Attribute","rdf:Property"],"label_en":"Reading Device","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the reading device."},
	{"@id":"gpc:20002155","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Building/Setting","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of toy building or setting that is designed to enhance play activity with dolls."},
	{"@id":"gpc:20002681","type":["gpc:Attribute","rdf:Property"],"label_en":"Chicken Cut","comment_en":"The portion of the animal present in the product and the product&apos;s customary presentation as defined by a United Nations product identity standard or other recognized, public domain standards if no standard has yet been established for that product by the United Nations."},
	{"@id":"gpc:20003021","type":["gpc:Attribute","rdf:Property"],"label_en":"If Pasteurized","comment_en":"Indicates, with reference to the product branding, labelling or&#160;packaging the descriptive term that is used by the product manufacturer to identify if the product is pasteurized or not."},
	{"@id":"gpc:20001041","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Tape Drives/Streamers","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of tape drive or streamer."},
	{"@id":"gpc:20001192","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Vinyl Turntables","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of vinyl turntable."},
