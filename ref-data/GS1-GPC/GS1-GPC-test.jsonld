	{"@id":"gpc:20000147","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Sweet Pie or Pastry","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of pie or pastry product."},
	{"@id":"gpc:20000641","type":["gpc:Attribute","rdf:Property"],"label_en":"If Long Lasting Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product claims to be longer lasting than other similar products."},
	{"@id":"gpc:20000118","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Jam/Marmalade","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify a particular type of jam, and marmalade product."},
	{"@id":"gpc:20000536","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Spermicide","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains a spermicide."},
	{"@id":"gpc:20002445","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Drainage Apertures","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has apertures to allow the drainage of water."},
	{"@id":"gpc:20002623","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Aerator","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is fitted with an aerator."},
	{"@id":"gpc:20000672","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Plug","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify different types of electrical plugs."},
	{"@id":"gpc:20001175","type":["gpc:Attribute","rdf:Property"],"label_en":"If World Receiver Functionality","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has a world receiver functionality, which allows access to world wide broadcasts."},
	{"@id":"gpc:20000602","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Baby Hygiene Product","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the different types of baby hygiene product."},
	{"@id":"gpc:20002686","type":["gpc:Attribute","rdf:Property"],"label_en":"Porcine Cut","comment_en":"The portion of the animal present in the product and the product&apos;s customary presentation as defined by a United Nations product identity standard or other recognized, public domain standards if no standard has yet been established for that product by the United Nations."},
	{"@id":"gpc:20002959","type":["gpc:Attribute","rdf:Property"],"label_en":"Colour of Skin of Watermelon"},
	{"@id":"gpc:20000191","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Cereal/Grain","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the particular type or variety of cereal or grain."},
	{"@id":"gpc:20003019","type":["gpc:Attribute","rdf:Property"],"label_en":"Multivitamin Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify whether or not the product contains multiple vitamins."},
	{"@id":"gpc:20002929","type":["gpc:Attribute","rdf:Property"],"label_en":"Is Ready To Be Consumed"},
	{"@id":"gpc:20002792","type":["gpc:Attribute","rdf:Property"],"label_en":"Colour of Onions","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the colour of Onions."},
	{"@id":"gpc:20003008","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Automotive Instruments/Measurement Systems","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the type of automotive instruments/measurement system."},
	{"@id":"gpc:20002302","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Serrated Blades","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has serrated blades."},
	{"@id":"gpc:20002793","type":["gpc:Attribute","rdf:Property"],"label_en":"If Ripened","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the Banana is in a ripening stage."},
	{"@id":"gpc:20002805","type":["gpc:Attribute","rdf:Property"],"label_en":"Degree of Dryness of Garlic","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the level of dryness of Garlic."},
	{"@id":"gpc:20002323","type":["gpc:Attribute","rdf:Property"],"label_en":"Mounting Options","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is mounted internally or externally to survival craft."},
	{"@id":"gpc:20002100","type":["gpc:Attribute","rdf:Property"],"label_en":"Method of Ink Application","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify how the ink is applied to the product."},
	{"@id":"gpc:20003039","type":["gpc:Attribute","rdf:Property"],"label_en":"Permanence of Ink","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the permanence of the ink."},
	{"@id":"gpc:20002867","type":["gpc:Attribute","rdf:Property"],"label_en":"Sharpness of Cheese","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the sharpness of the taste of the product. Usually the longer the aging of the product, the sharper the taste."},
	{"@id":"gpc:20001953","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Cooking Sauce","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of cooking sauce."},
	{"@id":"gpc:20001935","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Athletic Footwear","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of athletic footwear."},
	{"@id":"gpc:20002194","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Beverage Served","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of beverage for which the glass is designed."},
	{"@id":"gpc:20002491","type":["gpc:Attribute","rdf:Property"],"label_en":"Gender of Species","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the gender of the animal species."},
	{"@id":"gpc:20001686","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Non Disposable Bakeware/Ovenware/Grillware","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of non-disposable bakeware, ovenware or grillware."},
	{"@id":"gpc:20003084","type":["gpc:Attribute","rdf:Property"],"label_en":"Support Style","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the support necessary to keep the structure upright."},
	{"@id":"gpc:20002064","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Metronome/Tuner (Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of powered metronome and/or tuner."},
	{"@id":"gpc:20002157","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Dolls Furniture","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of doll&apos;s furniture."},
	{"@id":"gpc:20001098","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Caller ID Displays","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the Caller ID has a visual display or audio announcement of the incoming call or both."},
	{"@id":"gpc:20002313","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Fire Retardant/Suppressant","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of fire retardant or fire suppressant."},
	{"@id":"gpc:20002677","type":["gpc:Attribute","rdf:Property"],"label_en":"Non-Thermal Preservation","comment_en":"Treatments other than those involving heat or refrigeration to preserve product quality and maintain wholesomeness."},
	{"@id":"gpc:20001536","type":["gpc:Attribute","rdf:Property"],"label_en":"Oven Type","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the type of product."},
	{"@id":"gpc:20002418","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Deck Drainage System","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the design of the deck drainage system in relation to the water flow rates."},
	{"@id":"gpc:20000727","type":["gpc:Attribute","rdf:Property"],"label_en":"If Air-permeable","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is air-permeable."},
	{"@id":"gpc:20003112","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Production","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of production used."},
