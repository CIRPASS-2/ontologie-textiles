	{"@id":"gpc:20002548","type":["gpc:Attribute","rdf:Property"],"label_en":"If Non Shrink","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product possesses characteristics which prevent it from shrinking when set."},
	{"@id":"gpc:20002044","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Alarm","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has an alarm function."},
	{"@id":"gpc:20001591","type":["gpc:Attribute","rdf:Property"],"label_en":"Concealed Heating Element","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify whether the product has a concealed heating element."},
	{"@id":"gpc:20002855","type":["gpc:Attribute","rdf:Property"],"label_en":"First Mixed Meat Kind","comment_en":"Indicates for mixed species meat products which kind of meat is the first largest component of the product by percentage of composition, or in products where different kinds of meat are used in equal proportions, which kind of meat is present in a percentage at least not lower than any other kinds of meat ."},
	{"@id":"gpc:20001355","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Needlework Fabric/Textile","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of needlework fabric or textile."},
	{"@id":"gpc:20002361","type":["gpc:Attribute","rdf:Property"],"label_en":"Composition of Stair Part/Fitting","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the composition of the stair part or stair fitting."},
	{"@id":"gpc:20002989","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Textile","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the textile product."},
