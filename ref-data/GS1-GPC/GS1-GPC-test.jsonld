	{"@id":"gpc:30014590","type":"gpc:AttributeValue","label_en":"BLIND FLANGE"},
	{"@id":"gpc:30017239","type":"gpc:AttributeValue","label_en":"SWEEP SHAVINGS/SWEEPING COMPOUND","comment_en":"This term is used to describe small pieces of wood or cellulose pieces, used to clean floors, either non-soaked, or oil, wax or emulsion soaked for different floorings and types of cleaning."},
