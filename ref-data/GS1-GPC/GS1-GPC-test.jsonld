	{"@id":"gpc:20000381","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Oral Care - Aids (Non Powered)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify different types of oral care aid products."},
	{"@id":"gpc:20001423","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Curling Stones","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of curling stone."},
	{"@id":"gpc:20000736","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Stock Liquid/Bones","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the name of the principal food product from which the stock is based on."},
	{"@id":"gpc:20000215","type":["gpc:Attribute","rdf:Property"],"label_en":"Flavour of Tobacco Products/Smoking Accessories","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to indicate the flavouring of the tobacco product."},
	{"@id":"gpc:20000229","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Fruit","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains fruit."},
	{"@id":"gpc:20002954","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Non-Netted Cantaloupe Melons"},
	{"@id":"gpc:20001234","type":["gpc:Attribute","rdf:Property"],"label_en":"Magnifying Factor","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the magnifying factor."},
	{"@id":"gpc:20003119","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Buffet Products","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of products designed for buffets."},
	{"@id":"gpc:20002866","type":["gpc:Attribute","rdf:Property"],"label_en":"Is Washed and Ready to Eat","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify that the product as washed and ready to eat."},
	{"@id":"gpc:20000647","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Concentrated Claim","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product comes with a claim of being concentrated."},
	{"@id":"gpc:20000193","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Chocolate","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of chocolate."},
	{"@id":"gpc:20000645","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Insect Repellent","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains insect repellent."},
	{"@id":"gpc:20002215","type":["gpc:Attribute","rdf:Property"],"label_en":"If Non-Stick Coating","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product has a non-stick coating."},
	{"@id":"gpc:20000113","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Added Milk","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not any form of milk has been added to the product contents."},
	{"@id":"gpc:20002385","type":["gpc:Attribute","rdf:Property"],"label_en":"If Bird of Prey/Raptor","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the bird is a member of the raptor family of birds."},
	{"@id":"gpc:20002263","type":["gpc:Attribute","rdf:Property"],"label_en":"Venting Type","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is venting or non-venting."},
	{"@id":"gpc:20002047","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Clock Replacement Part","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of clock replacement part."},
	{"@id":"gpc:20001679","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Food Thermometer","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of food thermometer."},
	{"@id":"gpc:20002212","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Household Water Testing Kit","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of household water testing kit."},
	{"@id":"gpc:20002746","type":["gpc:Attribute","rdf:Property"],"label_en":"Time of Harvest of Lemons","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the when the lemon is harvested."},
	{"@id":"gpc:20000117","type":["gpc:Attribute","rdf:Property"],"label_en":"If With Raising Agent","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the flour or starch product contains raising agents."},
