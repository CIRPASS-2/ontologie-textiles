	{"@id":"gpc:20002523","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of House/Wall Paint","comment_en":"Indicate, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the layer of coating being referred to."},
	{"@id":"gpc:20001527","type":["gpc:Attribute","rdf:Property"],"label_en":"Includes Built-in Ice Maker","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify whether the appliance has a built in ice-maker."},
