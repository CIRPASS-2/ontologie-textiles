	{"@id":"gpc:72020000","type":"gpc:Family","label_en":"Small Domestic Appliances","subClassOf":"gpc:72000000"},
	{"@id":"gpc:93100000","type":"gpc:Family","label_en":"Bouquets","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as Bouquet or mixture of cut flowers and greens sold as an arrangement."},
	{"@id":"gpc:93050000","type":"gpc:Family","label_en":"Bulbs/Corms/Rhizomes/Tubers","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as Bulbs/Corms/Rhizomes/Tubers."},
	{"@id":"gpc:93010000","type":"gpc:Family","label_en":"Cut Flowers","subClassOf":"gpc:93000000","comment_en":"Includes products that may be described/observed as flowers cut from growing plants that are used as fresh or dried flowers. These flowers may include some foliage from the same plant such as a stem and/or leaves. Excludes Cut Greens and combinations from more than one GPC family."},
	{"@id":"gpc:93020000","type":"gpc:Family","label_en":"Cut Greens","subClassOf":"gpc:93000000","comment_en":"Includes all cultivated or noncultivated decorative foliage products that may be described/observed as Cut Greens. These are used as fresh or dried decorative foliage. This would include berries, stems, leaves and vines. Often these products are used in bouquets. Excludes cut flowers and combinations from more than one GPC family."},
	{"@id":"gpc:93030000","type":"gpc:Family","label_en":"Live Plants (Genus A thru G)","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as a living plant, with roots typically in a container or pot used as decorative ornaments or landscaping for inside and/or outside and having a genus name starting with A through G. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."},
	{"@id":"gpc:93040000","type":"gpc:Family","label_en":"Live Plants (Genus H thru Z)","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as a living plant, with roots typically in a container or pot used as decorative ornaments or landscaping for inside and/or outside and having a genus name starting with H through Z. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."},
	{"@id":"gpc:93060000","type":"gpc:Family","label_en":"Plants Variety Packs","subClassOf":"gpc:93000000","comment_en":"A variety of Plants, including bouquets, from more than one GPC Family within the Horticulture Plants Segment."},
	{"@id":"gpc:93110000","type":"gpc:Family","label_en":"Seedlings - Ready to Grow","subClassOf":"gpc:93000000"},
	{"@id":"gpc:93070000","type":"gpc:Family","label_en":"Seeds/Spores","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as the fertilized ovule of a plant that contains an embryo and food products for germination. These products are smaller than bulbs, ranging from microscopic to over an inch long. Includes products such as pre-treated seeds."},
	{"@id":"gpc:93080000","type":"gpc:Family","label_en":"Shrubs/Trees","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as woody, bushy plants that can either have a single main stem or branch into several stems at the base. These plants can be either evergreen or deciduous and are able to produce cones, flowers and fruit. Trees are mostly distinguished from shrubs through the appearance of a single stem and the fact that they branch a greater distance from the ground than shrubs. Includes products such as evergreen trees and deciduous shrubs as well as any fruit bearing tree or shrub."},
	{"@id":"gpc:93090000","type":"gpc:Family","label_en":"Vegetables/Fungi Plants","subClassOf":"gpc:93000000","comment_en":"Includes any products that may be described/observed as food plants, most of them annual, which are planted for their edible parts. Includes products such as mushrooms and potatoes that are growing plants and are bought ready to be planted."},
