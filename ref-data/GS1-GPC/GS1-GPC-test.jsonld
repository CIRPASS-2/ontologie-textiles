	{"@id":"gpc:20001896","type":["gpc:Attribute","rdf:Property"],"label_en":"If Adjustable Cutting Height","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used to identify whether the product can alter its cutting height"},
	{"@id":"gpc:20003042","type":["gpc:Attribute","rdf:Property"],"label_en":"Requires Additional Ingredients","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product requires additional ingredients."},
	{"@id":"gpc:20003159","type":["gpc:Attribute","rdf:Property"],"label_en":"Dresscode Type","comment_en":"Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the dresscode."},
	{"@id":"gpc:20000021","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Dried Bread","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of dried bread."},
