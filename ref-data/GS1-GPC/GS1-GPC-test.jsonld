	{"@id":"gpc:20001737","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Household/Office Table","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of table to be used in the home or office."},
	{"@id":"gpc:20003111","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Food Preparation Equipment","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of additional food preparation product."},
	{"@id":"gpc:20002737","type":["gpc:Attribute","rdf:Property"],"label_en":"Quality (UNECE Standard)","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the quality classification or category according to Codex Alimentarius or UNECE standards. UNCLASSIFIED applies to fruits that are not yet packed (e.g. delivery of a grower to a pack house) or not qualified to be sold as fresh fruits in the target market since they do not meet the specifications required by legislation."},
	{"@id":"gpc:20002130","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Hard Hat/Cap","comment_en":"Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product is a hard hat or a hard cap."},
	{"@id":"gpc:20000205","type":["gpc:Attribute","rdf:Property"],"label_en":"Type of Tea","comment_en":"Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type of tea."},
