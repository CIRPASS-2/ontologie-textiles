gpc:30017809  rdf:type  gpc:AttributeValue;
        rdfs:comment  "A projection screen (front and rear) is an installation consisting of a surface and a support structure used for displaying a projected image either from the front or rear of the screen for the view of an audience. Projection screens may be permanently installed, as in a movie theater."@en;
        rdfs:label    "PROJECTION SCREEN (FRONT AND REAR PROJECTION)"@en .

gpc:30017810  rdf:type  gpc:AttributeValue;
        rdfs:comment  "A front projection screen is an installation consisting of a surface and a support structure used for displaying a projected image from in front of the screen for the view of an audience. Projection screens may be permanently installed, as in a movie theater."@en;
        rdfs:label    "FRONT PROJECTION SCREEN"@en .

gpc:30017811  rdf:type  gpc:AttributeValue;
        rdfs:comment  "A rear projection screen is an installation consisting of a surface and a support structure used for displaying a projected image from behind the screen for the view of an audience. Projection screens may be permanently installed, as in a movie theater."@en;
        rdfs:label    "REAR PROJECTION SCREEN"@en .

