        rdfs:comment  "A trade item is referred to as &quot;crumbled&quot; when it has been broken up into medium or smaller sized pieces of irregular shape."@en;
        rdfs:label    "CRUMBLES"@en .

gpc:30015668  rdf:type  gpc:AttributeValue;
        rdfs:comment  "A trade item is referred to as &quot;individually formed slices&quot; when it has been formed as slices."@en;
