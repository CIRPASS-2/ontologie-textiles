gpc:30015378  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Liquid egg product is passed over a heated surface to evaporate water."@en;
        rdfs:label    "DRIED - PAN (EGG)"@en .

gpc:30015379  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Water is removed using membrane technology."@en;
        rdfs:label    "CONCENTRATED (EGG)"@en .

gpc:30015380  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Liquid egg product is converted to a dry form using an unknown process."@en;
        rdfs:label    "DRIED - PROCESS UNIDENTIFIED (EGG)"@en .

gpc:30015381  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Atomized egg product is heated in a chamber to create a powder."@en;
        rdfs:label    "DRIED - SPRAY (EGG)"@en .

gpc:30015382  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Glucose removed through the fermentation of natural sugars."@en;
