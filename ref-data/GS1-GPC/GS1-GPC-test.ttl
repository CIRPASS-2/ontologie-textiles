        rdfs:label    "PRESERVATIVES"@en .

gpc:30015411  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Food-grade foaming additives such as sodium laury sulfate added to the product."@en;
        rdfs:label    "WHIPPING AIDS"@en .

gpc:30015412  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product is maintained at not less than 4&#176;C (40&#176;F) or more than 7&#176;C (45&#176;F) at all times after packaging."@en;
        rdfs:label    "CHILLED (EGGS)"@en .

gpc:30015413  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product is maintained at room temperature after packaging."@en;
        rdfs:label    "UNCHILLED"@en .

gpc:30015414  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Shell has no pigmentation."@en;
        rdfs:label    "WHITE (SHELL)"@en .

gpc:30015415  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Shell has a light-brown to dark-brown pigmentation."@en;
        rdfs:label    "BROWN (SHELL)"@en .

gpc:30015416  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Shell has a light-brown to dark-brown base pigmentation with noticeably darker circular or randomly shaped markings."@en;
        rdfs:label    "SPECKLED (SHELL)"@en .

gpc:30015417  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product is maintained at or below 7 &#176;C (45&#176;F) at all times after packaging."@en;
        rdfs:label    "CHILLED (EGG IN SHELL)"@en .

gpc:30015418  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the largest egg weight category as defined by a standard known to buyer and seller such as Jumbo in the US and Canada and Very Large in Eurpoe."@en;
        rdfs:label    "SIZE 1"@en .

gpc:30015419  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the second next to largest egg weight category as defined by a standard known to buyer and seller such as Extra Large in the US and Large in Europe."@en;
        rdfs:label    "SIZE 2"@en .

gpc:30015420  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the third next to largest egg weight category as defined by a standard known to buyer and seller such as Large in the US and Canada or Medium in Europe."@en;
        rdfs:label    "SIZE 3"@en .

gpc:30015421  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the fourth next to largest egg weight category as defined by a standard known to buyer and seller such as Medium in the US and Canada or Small in Europe."@en;
        rdfs:label    "SIZE 4"@en .

gpc:30015422  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the fifth next to largest egg weight category as defined by a standard known to buyer and seller such as Small in the US and Canada."@en;
        rdfs:label    "SIZE 5"@en .

gpc:30015423  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the sixth next to largest egg weight category as defined by a standard known to buyer and seller such as Size 6 in the UNECE standards."@en;
        rdfs:label    "SIZE 6"@en .

gpc:30015424  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product meets or exceeds the requirements of the seventh next to largest egg weight category as defined by a standard known to buyer and seller such as Size 7 in the UNECE standards."@en;
        rdfs:label    "SIZE 7"@en .

gpc:30015425  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product has not been segregated as to egg size or weight."@en;
        rdfs:label    "UNSIZED"@en .

gpc:30015426  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Shell eggs that have not been subjected to a water-based cleaning process."@en;
        rdfs:label    "UNWASHED"@en .

gpc:30015427  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Shell eggs that have been subjected to a water-based cleaning process."@en;
        rdfs:label    "WASHED"@en .

gpc:30015428  rdf:type  gpc:AttributeValue;
