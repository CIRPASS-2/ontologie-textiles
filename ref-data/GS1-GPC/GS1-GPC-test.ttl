gpc:30015645  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Medium Coarse Coffee is most commonly used for Solo Brewers and Chemex&#174; Brewers."@en;
        rdfs:label    "MEDIUM COURSE GROUND"@en .

gpc:30015646  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Medium Fine Ground Coffee commonly used for Pourover Cones, Siphon Brewers and Vacuum Pots."@en;
