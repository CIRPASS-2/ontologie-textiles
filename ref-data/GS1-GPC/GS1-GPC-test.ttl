        rdfs:comment  "Egg is stored for an extended period of time without refrigeration or chemically treated to radically change the internal characteristics of the egg."@en;
        rdfs:label    "AGED (EGG)"@en .

gpc:30015377  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product such as a protein or vitamin is isolated from a liquid egg product using acceptable food-grade processing aides."@en;
