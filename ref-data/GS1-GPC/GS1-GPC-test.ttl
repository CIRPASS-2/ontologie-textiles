gpc:30015395  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Production method uses standard-sized battery cages for producing hens."@en;
        rdfs:label    "CONVENTIONAL (CAGED)"@en .

gpc:30015396  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Production method allows cage-free movement to produce hens."@en;
        rdfs:label    "CAGE-FREE"@en .

gpc:30015397  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Production method uses cages larger than the standard-sized battery cages for producing hens but without outdoor access."@en;
        rdfs:label    "NON CONVENTIONAL CAGED"@en .

gpc:30015398  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Enzymes are not modified prior to product pasteurisation."@en;
        rdfs:label    "PASTEURISED (WITHOUT ENZYME MODIFICATION)"@en .

gpc:30015399  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Enzymes are modified prior to product pasteurisation."@en;
        rdfs:label    "PASTEURISED (WITH ENZYME MODIFICATION)"@en .

gpc:30015400  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Enzymes may or may not have been modified prior to product pasteurisation."@en;
        rdfs:label    "PASTEURISED (USE OF ENZYME MODIFICATION UNKNOWN)"@en .

gpc:30015401  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product is pasteurised using non-thermal treatments such as high frequency radio waves or hyperbaric pressure."@en;
        rdfs:label    "PASTEURISED (ALTERNATE TREATMENTS)"@en .

gpc:30015402  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product has not been subjected to any treatment to reduce viable microorganisms."@en;
        rdfs:label    "UNPASTEURISED"@en .

gpc:30015403  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product obtained from bird eggs broken from the shell and separated from the yolks."@en;
        rdfs:label    "WHITE (EGG PART)"@en .

gpc:30015404  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product obtained from bird eggs broken from the shell with yolks and whites mixed as broken."@en;
        rdfs:label    "WHOLE (NATURAL PROPORTIONS)"@en .

gpc:30015405  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product is yolks and whites obtained from bird eggs combined to meet product specifications."@en;
        rdfs:label    "WHOLE (NOT NATURAL PROPORTIONS)"@en .

gpc:30015406  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Product obtained from bird eggs broken from the shell and separated from the whites."@en;
        rdfs:label    "YOLK (EGG)"@en .

gpc:30015407  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Food-grade additives used to preserve color of product."@en;
        rdfs:label    "COLOR STABILIZERS"@en .

gpc:30015408  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Food-grade additives used to alter the color of product."@en;
        rdfs:label    "COLORING AGENTS"@en .

gpc:30015409  rdf:type  gpc:AttributeValue;
