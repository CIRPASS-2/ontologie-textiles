gpc:30015383  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Water removed under a partial vacuum."@en;
        rdfs:label    "FREEZE - DRIED (EGG)"@en .

gpc:30015384  rdf:type  gpc:AttributeValue;
        rdfs:comment  "Lysozyme removed through physical or ion exchange process using acceptable processing aides."@en;
        rdfs:label    "LYSOZYME REMOVED (EGG)"@en .

gpc:30015385  rdf:type  gpc:AttributeValue;
        rdfs:comment  "No treatment process is applied by the processor during product production."@en;
