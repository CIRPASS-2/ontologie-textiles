        rdfs:label       "Orangelos"@en;
        rdfs:subClassOf  gpc:50250600 .

gpc:10006344  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any product that can be described/observed as a fresh commercial variety of Jicama Bean, grown from Pachyrhizus erosus, to be supplied fresh. Excludes Prepared/Processed or Unprepared/Unprocessed and Shelf Stable or Frozen Jicama Bean and Variety Packs of Jicama Bean mixed with other items."@en;
        rdfs:label       "Jicama Bean"@en;
