        rdfs:label       "Water Spinach /Ong Choy"@en;
        rdfs:subClassOf  gpc:50350500 .

gpc:10006353  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any product that can be described/observed as a fresh commercial variety of Sage, grown from Salvia officinalis, to be supplied fresh. Specifically excludes: Prepared/Processed or Unprepared/Unprocessed and Shelf Stable or Frozen Sage and Variety Packs of Sage mixed with other items."@en;
        rdfs:label       "Sage"@en;
