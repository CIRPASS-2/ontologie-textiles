gpc:10007921  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Ludwigia not defined as any specific species. This genus contains about 82 species of aquatic plants. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Ludwigia - Live Plants"@en;
        rdfs:subClassOf  gpc:93048700 .

gpc:10007922  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Musa not defined as any specific species. This genus contains about 70 species and includes bananas and plantains. Excludes crops for Production of Banana Fruit.Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Musa - Live Plants"@en;
        rdfs:subClassOf  gpc:93048800 .

gpc:10007923  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Peperomia not defined as any specific species. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Peperomia - Live Plants"@en;
        rdfs:subClassOf  gpc:93048900 .

gpc:10007924  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Pilea specifically of the species peperomioides: also known as Chinese money plant, pancake plant, UFO plant, lefse plant or missionary plant.&#160; Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Pilea - Live Plants"@en;
        rdfs:subClassOf  gpc:93049000 .

gpc:10007925  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Philodendron not defined as any specific species. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Philodendron - Live Plants"@en;
        rdfs:subClassOf  gpc:93049100 .

gpc:10007926  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Polyscias not defined as any specific species: also known as Aralia Polyscias Fabian. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Polyscias - Live Plants"@en;
        rdfs:subClassOf  gpc:93049200 .

gpc:10007927  rdf:type   gpc:Brick;
        rdfs:comment     "Includes any products that may be described/observed as a living plant(s) within the genus Rhapis specifically of the species excelsa: also known as broadleaf lady palm or bamboo palm. Specifically excludes Shrubs/Trees, Seeds/Spores, Bulbs, Vegetables and Fungi and cut Flowers and Greens."@en;
        rdfs:label       "Rhapis - Live Plants"@en;
        rdfs:subClassOf  gpc:93049300 .

