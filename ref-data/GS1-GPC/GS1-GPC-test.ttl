gpc:93000000  rdf:type  gpc:Segment;
        rdfs:comment  "Horticulture plants are used in plant cultivation for human use. This segment includes non-food crops, such as flowers, trees and shrubs, and grasses used in the floral industry, landscaping, and ornamental decoration. It also includes growing plants used to produce food, such as, fruits, vegetables, and mushrooms."@en;
        rdfs:label    "Horticulture Plants"@en .

gpc:93010000  rdf:type   gpc:Family;
        rdfs:comment     "Includes products that may be described/observed as flowers cut from growing plants that are used as fresh or dried flowers. These flowers may include some foliage from the same plant such as a stem and/or leaves. Excludes Cut Greens and combinations from more than one GPC family."@en;
        rdfs:label       "Cut Flowers"@en;
        rdfs:subClassOf  gpc:93000000 .

