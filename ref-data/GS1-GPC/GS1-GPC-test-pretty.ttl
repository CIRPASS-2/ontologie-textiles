  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to indicate the flavouring of the herbal chewing/ Snuff product."@en .

gpc:20002863 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Soup Additions"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of Soup Additive."@en .

gpc:20002864 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Odour Eliminator"@en .

gpc:20002865 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Disinfectant/Sanitizer"@en .

gpc:20002866 a rdf:Property, gpc:Attribute ;
  rdfs:label "Is Washed and Ready to Eat"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify that the product as washed and ready to eat."@en .

gpc:20002867 a rdf:Property, gpc:Attribute ;
  rdfs:label "Sharpness of Cheese"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the sharpness of the taste of the product. Usually the longer the aging of the product, the sharper the taste."@en .

gpc:20002868 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Flavoured or Mixed with Juices, Soft Drinks or Other Ingredients"@en .

gpc:20002869 a rdf:Property, gpc:Attribute ;
  rdfs:label "Viscosity Rating Indication or Related Standard"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the viscosity rating or related standard of the lubricate product."@en .

gpc:20002870 a rdf:Property, gpc:Attribute ;
  rdfs:label "Oil Type"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of oil or lubricate."@en .

gpc:20002871 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Engine Oil Target"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of engine oil target for the lubricate."@en .

gpc:20002872 a rdf:Property, gpc:Attribute ;
  rdfs:label "Number of Strokes"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the internal combustion engine design by the number of piston strokes used that this oil/lubricate is for."@en .

gpc:20002873 a rdf:Property, gpc:Attribute ;
  rdfs:label "Can be Used in Sub-Freezing Temperatures"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product can be used in freezing weather conditions."@en .

gpc:20002874 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Disposable Food Containers"@en .

gpc:20002875 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Pre-Printed"@en .

gpc:20002876 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Motorcycle"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of motorcycle."@en .

gpc:20002877 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Energy"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of energy used to move the transportation product."@en .

gpc:20002878 a rdf:Property, gpc:Attribute ;
  rdfs:label "Drive Type"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the drive type of the car, bus or truck."@en .

gpc:20002879 a rdf:Property, gpc:Attribute ;
  rdfs:label "Maximum Number of Passengers"@en ;
