  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the specific area in which the air filter is designed to operate."@en .

gpc:20002888 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Fluid Filter"@en ;
