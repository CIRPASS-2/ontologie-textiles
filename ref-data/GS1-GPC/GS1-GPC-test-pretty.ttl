gpc:30016369 a gpc:AttributeValue ;
  rdfs:label "TRAVEL DOCUMENT PROTECTOR"@en ;
  rdfs:comment "This term is used for products that are usually made of plastic to cover travel documents (passports, etc.) to protect them from damage."@en .

gpc:30016370 a gpc:AttributeValue ;
  rdfs:label "CLEAR PLASTIC FILE FOLDER"@en ;
