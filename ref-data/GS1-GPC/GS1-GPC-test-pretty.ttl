gpc:20002852 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Built In Camera"@en .

gpc:20002853 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Tablet/E-Book Reader Computer"@en .

gpc:20002854 a rdf:Property, gpc:Attribute ;
  rdfs:label "Animal Alternative Type"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the species of the product."@en .

gpc:20002855 a rdf:Property, gpc:Attribute ;
  rdfs:label "First Mixed Meat Kind"@en ;
  rdfs:comment "Indicates for mixed species meat products which kind of meat is the first largest component of the product by percentage of composition, or in products where different kinds of meat are used in equal proportions, which kind of meat is present in a percentage at least not lower than any other kinds of meat ."@en .

gpc:20002856 a rdf:Property, gpc:Attribute ;
  rdfs:label "Second Mixed Meat Kind"@en ;
  rdfs:comment "Indicates for mixed species meat products which kind of meat is the second largest component of the product by percentage of composition, or in products where different kinds of meat are used in equal proportions, which kind of meat is present in a percentage at least not lower than any other kind of meat ."@en .

gpc:20002857 a rdf:Property, gpc:Attribute ;
  rdfs:label "Third Mixed Meat Kind"@en ;
  rdfs:comment "Indicates for mixed species meat products which kind of meat is the third largest component of the product by percentage of composition, or in products where different kinds of meat are used in equal proportions, which kind of meat is present in a percentage at least not lower than any other kind of meat ."@en .

gpc:20002858 a rdf:Property, gpc:Attribute ;
  rdfs:label "Level of Carbonation"@en .

gpc:20002859 a rdf:Property, gpc:Attribute ;
  rdfs:label "Preparation Format"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains pre-measured packets, is loose or bagged, etc.."@en .

gpc:20002860 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Insulated Box/Bag"@en ;
  rdfs:comment "Indicates with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of Insulated Box/Bag."@en .

gpc:20002862 a rdf:Property, gpc:Attribute ;
