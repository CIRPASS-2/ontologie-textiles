gpc:20002880 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Automotive Transmission"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of automotive transmission."@en .

gpc:20002881 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Carburettor/Choke"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of carburettor or choke."@en .

gpc:20002882 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Engine Degreaser/Pollution Control"@en ;
