  rdfs:label "Size of Romaine"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer fruits/vegetables to identify the size of the Romaine product."@en .

gpc:20002842 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Multileaf Lettuce"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer fruits/vegetables to identify the commercial type of multileaf Lettuce."@en .

gpc:20002843 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Spinach"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the type of Spinach."@en .

gpc:20002844 a rdf:Property, gpc:Attribute ;
  rdfs:label "Colour of Asparagus"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to differentiate the colour of Asparagus."@en .

gpc:20002845 a rdf:Property, gpc:Attribute ;
  rdfs:label "Chemical Post-Harvest-Treatment of Citrus Fruits"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging whether or not the product has had a chemical post-harvest treatment applied."@en .

gpc:20002846 a rdf:Property, gpc:Attribute ;
  rdfs:label "Variety of Oranges"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the commercial variety group of oranges."@en .

gpc:20002847 a rdf:Property, gpc:Attribute ;
  rdfs:label "Commercial Type of Oranges"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the commercial category of oranges."@en .

gpc:20002848 a rdf:Property, gpc:Attribute ;
  rdfs:label "Rim Diameter Inches"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the rim diameter"@en .

gpc:20002849 a rdf:Property, gpc:Attribute ;
  rdfs:label "Cooking Type Of Potatoes"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer that specifies the cooking characteristics of potatoes . For culinary purposes, varieties are often described in terms of their waxiness."@en .

gpc:20002850 a rdf:Property, gpc:Attribute ;
  rdfs:label "Preparation State"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the preparation state of the product."@en .

gpc:20002851 a rdf:Property, gpc:Attribute ;
