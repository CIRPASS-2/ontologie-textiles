  rdfs:comment "Indicates, with reference to the product branding, labeling or packaging the descriptive term that is used by the product manufacturer to identify a the size of the in-shell eggs."@en .

gpc:20002815 a rdf:Property, gpc:Attribute ;
  rdfs:label "In Shell Egg Refrigeration State"@en ;
  rdfs:comment "The extent to which heat is removed to preserve the product quality of shell eggs."@en .

gpc:20002816 a rdf:Property, gpc:Attribute ;
  rdfs:label "In Shell Pasteurisation"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labeling or packaging, the descriptive term that is used by the product manufacturer to describe the type of manufacturers treatment/cooking process the product has undergone."@en .

gpc:20002817 a rdf:Property, gpc:Attribute ;
  rdfs:label "Egg Quality Standard"@en .

gpc:20002818 a rdf:Property, gpc:Attribute ;
