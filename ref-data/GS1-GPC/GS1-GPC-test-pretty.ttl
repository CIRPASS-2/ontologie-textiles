@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gpc: <https://gs1.org/gpc/> .

gpc:20000001 a rdf:Property, gpc:Attribute ;
  rdfs:label "Juice Content Percentage"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the proportion of pure fruit or vegetable juice contained within the product, measured in a range as a percentage of the product&apos;s total volume."@en .

gpc:20000002 a rdf:Property, gpc:Attribute ;
  rdfs:label "Added Ingredient"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify one or more specific added ingredients."@en .

gpc:20000003 a rdf:Property, gpc:Attribute ;
  rdfs:label "Age of Product"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the quantitative term that is used by the product manufacturer to identify the precise number of years that the product has been aged prior to being offered for sale."@en .

gpc:20000004 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Alcohol Making Kit"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of alcohol making kit."@en .

gpc:20000005 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Alcohol Making Supply"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular ingredient or piece of equipment used in the production of alcohol at home."@en .

gpc:20000006 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Alcoholic Pre-mixed Drink"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type of alcoholic pre-mixed drink."@en .

gpc:20000007 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Aquatic Invertebrate"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of edible aquatic invertebrate."@en .

gpc:20000009 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Aquatic Plant"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of edible aquatic plant."@en .

gpc:20000011 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Baby/Infant Specialised Beverage"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of specialised baby or infant beverage product."@en .

gpc:20000012 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Baby/Infant Specialised Food"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of specialised baby or infant food product."@en .

gpc:20000013 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Baking/Cooking Mix"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of baking/cooking mix."@en .

gpc:20000014 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Baking/Cooking Supply"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of a baking supply product."@en .

gpc:20000015 a rdf:Property, gpc:Attribute ;
  rdfs:label "Base Ingredient"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the fundamental ingredient or a chief constituent of a product."@en .

gpc:20000017 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Beer"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of beer."@en .

gpc:20000018 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Biscuit/Cookie"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of biscuit or cookie."@en .

gpc:20000020 a rdf:Property, gpc:Attribute ;
  rdfs:label "Boneless Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product makes a specific claim to contain no bones."@en .

gpc:20000021 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Dried Bread"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of dried bread."@en .

gpc:20000024 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Cake"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of cake."@en .

gpc:20000026 a rdf:Property, gpc:Attribute ;
  rdfs:label "Surface Coating/Filling"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the outer surface of the product has been coated or filled with a separate ingredient or substance."@en .

gpc:20000027 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Processed Cereal"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the particular type or variety of processed cereal."@en .

gpc:20000028 a rdf:Property, gpc:Attribute ;
  rdfs:label "Cereal/Grain Size/Length"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the size of the cereal/grain."@en .

gpc:20000031 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Cheese"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the particular type of cheese."@en .

gpc:20000032 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Chips/Crisps or Snack"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify particular types of chips, crisps or snacks."@en .

gpc:20000034 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Chocolate or Chocolate/Sugar Candy Combination Confectionery"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer in order to identify the main combined ingredients within the chocolate and/or sugar candy product."@en .

gpc:20000035 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Chutney or Relish"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the particular type of chutney or relish."@en .

gpc:20000036 a rdf:Property, gpc:Attribute ;
  rdfs:label "Cider/Perry"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify whether the product is a cider or a Perry."@en .

gpc:20000037 a rdf:Property, gpc:Attribute ;
  rdfs:label "Cigar Style"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the style of the cigar."@en .

gpc:20000038 a rdf:Property, gpc:Attribute ;
  rdfs:label "Format of Cigar"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular format or variety of cigar."@en .

gpc:20000043 a rdf:Property, gpc:Attribute ;
  rdfs:label "Variety of Ready to Drink Coffee or Coffee Substitute"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the particular variety of ready to drink coffee and coffee substitutes."@en .

gpc:20000044 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Confectionery Based Spread"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the type of a confectionery based spread."@en .

gpc:20000045 a rdf:Property, gpc:Attribute ;
  rdfs:label "Consumer Lifestage"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the period or stage in the consumer&apos;s life during which the product is considered to be suitable."@en .

gpc:20000046 a rdf:Property, gpc:Attribute ;
  rdfs:label "Variety of Sauces - Cooking"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular variety of cooking sauce."@en .

gpc:20000047 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Cooking Wine"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of cooking wine."@en .

gpc:20000049 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Cream"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify a particular type of cream."@en .

gpc:20000050 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Dessert Sauce/Topping/Filling"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify a particular type of dessert topping/filling or sauce."@en .

gpc:20000053 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Dessert"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify a particular type of dessert."@en .

gpc:20000056 a rdf:Property, gpc:Attribute ;
  rdfs:label "Diabetic Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, whether the product makes a claim to be suitable for consumption by consumers who have diabetes."@en .

gpc:20000057 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With Diet/Light Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, whether the product, makes claim to a diet/light preparation, typified by a reduced level of fat or sugar."@en .

gpc:20000060 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Dressing or Dip"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of dressing or dip."@en .

gpc:20000061 a rdf:Property, gpc:Attribute ;
  rdfs:label "Edible State"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the state in which the product is purchased in relation to its required treatment in order to be made edible."@en .

gpc:20000064 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Extract/Salt or Meat Tenderiser"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the name of the principal food product from which the extract has been taken."@en .

gpc:20000065 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Edible Animal Fat"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of edible animal fat."@en .

gpc:20000066 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Edible Vegetable/Plant Fat"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of edible vegetable or plant fat."@en .

gpc:20000067 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Fish"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of fish."@en .

gpc:20000069 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Flour"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the particular type or variety of flour."@en .

gpc:20000072 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Fortified Wine"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify the type of fortified wine."@en .

gpc:20000073 a rdf:Property, gpc:Attribute ;
  rdfs:label "Fresh or Seawater Farmed"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the whether the product has been fresh or sea water farmed."@en .

gpc:20000075 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Fruit/Nut/Seed Mix"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of fruit/nut and/or seed mix."@en .

gpc:20000076 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Fruit"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of fruit."@en .

gpc:20000079 a rdf:Property, gpc:Attribute ;
  rdfs:label "Gluten Free Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether the product does or does not contain gluten."@en .

gpc:20000081 a rdf:Property, gpc:Attribute ;
  rdfs:label "Grape Variety"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular variety of grape, which is used in winemaking."@en .

gpc:20000084 a rdf:Property, gpc:Attribute ;
  rdfs:label "Herb/Spice"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a whether the product is a herb, spice or combination."@en .

gpc:20000086 a rdf:Property, gpc:Attribute ;
  rdfs:label "Physical Form or Consistency of Honey"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the distinctive physical form or consistency in which honey products are produced ready for consumption."@en .

gpc:20000087 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Ice Cream or Ice Novelty"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of ice-cream or ice novelty."@en .

gpc:20000090 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Aromatic"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify whether or not the product formulation includes additional natural or artificial aroma."@en .

gpc:20000092 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With Caffeine"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains caffeine."@en .

gpc:20000093 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Carbonated"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not a beverage product is naturally effervescent or has been made effervescent by the addition of carbon dioxide gas."@en .

gpc:20000094 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Coated"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is coated."@en .

gpc:20000095 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Condensed"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is condensed"@en .

gpc:20000097 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Disposable"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is intended to be disposed of after single use or a limited period of use."@en .

gpc:20000098 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Flavoured or Added Ingredient"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contents include flavouring or added ingredients."@en .

gpc:20000099 a rdf:Property, gpc:Attribute ;
  rdfs:label "If From Concentrate"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product claims to be made from a concentrated formulation."@en .

gpc:20000101 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Herbal"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contents are herbal."@en .

gpc:20000102 a rdf:Property, gpc:Attribute ;
  rdfs:label "If in Sauce"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains any sauce."@en .

gpc:20000103 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Individually Wrapped"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is individually wrapped."@en .

gpc:20000104 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Instant"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is instant."@en .

gpc:20000106 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Low Calorie"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product has been produced or treated in such a way as to reduce its calorie content below that which is expected of conventional products."@en .

gpc:20000108 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Part Baked"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is part baked and needs further cooking or baking."@en .

gpc:20000109 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Pitted/Stoned"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not a fruit or vegetable product has been de-stoned or pitted prior to being offered for sale."@en .

gpc:20000110 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Salted"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not a product has been salted prior to being offered for sale."@en .

gpc:20000111 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Shelled/Peeled"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product or its contents have been shelled/peeled prior to being offered for sale."@en .

gpc:20000113 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With Added Milk"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not any form of milk has been added to the product contents."@en .

gpc:20000116 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With Pulp"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product contains fruit or vegetable pulp."@en .

gpc:20000117 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With Raising Agent"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the flour or starch product contains raising agents."@en .

gpc:20000118 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Jam/Marmalade"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify a particular type of jam, and marmalade product."@en .

gpc:20000120 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Juice"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of juice."@en .

gpc:20000121 a rdf:Property, gpc:Attribute ;
  rdfs:label "Length of Cigarette"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to indicate the whole length of the product, which may or may not include a filter dependent on the type of cigarette."@en .

gpc:20000122 a rdf:Property, gpc:Attribute ;
  rdfs:label "Level of Alcohol Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the level of alcohol that is contained within the product."@en .

gpc:20000123 a rdf:Property, gpc:Attribute ;
  rdfs:label "Level of Fat Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the level of fat contained within the product."@en .

gpc:20000124 a rdf:Property, gpc:Attribute ;
  rdfs:label "Level of Salt/Sodium Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to describe the level of salt/sodium that is contained within the product."@en .

gpc:20000125 a rdf:Property, gpc:Attribute ;
  rdfs:label "Level of Sugar/Sweetener Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to describe the level of sugar/sweetener that is contained within the product."@en .

gpc:20000126 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Liqueur"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the manufacturer to identify a particular type of liqueur."@en .

gpc:20000128 a rdf:Property, gpc:Attribute ;
  rdfs:label "Manufacturers Treatment/Cooking Process"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to describe the type of manufacturers treatment/cooking process the product has undergone."@en .

gpc:20000131 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Meat"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of meat, poultry, game or&#160;batrachian."@en .

gpc:20000134 a rdf:Property, gpc:Attribute ;
  rdfs:label "Method of Cooking/Reheating"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the method of heating or cooking the product."@en .

gpc:20000136 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Water"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of water."@en .

gpc:20000137 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With New Harvest Claim"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether a product has been harvested at an early stage of development."@en .

gpc:20000138 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Nut/Seed"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of nut or seed."@en .

gpc:20000140 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Edible Vegetable or Plant Oil"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type or variety of edible vegetable or plant oil."@en .

gpc:20000141 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Olive"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of Olive."@en .

gpc:20000142 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Organic"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify the presence of an industry recognized &quot;organic&quot; certification upon the product labelling or packaging."@en .

gpc:20000143 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Pasta or Noodle"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the type of pasta or noodle."@en .

gpc:20000144 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Pate"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of pate."@en .

gpc:20000146 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Pickled Vegetables"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of pickled vegetables."@en .

