gpc:93060100 a gpc:Class ;
  rdfs:label "Plants Variety Packs"@en ;
  rdfs:subClassOf gpc:93060000 .

gpc:93070000 a gpc:Family ;
  rdfs:label "Seeds/Spores"@en ;
  rdfs:comment "Includes any products that may be described/observed as the fertilized ovule of a plant that contains an embryo and food products for germination. These products are smaller than bulbs, ranging from microscopic to over an inch long. Includes products such as pre-treated seeds."@en ;
  rdfs:subClassOf gpc:93000000 .

gpc:93070100 a gpc:Class ;
  rdfs:label "Seeds/Spores"@en ;
  rdfs:comment "Includes any products that may be described/observed as the fertilized ovule of a plant that contains an embryo and food products for germination. These products are smaller than bulbs, ranging from microscopic to over an inch long. Includes products such as pre-treated seeds."@en ;
  rdfs:subClassOf gpc:93070000 .

gpc:93080000 a gpc:Family ;
  rdfs:label "Shrubs/Trees"@en ;
  rdfs:comment "Includes any products that may be described/observed as woody, bushy plants that can either have a single main stem or branch into several stems at the base. These plants can be either evergreen or deciduous and are able to produce cones, flowers and fruit. Trees are mostly distinguished from shrubs through the appearance of a single stem and the fact that they branch a greater distance from the ground than shrubs. Includes products such as evergreen trees and deciduous shrubs as well as any fruit bearing tree or shrub."@en ;
  rdfs:subClassOf gpc:93000000 .

gpc:93080100 a gpc:Class ;
  rdfs:label "Shrubs/Trees"@en ;
  rdfs:comment "Includes any products that may be described/observed as woody, bushy plants that can either have a single main stem or branch into several stems at the base. These plants can be either evergreen or deciduous and are able to produce cones, flowers and fruit. Trees are mostly distinguished from shrubs through the appearance of a single stem and the fact that they branch a greater distance from the ground than shrubs. Includes products such as evergreen trees and deciduous shrubs as well as any fruit bearing tree or shrub."@en ;
  rdfs:subClassOf gpc:93080000 .

gpc:93090000 a gpc:Family ;
  rdfs:label "Vegetables/Fungi Plants"@en ;
  rdfs:comment "Includes any products that may be described/observed as food plants, most of them annual, which are planted for their edible parts. Includes products such as mushrooms and potatoes that are growing plants and are bought ready to be planted."@en ;
  rdfs:subClassOf gpc:93000000 .

gpc:93090100 a gpc:Class ;
  rdfs:label "Vegetables/Fungi Plants"@en ;
  rdfs:comment "Includes any products that may be described/observed as food plants, most of them annual, which are planted for their edible parts. Includes products such as mushrooms and potatoes that are growing plants and are bought ready to be planted."@en ;
  rdfs:subClassOf gpc:93090000 .

gpc:93100000 a gpc:Family ;
  rdfs:label "Bouquets"@en ;
  rdfs:comment "Includes any products that may be described/observed as Bouquet or mixture of cut flowers and greens sold as an arrangement."@en ;
  rdfs:subClassOf gpc:93000000 .

gpc:93100100 a gpc:Class ;
  rdfs:label "Bouquets"@en ;
  rdfs:comment "Includes any products that may be described/observed as Bouquet or mixture of cut flowers and greens sold as an arrangement."@en ;
  rdfs:subClassOf gpc:93100000 .

gpc:93110000 a gpc:Family ;
  rdfs:label "Seedlings - Ready to Grow"@en ;
  rdfs:subClassOf gpc:93000000 .

gpc:93110100 a gpc:Class ;
  rdfs:label "Seedlings - Ready to Grow"@en ;
  rdfs:subClassOf gpc:93110000 .

gpc:94000000 a gpc:Segment ;
  rdfs:label "Crops"@en ;
  rdfs:comment "Crops of cultivated plants, being seedbearing gymnosperms, free sporing cryptogams, algae and funghi, that are cultivated for human nutrition or for other useful purposes, also includes wild plants that are foraged in a systematical manner and then traded."@en .

gpc:94010000 a gpc:Family ;
  rdfs:label "Crops not for food or feed (animal and fish)"@en ;
  rdfs:subClassOf gpc:94000000 .

gpc:94010100 a gpc:Class ;
  rdfs:label "Crops for natural fibre and resins production (Fibre crops)"@en ;
  rdfs:comment "Crops cultivated for the production of fibres and resins"@en ;
  rdfs:subClassOf gpc:94010000 .

gpc:94010300 a gpc:Class ;
  rdfs:label "Crops for production of natural pigments, resins and waxes"@en ;
  rdfs:comment "Crops cultivated primarily for production of natural pigment, resins and waxes. Excludes products from harvested crops and crops for which the production of pigments, resins, waxes and oil is a byproduct of cultivation."@en ;
  rdfs:subClassOf gpc:94010000 .

gpc:94010700 a gpc:Class ;
  rdfs:label "Non-toxic Plants for Medicines and Essential Oils"@en ;
  rdfs:comment "Crops from non-toxic plants primarily cultivated for the production of medicines and/or essential oils."@en ;
  rdfs:subClassOf gpc:94010000 .

gpc:94010800 a gpc:Class ;
  rdfs:label "Toxic Plant for Medicines"@en ;
  rdfs:comment "Cultivated crops for the production of medicines from toxic plants"@en ;
  rdfs:subClassOf gpc:94010000 .

gpc:94020000 a gpc:Family ;
  rdfs:label "Crops for Food Production"@en ;
  rdfs:comment "Crops primarily cultivated for the production of food. Includes crops with byproducts used for animal feed or byproducts used for the production of non-food products."@en ;
  rdfs:subClassOf gpc:94000000 .

gpc:94020100 a gpc:Class ;
  rdfs:label "Crops for Production of Annonafruit"@en ;
  rdfs:comment "This class is populated with fruit giving crops from the botanical family of Anonaceae (soursopfamily)."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020200 a gpc:Class ;
  rdfs:label "Crops for Production of Banana Fruit"@en ;
  rdfs:comment "This class is populated with fruit giving crops from the botanical family of Musaceae (bananafamily)."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020300 a gpc:Class ;
  rdfs:label "Edible Pomefruit Crops"@en ;
  rdfs:comment "Cultivated crops for the production of edible pome fruits"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020400 a gpc:Class ;
  rdfs:label "Edible Bulb Crops"@en ;
  rdfs:comment "Cultivated crops for the production of edible bulbs for consumption as vegetables."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020500 a gpc:Class ;
  rdfs:label "Crops for Production of Berries and Small Fruit"@en ;
  rdfs:comment "Cultivated crops for the production of edible berries and other small fruit from shrubby plants and trees."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020600 a gpc:Class ;
  rdfs:label "Crops for Production of Citrus and Other Rutaceae Fruits"@en ;
  rdfs:comment "Cultivated crops for the production of citrusfruits and other fruits from rutaceae trees."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020700 a gpc:Class ;
  rdfs:label "Crops for Production of Stonefruits"@en ;
  rdfs:comment "Cultivated crops for the production of fruit from drupes of Rosaceae trees."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020800 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Cactusfruits"@en ;
  rdfs:comment "Cultivated crops for the production of edible fruit&#160; from cactusplants - cactaceae"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94020900 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Fruit from Palmtrees"@en ;
  rdfs:comment "Cultivated crops for the production of edible fruit&#160; from palmtrees - areceae"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021000 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Myrtletree Fruits"@en ;
  rdfs:comment "Cultivated crops for the production of edible fruit&#160; from myrtletrees - Myrtaceae"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021100 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Sumacfruits"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021200 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Fruits from Soapberrytrees"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021300 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Fruit from Sapote trees"@en ;
  rdfs:comment "Cultivated crops for the production of edible fruit from Sapotetrees - Sapotaceae"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021400 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Fruit from Phyllantaceae trees"@en ;
  rdfs:comment "Cultivated crops for the production of edible fruit from Phyllantaceae trees"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021500 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Fruit from Other Trees and Plants"@en ;
  rdfs:comment "Cultivated crops for the production of edible fruit from other trees and plants&#160;"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021600 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Nuts"@en ;
  rdfs:comment "Cultivated crops for the production of edible nuts from trees"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021700 a gpc:Class ;
  rdfs:label "Crops for Production of Edible Groundnuts"@en ;
  rdfs:comment "Cultivated crops for the production of plants growing edible pods between their roots"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021800 a gpc:Class ;
  rdfs:label "Crops for Beverages"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94021900 a gpc:Class ;
  rdfs:label "Cereals and Grains Crops"@en ;
  rdfs:comment "Cultivated crops for the production of grains and cereals"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022000 a gpc:Class ;
  rdfs:label "Sugar Crops"@en ;
  rdfs:comment "Cultivated crops for the production of sugar"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022100 a gpc:Class ;
  rdfs:label "Vegetable Oil-seed Crops"@en ;
  rdfs:comment "Cultivated crops for the production of edible oils from seeds"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022200 a gpc:Class ;
  rdfs:label "Brassica Vegetables (Cabbage Type)"@en ;
  rdfs:comment "Cultivated crops for the production of vegetables from brassicaceae headtype plants"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022300 a gpc:Class ;
  rdfs:label "Edible Legume Crops"@en ;
  rdfs:comment "Cultivated crops for the production edible legumes or pulses (beans and peas)&#160;&#160;"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022400 a gpc:Class ;
  rdfs:label "Stem Vegetables"@en ;
  rdfs:comment "Cultivated crops for the production of vegetables with edible stems."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022500 a gpc:Class ;
  rdfs:label "Vegetable Crops - Edible roots, Tubers and Rhizomes"@en ;
  rdfs:comment "Cultivated crops for the production of vegetables with edible roots, tubers or rhizomes&#160;"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022600 a gpc:Class ;
  rdfs:label "Edible Funghi"@en ;
  rdfs:comment "Cultivated crops for the production of edible funghi"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022700 a gpc:Class ;
  rdfs:label "Fruiting Vegetable Crops - Solanaceae"@en ;
  rdfs:comment "Cultivated crops for the production of fruiting vegetables from nightshades (solanaceae)"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022800 a gpc:Class ;
  rdfs:label "Fruiting Vegetable Crops - Squash And Gourds"@en ;
  rdfs:comment "Cultivated crops for the production of fruiting vegetables from squashes and gourds (cucurbitaceae)"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94022900 a gpc:Class ;
  rdfs:label "Fruiting Vegetables - Other"@en ;
  rdfs:comment "Cultivated crops for the production of fruiting vegetables from other families than solanaceae and cucurbitaceae"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023000 a gpc:Class ;
  rdfs:label "Leaf Vegetable Crops - Cichoryplants"@en ;
  rdfs:comment "Cultivated crops for the production of leaf-vegetables from cichorium plants"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023100 a gpc:Class ;
  rdfs:label "Leaf Vegetable Crops - Lettuceplants"@en ;
  rdfs:comment "Cultivated crops for the production of leaf-vegetables from lactuca genus"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023200 a gpc:Class ;
  rdfs:label "Leaf Vegetable Crops - Brassicaceae"@en ;
  rdfs:comment "Cultivated leaf vegetable crops from the brassicaceae family"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023300 a gpc:Class ;
  rdfs:label "Leaf Vegetable Crops - Spinachtype"@en ;
  rdfs:comment "Cultivated crops for the production of leaf-vegetables from the amaranthaceae family (spinach type)"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023400 a gpc:Class ;
  rdfs:label "Leaf Vegetable Crops - Other"@en ;
  rdfs:comment "Cultivated crops for the production of leaf-vegetables from other plantfamilies then asteraceae (lettuce, chichory), amarantaceae(spinachtype) and brassicaceae&#160;"@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023500 a gpc:Class ;
  rdfs:label "Edible Herbs"@en ;
  rdfs:comment "Cultivated Crops for Production of Edible Herbs."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94023600 a gpc:Class ;
  rdfs:label "Edible Spices"@en ;
  rdfs:comment "Cultivated Crops for Production of Edible Spices."@en ;
  rdfs:subClassOf gpc:94020000 .

gpc:94030000 a gpc:Family ;
  rdfs:label "Grass and Other Crops for Animal Feed or for Soil Improvement"@en ;
  rdfs:comment "Crops primarily cultivated for the production of fodder for domestic livestock, for soil improvement, also includes grasses cultivated for other than horticultural purposes."@en ;
  rdfs:subClassOf gpc:94000000 .

gpc:94030100 a gpc:Class ;
  rdfs:label "Graminoids (Grasses)"@en ;
  rdfs:comment "Cultivated crops for production of grasses which are primarily used as animal feed or that are cultivated for use as artificially created meadows, lawns or sports fields."@en ;
  rdfs:subClassOf gpc:94030000 .

gpc:94030300 a gpc:Class ;
  rdfs:label "Legume Feed Crops"@en ;
  rdfs:comment "Crops primarily cultivated as fodder for livestock, green manure or covercrop from legume plants"@en ;
  rdfs:subClassOf gpc:94030000 .

gpc:94030400 a gpc:Class ;
  rdfs:label "Other Feed Crops"@en ;
  rdfs:subClassOf gpc:94030000 .

