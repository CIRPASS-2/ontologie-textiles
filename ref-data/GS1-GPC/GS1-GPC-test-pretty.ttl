gpc:30017799 a gpc:AttributeValue ;
  rdfs:label "CROSS HATCHING TOOL"@en ;
  rdfs:comment "Product supports hatching. It is an artistic technique used to create tonal or shading effects by drawing (or painting or scribing) closely spaced parallel lines."@en .

gpc:30017800 a gpc:AttributeValue ;
  rdfs:label "PEN SUITABLE FOR PLASTIC SURFACES"@en ;
  rdfs:comment "Indicates, that the product could write on any kind of plastic surface."@en .

gpc:30017801 a gpc:AttributeValue ;
  rdfs:label "TECHNICAL PEN"@en ;
  rdfs:comment "The product is a specialized instrument used by an engineer, architect, or drafter to make lines of constant width for architectural, engineering, or technical drawings."@en .

gpc:30017802 a gpc:AttributeValue ;
  rdfs:label "DRY ERASE"@en ;
  rdfs:comment "Dry erase ink is typically used on a glossy surface and does not need liquid to erase."@en .

gpc:30017803 a gpc:AttributeValue ;
  rdfs:label "ERASABLE"@en .

gpc:30017804 a gpc:AttributeValue ;
  rdfs:label "INDELIBLE"@en .

gpc:30017805 a gpc:AttributeValue ;
  rdfs:label "WET ERASE"@en ;
  rdfs:comment "Wet erase ink is typically used on overhead transparencies, office calendars, mirrors and other non-porous surfaces and needs liquid to erase."@en .

gpc:30017806 a gpc:AttributeValue ;
  rdfs:label "KRAFT PAPER"@en ;
  rdfs:comment "A strong, smooth brown wrapping paper designed for packaging products with high demands for strength and durability."@en .

