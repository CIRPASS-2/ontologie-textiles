gpc:30013593 a gpc:AttributeValue ;
  rdfs:label "CHILLED"@en ;
  rdfs:comment "Product maintained at not less than -2.0 &#176;C or more than + 4.0 &#176;C at all times following the post-slaughter chilling process."@en .

gpc:30013594 a gpc:AttributeValue ;
  rdfs:label "BULK FROZEN"@en ;
  rdfs:comment "Product is frozen after packaging and maintained at not less than -12.0 &#176;C or more than -2.0 &#176;C at all times after freezing."@en .

gpc:30013595 a gpc:AttributeValue ;
  rdfs:label "INDIVIDUALLY FROZEN WITH ICE GLAZING"@en ;
  rdfs:comment "Product pieces are individually frozen before packaging and maintained at -18 &#176;C or less at all times after freezing. Product is misted at the start of the freezing process to create a glaze of ice to keep pieces from sticking together and to minimize freezer burn."@en .

gpc:30013596 a gpc:AttributeValue ;
  rdfs:label "INDIVIDUALLY FROZEN WITHOUT ICE GLAZING"@en ;
  rdfs:comment "Product pieces are individually frozen before packaging and maintained at -18 &#176;C or less at all times after freezing."@en .

gpc:30013597 a gpc:AttributeValue ;
  rdfs:label "SHELF STABLE"@en ;
  rdfs:comment "Product does not require refrigeration to maintain quality."@en .

gpc:30013598 a gpc:AttributeValue ;
  rdfs:label "RAW/UNCOOKED"@en ;
  rdfs:comment "Product has not been thermally treated."@en .

gpc:30013599 a gpc:AttributeValue ;
  rdfs:label "BLANCHED"@en ;
  rdfs:comment "Product which has been quick-cooked and then chilled to stop the cooking process."@en .

gpc:30013600 a gpc:AttributeValue ;
  rdfs:label "PARTIALLY COOKED"@en ;
  rdfs:comment "Product has been thermally treated but requires additional cooking before it is ready to eat."@en .

gpc:30013601 a gpc:AttributeValue ;
  rdfs:label "FULLY COOKED"@en ;
  rdfs:comment "Product has been thermally treated so that it is ready to eat or to be heated and served."@en .

gpc:30013602 a gpc:AttributeValue ;
  rdfs:label "DOMESTICATED/FARM RAISED"@en ;
  rdfs:comment "Product was produced using domesticated stock and common husbandry practices."@en .

gpc:30013603 a gpc:AttributeValue ;
  rdfs:label "WILD/WILD CAUGHT"@en ;
  rdfs:comment "Product was harvested from wild populations."@en .

gpc:30013604 a gpc:AttributeValue ;
  rdfs:label "BATTER"@en ;
  rdfs:comment "Product has a wet flour-based coating applied topically."@en .

gpc:30013605 a gpc:AttributeValue ;
  rdfs:label "BREADING"@en ;
  rdfs:comment "Product has a dry bread-based coating applied topically."@en .

gpc:30013606 a gpc:AttributeValue ;
  rdfs:label "GLAZING"@en ;
  rdfs:comment "Product has a glaze coating applied topically."@en .

gpc:30013607 a gpc:AttributeValue ;
  rdfs:label "TOPICAL MARINADE"@en ;
  rdfs:comment "Product has a liquid-based flavoring applied topically."@en .

gpc:30013608 a gpc:AttributeValue ;
  rdfs:label "SAUCE/GRAVY"@en ;
  rdfs:comment "Product has a thick, liquid-based flavoring applied topically."@en .

gpc:30013609 a gpc:AttributeValue ;
  rdfs:label "SEASONING"@en ;
  rdfs:comment "Product has a dry, nonbread-based coating of herbs and/or spices applied topically."@en .

gpc:30013610 a gpc:AttributeValue ;
  rdfs:label "STUFFING/FILLING"@en ;
  rdfs:comment "Product has a stuffing mechanically added to its centre or the product is wrapped around a filling."@en .

gpc:30013611 a gpc:AttributeValue ;
  rdfs:label "UNFLAVOURED SOLUTION INCORPORATED"@en ;
  rdfs:comment "Product has unflavoured solution added by needle injection or by vacuum tumbling."@en .

gpc:30013612 a gpc:AttributeValue ;
  rdfs:label "FLAVOURED SOLUTION/MARINADE INCORPORATED"@en ;
  rdfs:comment "Product has a liquid-based flavouring added by needle injection or by vacuum tumbling."@en .

gpc:30013613 a gpc:AttributeValue ;
  rdfs:label "FLAVOURED SOLUTION/MARINADE INCORPORATED AND TOPICAL MARINADE"@en ;
  rdfs:comment "Product has a liquid-based flavouring added by needle injection or by vacuum tumbling and a liquid-based flavouring applied topically."@en .

gpc:30013614 a gpc:AttributeValue ;
  rdfs:label "NO ADDED INGREDIENTS"@en ;
  rdfs:comment "No additions such as seasonings, liquids, glazing, marinades, batter, or breading are present."@en .

gpc:30013615 a gpc:AttributeValue ;
  rdfs:label "DRY AGED"@en ;
  rdfs:comment "Product held for an extended period of time in a cooled environment to enhance flavour and reduce moisture content."@en .

gpc:30013616 a gpc:AttributeValue ;
  rdfs:label "IRRADIATED"@en ;
  rdfs:comment "Product is exposed to ionizing radiation to destroy microorganisms, bacteria, and viruses."@en .

gpc:30013617 a gpc:AttributeValue ;
  rdfs:label "PICKLED"@en ;
  rdfs:comment "Product preserved by immersion in brine solution."@en .

gpc:30013618 a gpc:AttributeValue ;
  rdfs:label "SALTED/CURED"@en ;
  rdfs:comment "Product preserved using salt, sugar, or nitrate."@en .

gpc:30013619 a gpc:AttributeValue ;
  rdfs:label "SMOKED/CURED"@en ;
  rdfs:comment "Product preserved using salt, sugar, or nitrate and partially or fully cooked using a smoking process."@en .

gpc:30013620 a gpc:AttributeValue ;
  rdfs:label "NO NON-THERMAL PRESERVATION"@en ;
  rdfs:comment "Product has not been non-thermally processed (e.g., not smoked or cured)."@en .

gpc:30013621 a gpc:AttributeValue ;
  rdfs:label "CHOPPED AND FORMED"@en ;
  rdfs:comment "Product has been chopped into irregularly sized pieces and reformed."@en .

gpc:30013622 a gpc:AttributeValue ;
  rdfs:label "MECHANICAL TENDERIZATION"@en ;
  rdfs:comment "Product has been tenderized mechanically by a process such as needle tenderization or table-top cubing."@en .

gpc:30013623 a gpc:AttributeValue ;
  rdfs:label "GROUND/MINCED"@en ;
  rdfs:comment "Product that has been extruded under pressure through a sieve."@en .

gpc:30013624 a gpc:AttributeValue ;
  rdfs:label "MECHANICALLY SEPARATED"@en ;
  rdfs:comment "Product with paste-like consistency created by separating meat from bone using high pressure."@en .

gpc:30013625 a gpc:AttributeValue ;
  rdfs:label "NO MECHANICAL PROCESSING"@en ;
  rdfs:comment "Product has not been mechanically processed (e.g., not ground or mechanically tenderized)."@en .

gpc:30013626 a gpc:AttributeValue ;
  rdfs:label "BONE"@en ;
  rdfs:comment "Rigid, ossified organs from the endoskeleton of vertebrates."@en .

gpc:30013627 a gpc:AttributeValue ;
  rdfs:label "CARCASS (NON-POULTRY)"@en ;
  rdfs:comment "Body of large, slaughtered animal after offal is removed that is typically sold at wholesale level."@en .

gpc:30013628 a gpc:AttributeValue ;
  rdfs:label "FOREQUARTER"@en ;
  rdfs:comment "The anterior portion of a large animal spilt carcass."@en .

gpc:30013629 a gpc:AttributeValue ;
  rdfs:label "HINDQUARTER"@en ;
  rdfs:comment "The posterior portion of a large animal spilt carcass."@en .

gpc:30013630 a gpc:AttributeValue ;
  rdfs:label "WHOLE BIRD"@en ;
  rdfs:comment "Body of a bird after offal is removed."@en .

gpc:30013631 a gpc:AttributeValue ;
  rdfs:label "FAT"@en ;
  rdfs:comment "Lipid animal tissue that is solid at room temperature."@en .

gpc:30013632 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - POULTRY PART"@en ;
  rdfs:comment "Large, unsliced muscle cut or part separated from a whole bird and typically sold to the end consumer."@en .

gpc:30013633 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - NON POULTRY MEAT PART/PIECE"@en ;
  rdfs:comment "Large, unsliced muscle cut or part separated from a carcass and typically sold to the end consumer."@en .

gpc:30013634 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - PRIMAL"@en ;
  rdfs:comment "Unsliced whole muscle cut first separated from a large animal carcass."@en .

gpc:30013635 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - RIB CUT"@en ;
  rdfs:comment "Muscle piece from the chuck, rib, plate, or belly containing rib bones."@en .

gpc:30013636 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - ROAST CUT"@en ;
  rdfs:comment "Flat muscle slice that is 5 cm. (2 in.) or more thick."@en .

gpc:30013637 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - SLICE/CUTLET CUT"@en ;
  rdfs:comment "Thin, flat muscle slice that is less than 2 cm. (3/4 in.) thick."@en .

gpc:30013638 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - STEAK/CHOP CUT"@en ;
  rdfs:comment "Flat muscle slice that is 2 to 4 cm. (3/4 to 1 1/2 in.) thick."@en .

gpc:30013639 a gpc:AttributeValue ;
  rdfs:label "WHOLE MUSCLE - SUB-PRIMAL"@en ;
  rdfs:comment "Unsliced whole muscle cut separated from a large animal primal cut."@en .

gpc:30013640 a gpc:AttributeValue ;
  rdfs:label "TENDONS"@en ;
  rdfs:comment "Fibrous connective tissue."@en .

gpc:30013641 a gpc:AttributeValue ;
  rdfs:label "MIXED PARTS FOR GROUNDING/MINCING"@en ;
  rdfs:comment "Two or more product forms are combined to create a single product such as a sausage."@en .

gpc:30013642 a gpc:AttributeValue ;
  rdfs:label "BULK/UNSHAPED"@en ;
  rdfs:comment "Product with no defined shape such as bulk ground or paste-like product."@en .

gpc:30013643 a gpc:AttributeValue ;
  rdfs:label "CHUB/LOG"@en ;
  rdfs:comment "A large generally tubular shape of ground or chopped product."@en .

gpc:30013644 a gpc:AttributeValue ;
  rdfs:label "DICED/CUBE-SHAPED"@en ;
  rdfs:comment "A product that has been cut into somewhat uniformly sized small blocks."@en .

gpc:30013645 a gpc:AttributeValue ;
  rdfs:label "MEATBALL"@en ;
  rdfs:comment "A generally spherical mass of ground meat."@en .

gpc:30013646 a gpc:AttributeValue ;
  rdfs:label "NATURAL CARCASS/PART/MUSCLE"@en ;
  rdfs:comment "Shape of a naturally occurring body part, muscle, bone, or offal."@en .

gpc:30013647 a gpc:AttributeValue ;
  rdfs:label "NATURAL MUSCLE - SPIRALLY SLICED"@en ;
  rdfs:comment "Natural-shaped whole muscle product cut spirally around the bone (e.g. a spirally sliced ham)."@en .

gpc:30013648 a gpc:AttributeValue ;
  rdfs:label "NUGGETS"@en ;
  rdfs:comment "A shaped small mass of ground or chopped product."@en .

gpc:30013649 a gpc:AttributeValue ;
  rdfs:label "PATTY"@en ;
  rdfs:comment "A generally flat, formed serving of ground meat."@en .

gpc:30013650 a gpc:AttributeValue ;
  rdfs:label "PULLED"@en ;
  rdfs:comment "Cooked product separated or pulled apart along its natural seams or grain."@en .

gpc:30013651 a gpc:AttributeValue ;
  rdfs:label "ROPE/RING"@en ;
  rdfs:comment "A long, tubular shaped ground or chopped product with or without an edible casing where the ends of each segment touch (ring) or where the length is coiled (rope)."@en .

gpc:30013652 a gpc:AttributeValue ;
  rdfs:label "LINK (MEAT SHAPE)"@en ;
  rdfs:comment "A generally short, tubular shaped ground or chopped product with or without an edible casing."@en .

gpc:30013653 a gpc:AttributeValue ;
  rdfs:label "STRIP (MEAT SHAPE)"@en ;
  rdfs:comment "A long and thin piece of muscle or bacon."@en .

gpc:30013654 a gpc:AttributeValue ;
  rdfs:label "QUALITY LEVEL 1"@en ;
  rdfs:comment "Product meets Quality Level 1 as determined by a quality certifying agency known to buyer and seller."@en .

gpc:30013655 a gpc:AttributeValue ;
  rdfs:label "QUALITY LEVEL 2"@en ;
  rdfs:comment "Product meets Quality Level 2 as determined by a quality certifying agency known to buyer and seller."@en .

gpc:30013656 a gpc:AttributeValue ;
  rdfs:label "QUALITY LEVEL 3"@en ;
  rdfs:comment "Product meets Quality Level 3 as determined by a quality certifying agency known to buyer and seller."@en .

gpc:30013657 a gpc:AttributeValue ;
  rdfs:label "QUALITY LEVEL 4 OR LOWER"@en ;
  rdfs:comment "Product meets Quality Level 4 or a lower quality grade as determined by a quality certifying agency known to buyer and seller."@en .

gpc:30013658 a gpc:AttributeValue ;
  rdfs:label "10-PIECE CUT-UP (UNECE 700208)"@en .

gpc:30013659 a gpc:AttributeValue ;
  rdfs:label "1ST AND 2ND SEGMENT WING / V-WING (UNECE 701302)"@en .

gpc:30013660 a gpc:AttributeValue ;
  rdfs:label "1ST SEGMENT AND 2ND SEGMENT WINGS (UNECE 701307)"@en .

gpc:30013661 a gpc:AttributeValue ;
