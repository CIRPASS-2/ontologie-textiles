  rdfs:subClassOf gpc:50260000 .

gpc:50261900 a gpc:Class ;
  rdfs:label "Micro Vegetables"@en ;
  rdfs:comment "This Class applies to juvenile or immature appearances of vegetables in the form of buds with or without leaves."@en ;
  rdfs:subClassOf gpc:50260000 .

gpc:50262000 a gpc:Class ;
  rdfs:label "Edible Flowers"@en ;
  rdfs:comment "This Class applies to edible flowers of plants."@en ;
  rdfs:subClassOf gpc:50260000 .

gpc:50262100 a gpc:Class ;
  rdfs:label "Tidal Sea Vegetables"@en ;
  rdfs:comment "This Class applies to perennial plants grown in cultures in tidal areas which are flooded with salt water on a regular basis."@en ;
  rdfs:subClassOf gpc:50260000 .

gpc:50262200 a gpc:Class ;
  rdfs:label "Chickpeas"@en ;
  rdfs:comment "This standard applies to Chickpeas (also called ceci bean, garbanzo bean, chana, sanagalu Indian pea, Bengal gram) of varieties (cultivars) grown from Cicer arietinum to be supplied fresh."@en ;
  rdfs:subClassOf gpc:50260000 .

