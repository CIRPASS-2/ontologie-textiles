gpc:20002889 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Target Battery Use"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the battery target use."@en .

gpc:20002890 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Frequent Use Battery"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the battery suits for frequent use, primarily for start/stop usage."@en .

gpc:20002891 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Brake Drum/Brake Drum Part"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the part of the brake drum or the complete brake drum."@en .

gpc:20002892 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Brake Part System"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the other part of the braking system."@en .

gpc:20002893 a rdf:Property, gpc:Attribute ;
  rdfs:label "Mounting Area"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the Mounting area for the brakes."@en .

gpc:20002894 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Chewing Gum"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging the descriptive term that is used by the product manufacturer to identify a particular type or variety of chewing gum."@en .

gpc:20002895 a rdf:Property, gpc:Attribute ;
  rdfs:label "Contains Alcohol"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product claims to contain alcohol as an ingredient."@en .

gpc:20002896 a rdf:Property, gpc:Attribute ;
  rdfs:label "Is Assorted"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify whether or not the product is assorted."@en .

gpc:20002897 a rdf:Property, gpc:Attribute ;
  rdfs:label "Ultra Violet (UV) Protection"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify the ultra violet (UV) protection of the product, usually labelled as a numerical Sun Protection Factor (SPF)."@en .

gpc:20002898 a rdf:Property, gpc:Attribute ;
  rdfs:label "Environmental Conditions"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product has been specially formulated for certain environmental conditions."@en .

gpc:20002899 a rdf:Property, gpc:Attribute ;
  rdfs:label "Tread Width"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the tread width of the tyre."@en .

gpc:20002900 a rdf:Property, gpc:Attribute ;
  rdfs:label "Aspect Ratio"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the tread width of the aspect ratio, which is the ratio of the height to the width."@en .

gpc:20002901 a rdf:Property, gpc:Attribute ;
  rdfs:label "Fabric Carcass"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the type of fabric carcass or casing that is used by the product manufacturer to provide strength and resilience beneath the tread and side-wall of the tyre."@en .

gpc:20002902 a rdf:Property, gpc:Attribute ;
  rdfs:label "Speed Rating"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the speed rating. If a listed speed rating contains two letters (such as VR), the first letter represents the speed rating and the second letter (R) indicates that it is a radial tire."@en .

gpc:20002903 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Tyres With Tube"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, that is used by the product manufacturer to identify that the product may or needs to contain a tube."@en .

gpc:20002904 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Spinning Movement"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the item has a spinning movement."@en .

gpc:20002905 a rdf:Property, gpc:Attribute ;
  rdfs:label "If With Electronic Information Panel"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if his product has an electronic Information panal."@en .

gpc:20002906 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Elliptical Movement"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the item has an elliptical movement."@en .

gpc:20002907 a rdf:Property, gpc:Attribute ;
  rdfs:label "If Foldable or Small Size"@en .

gpc:20002908 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Free Weight/Dumb-Bell Accessories"@en ;
