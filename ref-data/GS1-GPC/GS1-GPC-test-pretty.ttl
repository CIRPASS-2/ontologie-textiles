gpc:20002809 a rdf:Property, gpc:Attribute ;
  rdfs:label "Egg Product Pasteurisation"@en ;
  rdfs:comment "Indicates whether the egg product has been heat treated to kill appropriate pathogens, and if so whether naturally occurring egg enzymes have been modified."@en .

gpc:20002810 a rdf:Property, gpc:Attribute ;
  rdfs:label "Egg Product Refrigeration State"@en ;
  rdfs:comment "The extent to which heat is removed to preserve the product quality of egg products (the content of eggs that have been removed from the shell)."@en .

gpc:20002812 a rdf:Property, gpc:Attribute ;
  rdfs:label "Primary Additive (Egg)"@en ;
  rdfs:comment "The primary non-meat ingredient added to the egg."@en .

gpc:20002813 a rdf:Property, gpc:Attribute ;
  rdfs:label "Shell Color"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labeling or packaging the descriptive term that is used by the product manufacturer to identify a the color of the in-shell eggs."@en .

gpc:20002814 a rdf:Property, gpc:Attribute ;
