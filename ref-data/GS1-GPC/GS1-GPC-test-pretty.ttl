gpc:30015376 a gpc:AttributeValue ;
  rdfs:label "AGED (EGG)"@en ;
  rdfs:comment "Egg is stored for an extended period of time without refrigeration or chemically treated to radically change the internal characteristics of the egg."@en .

gpc:30015377 a gpc:AttributeValue ;
  rdfs:label "CHEMICALLY EXTRACTED (EGG)"@en ;
  rdfs:comment "Product such as a protein or vitamin is isolated from a liquid egg product using acceptable food-grade processing aides."@en .

gpc:30015378 a gpc:AttributeValue ;
  rdfs:label "DRIED - PAN (EGG)"@en ;
  rdfs:comment "Liquid egg product is passed over a heated surface to evaporate water."@en .

gpc:30015379 a gpc:AttributeValue ;
  rdfs:label "CONCENTRATED (EGG)"@en ;
  rdfs:comment "Water is removed using membrane technology."@en .

gpc:30015380 a gpc:AttributeValue ;
  rdfs:label "DRIED - PROCESS UNIDENTIFIED (EGG)"@en ;
  rdfs:comment "Liquid egg product is converted to a dry form using an unknown process."@en .

gpc:30015381 a gpc:AttributeValue ;
  rdfs:label "DRIED - SPRAY (EGG)"@en ;
  rdfs:comment "Atomized egg product is heated in a chamber to create a powder."@en .

gpc:30015382 a gpc:AttributeValue ;
  rdfs:label "FERMENTED (EGG)"@en ;
  rdfs:comment "Glucose removed through the fermentation of natural sugars."@en .

gpc:30015383 a gpc:AttributeValue ;
  rdfs:label "FREEZE - DRIED (EGG)"@en ;
  rdfs:comment "Water removed under a partial vacuum."@en .

gpc:30015384 a gpc:AttributeValue ;
  rdfs:label "LYSOZYME REMOVED (EGG)"@en ;
  rdfs:comment "Lysozyme removed through physical or ion exchange process using acceptable processing aides."@en .

gpc:30015385 a gpc:AttributeValue ;
  rdfs:label "NO TREATMENT PROCESS (EGG)"@en ;
  rdfs:comment "No treatment process is applied by the processor during product production."@en .

gpc:30015386 a gpc:AttributeValue ;
  rdfs:label "CHICKEN"@en ;
  rdfs:comment "Product is obtained from birds of the species Gallus gallus ."@en .

gpc:30015387 a gpc:AttributeValue ;
  rdfs:label "DUCK"@en ;
  rdfs:comment "Product is obtained from birds of the Family Anatidae excluding the Tribe of Anserini."@en .

gpc:30015388 a gpc:AttributeValue ;
  rdfs:label "EMU"@en ;
  rdfs:comment "Product is obtained from birds of the species Dromaius novaehollandiae ."@en .

gpc:30015389 a gpc:AttributeValue ;
  rdfs:label "GOOSE"@en ;
  rdfs:comment "Product is obtained from birds of the Tribe Anserini ."@en .

gpc:30015390 a gpc:AttributeValue ;
  rdfs:label "GUINEAFOWL"@en ;
  rdfs:comment "Product is obtained from birds of the species Numida meleagris ."@en .

gpc:30015391 a gpc:AttributeValue ;
  rdfs:label "OSTRICH"@en ;
  rdfs:comment "Product is obtained from birds of the species Struthio camelus ."@en .

gpc:30015392 a gpc:AttributeValue ;
  rdfs:label "QUAIL"@en ;
  rdfs:comment "Product is obtained from birds of the family of Phasianidae excluding the subfamily Phasianinae (pheasants)."@en .

gpc:30015393 a gpc:AttributeValue ;
  rdfs:label "RHEA"@en ;
  rdfs:comment "Product is obtained from birds of the Genus Rhea ."@en .

gpc:30015394 a gpc:AttributeValue ;
  rdfs:label "SQUAB/PIGEON"@en ;
  rdfs:comment "Product is obtained from young birds of the species Columba livia ."@en .

gpc:30015395 a gpc:AttributeValue ;
  rdfs:label "CONVENTIONAL (CAGED)"@en ;
  rdfs:comment "Production method uses standard-sized battery cages for producing hens."@en .

gpc:30015396 a gpc:AttributeValue ;
  rdfs:label "CAGE-FREE"@en ;
  rdfs:comment "Production method allows cage-free movement to produce hens."@en .

gpc:30015397 a gpc:AttributeValue ;
  rdfs:label "NON CONVENTIONAL CAGED"@en ;
  rdfs:comment "Production method uses cages larger than the standard-sized battery cages for producing hens but without outdoor access."@en .

gpc:30015398 a gpc:AttributeValue ;
  rdfs:label "PASTEURISED (WITHOUT ENZYME MODIFICATION)"@en ;
  rdfs:comment "Enzymes are not modified prior to product pasteurisation."@en .

gpc:30015399 a gpc:AttributeValue ;
  rdfs:label "PASTEURISED (WITH ENZYME MODIFICATION)"@en ;
  rdfs:comment "Enzymes are modified prior to product pasteurisation."@en .

gpc:30015400 a gpc:AttributeValue ;
  rdfs:label "PASTEURISED (USE OF ENZYME MODIFICATION UNKNOWN)"@en ;
  rdfs:comment "Enzymes may or may not have been modified prior to product pasteurisation."@en .

gpc:30015401 a gpc:AttributeValue ;
  rdfs:label "PASTEURISED (ALTERNATE TREATMENTS)"@en ;
  rdfs:comment "Product is pasteurised using non-thermal treatments such as high frequency radio waves or hyperbaric pressure."@en .

gpc:30015402 a gpc:AttributeValue ;
  rdfs:label "UNPASTEURISED"@en ;
  rdfs:comment "Product has not been subjected to any treatment to reduce viable microorganisms."@en .

gpc:30015403 a gpc:AttributeValue ;
  rdfs:label "WHITE (EGG PART)"@en ;
  rdfs:comment "Product obtained from bird eggs broken from the shell and separated from the yolks."@en .

gpc:30015404 a gpc:AttributeValue ;
  rdfs:label "WHOLE (NATURAL PROPORTIONS)"@en ;
  rdfs:comment "Product obtained from bird eggs broken from the shell with yolks and whites mixed as broken."@en .

gpc:30015405 a gpc:AttributeValue ;
  rdfs:label "WHOLE (NOT NATURAL PROPORTIONS)"@en ;
  rdfs:comment "Product is yolks and whites obtained from bird eggs combined to meet product specifications."@en .

gpc:30015406 a gpc:AttributeValue ;
  rdfs:label "YOLK (EGG)"@en ;
  rdfs:comment "Product obtained from bird eggs broken from the shell and separated from the whites."@en .

gpc:30015407 a gpc:AttributeValue ;
  rdfs:label "COLOR STABILIZERS"@en ;
  rdfs:comment "Food-grade additives used to preserve color of product."@en .

gpc:30015408 a gpc:AttributeValue ;
  rdfs:label "COLORING AGENTS"@en ;
  rdfs:comment "Food-grade additives used to alter the color of product."@en .

gpc:30015409 a gpc:AttributeValue ;
  rdfs:label "FLAVORED"@en ;
  rdfs:comment "Food-grade additives used to flavor the product."@en .

gpc:30015410 a gpc:AttributeValue ;
  rdfs:label "PRESERVATIVES"@en ;
  rdfs:comment "Food-grade additives used to maintain the product quality."@en .

gpc:30015411 a gpc:AttributeValue ;
  rdfs:label "WHIPPING AIDS"@en ;
  rdfs:comment "Food-grade foaming additives such as sodium laury sulfate added to the product."@en .

gpc:30015412 a gpc:AttributeValue ;
  rdfs:label "CHILLED (EGGS)"@en ;
  rdfs:comment "Product is maintained at not less than 4&#176;C (40&#176;F) or more than 7&#176;C (45&#176;F) at all times after packaging."@en .

gpc:30015413 a gpc:AttributeValue ;
  rdfs:label "UNCHILLED"@en ;
  rdfs:comment "Product is maintained at room temperature after packaging."@en .

gpc:30015414 a gpc:AttributeValue ;
  rdfs:label "WHITE (SHELL)"@en ;
  rdfs:comment "Shell has no pigmentation."@en .

gpc:30015415 a gpc:AttributeValue ;
  rdfs:label "BROWN (SHELL)"@en ;
  rdfs:comment "Shell has a light-brown to dark-brown pigmentation."@en .

gpc:30015416 a gpc:AttributeValue ;
  rdfs:label "SPECKLED (SHELL)"@en ;
  rdfs:comment "Shell has a light-brown to dark-brown base pigmentation with noticeably darker circular or randomly shaped markings."@en .

gpc:30015417 a gpc:AttributeValue ;
  rdfs:label "CHILLED (EGG IN SHELL)"@en ;
  rdfs:comment "Product is maintained at or below 7 &#176;C (45&#176;F) at all times after packaging."@en .

gpc:30015418 a gpc:AttributeValue ;
  rdfs:label "SIZE 1"@en ;
  rdfs:comment "Product meets or exceeds the requirements of the largest egg weight category as defined by a standard known to buyer and seller such as Jumbo in the US and Canada and Very Large in Eurpoe."@en .

gpc:30015419 a gpc:AttributeValue ;
  rdfs:label "SIZE 2"@en ;
  rdfs:comment "Product meets or exceeds the requirements of the second next to largest egg weight category as defined by a standard known to buyer and seller such as Extra Large in the US and Large in Europe."@en .

gpc:30015420 a gpc:AttributeValue ;
  rdfs:label "SIZE 3"@en ;
  rdfs:comment "Product meets or exceeds the requirements of the third next to largest egg weight category as defined by a standard known to buyer and seller such as Large in the US and Canada or Medium in Europe."@en .

gpc:30015421 a gpc:AttributeValue ;
  rdfs:label "SIZE 4"@en ;
  rdfs:comment "Product meets or exceeds the requirements of the fourth next to largest egg weight category as defined by a standard known to buyer and seller such as Medium in the US and Canada or Small in Europe."@en .

gpc:30015422 a gpc:AttributeValue ;
  rdfs:label "SIZE 5"@en ;
  rdfs:comment "Product meets or exceeds the requirements of the fifth next to largest egg weight category as defined by a standard known to buyer and seller such as Small in the US and Canada."@en .

gpc:30015423 a gpc:AttributeValue ;
  rdfs:label "SIZE 6"@en ;
  rdfs:comment "Product meets or exceeds the requirements of the sixth next to largest egg weight category as defined by a standard known to buyer and seller such as Size 6 in the UNECE standards."@en .

gpc:30015424 a gpc:AttributeValue ;
  rdfs:label "SIZE 7"@en ;
