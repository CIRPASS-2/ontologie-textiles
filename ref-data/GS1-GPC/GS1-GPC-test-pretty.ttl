gpc:20002885 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Wheel Rim Material"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the type of wheel rim material."@en .

gpc:20002886 a rdf:Property, gpc:Attribute ;
  rdfs:label "Type of Wheel Hardware"@en ;
  rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the measurement that is used by the product manufacturer to identify the type of wheel hardware."@en .

gpc:20002887 a rdf:Property, gpc:Attribute ;
