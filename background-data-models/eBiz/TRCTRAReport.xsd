                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventActionCode" type="eventActionCode_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event action code: code indicating the action performed by the event on the tracked object (for example deletion, creation, addition or removal of components)</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventDateTime" type="eventDateTime_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event date time: The date or date time value at which this event occurred. Formatted according to the pattern indicated by the dateForm attribute.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="recordDateTime" type="recordDateTime_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>record date time: The date or date time value at which an event was registered. Formatted according to the pattern indicated by the dateForm attribute.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="description" type="description_Type" minOccurs="0" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>description: free text description. The content of the element must be unique, it might be translated and repeated into more languages (thus no more than one instance for each language).</eds:Definition>
                        <eds:AggregationNote>Textual description (for example for marketing purposes). Only one instance of this element for each different value of 'ln' attribute (language)</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="certificationInfo" type="certificationInfo_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>certification Information: reference to a certification (URL or identifier according to the schemeID)
It is recommended to use the certification identifier released by the issuer</eds:Definition>
                        <eds:AggregationNote>each certificationInfo must refer to a different certificate</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="businessStepCode" type="businessStepCode_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>business step code: It is the code that indicates an action in the business process.
It is recommended to declare the codeList or at least the numberingOrg</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="manufacturingStep" type="manufacturingStep_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>manufacturing step: Describes the action performed that triggered the event. It is a description of a step in the manufacturing process of which the event is a part.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="tracedObject" type="tracedObject_Type" minOccurs="0" maxOccurs="unbounded">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>traced object: traced product instance or lot. Usually it refers to just one productID (i.e. one SKU); nevertheless if the lot is made of clothing, it can refer to more than one SKUs which differ in size.</eds:Definition>
                        <eds:AggregationNote>object of the event; it should be used only when it is necessary to indicate a subset of the tracedObjects indicated at item level TRCTraRepItem</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventReadLocation" type="eventReadLocation_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event read location: data relating to a place where the event was detected (indicate at least element location or address, city and country)</eds:Definition>
                        <eds:AggregationNote>read point at which the event took place or was initiated</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventBusinessLocation" type="eventBusinessLocation_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event business location: data relating to a business place related to the event (indicate at least element location or address, city and country)</eds:Definition>
                        <eds:AggregationNote>where the object is AFTER the event took place, up to any other event that changes the location.  Use only when different from eventReadLocation</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventSourceParty" type="eventSourceParty_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event source party: initial endpoint (party or place) of a business transfer</eds:Definition>
                        <eds:AggregationNote>It can indicate both the party who carried out the event and the place where it took place (or despatch place in case of transfer)</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventDestinationParty" type="eventDestinationParty_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event destination party: final endpoint (party or place) of a business transfer</eds:Definition>
                        <eds:AggregationNote>In case of transfer (physical transfer or ownership or custody, etc. . .) described by the event, indicates the subject or place intended as recipient or destination</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="eventOriginatorParty" type="eventOriginatorParty_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>event originator party: identification and details of the party on whose behalf an event occurred (if different from source or destination party)</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="dataResponsibleParty" type="dataResponsibleParty_Type" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>data responsible party: the party who has the responsibility of the data reliability (an example is the party that inserted the data into a system)</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="externalRefDoc" type="externalRefDoc_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>external Reference Document: external document, used to refer generic office documents (like pdf, docx, xls, for example shop window instructions)</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="note" type="note_Type" minOccurs="0" maxOccurs="9">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>general note: free text or structured (computer processing) note. For note structuring use the attributes "noteLabel" and "codelist"</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
        <xsd:attribute name="progr" type="progr_Type" use="optional"/>
    </xsd:complexType>

