        <xsd:attribute name="exhaustiveInformation" type="exhaustiveInformation_Type" use="optional"/>
        <xsd:attribute name="accomplishedProductionIndicator" type="accomplishedProductionIndicator_Type" use="optional"/>
    </xsd:complexType>

