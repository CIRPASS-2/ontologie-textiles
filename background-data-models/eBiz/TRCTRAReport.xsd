    <!-- Element (Instance ID: 1162) -->
    <xsd:complexType name="tracedObject_Type">
        <xsd:annotation>
            <xsd:documentation>
                <eds:Definition>tracedObject</eds:Definition>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="objectInstanceIdentification" type="objectInstanceIdentification_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>object Instance Identification: Identification of an object instance, it could contain more than one identifier of the same object as long as they refer to different identification schemes</eds:Definition>
                        <eds:AggregationNote>unique identifier of the traced object.</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="productIDandQty" type="productIDandQty_Type" minOccurs="1" maxOccurs="99">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>product identifier and quantity: product identifier and its quantity</eds:Definition>
                        <eds:AggregationNote>Used 	inside an EVENT it should indicate the effectively USED (input) or RESULTING (output) quantity of the lot as a consequence of the event. Max cardinality is 1 when @objectInstanceTypeCode='IST'</eds:AggregationNote>
                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
            <xsd:element name="objectTypeCode" type="objectTypeCode_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>object type code: code that identifies the type of object</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
        <xsd:attribute name="objectInstanceTypeCode" type="objectInstanceTypeCode_Type" use="optional"/>
    </xsd:complexType>

    <!-- Element (Instance ID: 1180) -->
    <xsd:complexType name="TRCEventList_Type">
        <xsd:annotation>
            <xsd:documentation>
                <eds:Definition>TRCEventList</eds:Definition>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:choice  maxOccurs="unbounded" >
                <xsd:element name="TRCObjectEvent" type="TRCObjectEvent_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRC object event: Information about an event concerning one or more physical or digital objects declared at item or event level. The object identifiers do not change due to this event. Examples are dyeing or dispatching of a product lot.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
                <xsd:element name="TRCTransformationEvent" type="TRCTransformationEvent_Type" minOccurs="1" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>
                        <eds:Definition>TRC transformation event: Information about an event regarding the transformation of one or more components to obtain one or more new physical or digital objects declared at the item or event level. For example weaving of yarn to obtain fabric.</eds:Definition>

                    </xsd:documentation>

                </xsd:annotation>
            </xsd:element>
